# Applied on top of the kernel's i386_defconfig.
# Target: Windows XP era PCs with a legacy BIOS (Pentium III / 4, Athlon,
# Core 2), IDE or SATA disk, PS/2 or USB keyboard, AC'97 or HD Audio,
# wired Ethernet or PCI/USB Wi-Fi (for the clock), PCI or ISA sound cards.
# Everything is built in except the Wi-Fi drivers and most sound card
# drivers, which are modules: they load their firmware from /lib/firmware,
# and the ISA ones take port/IRQ/DMA settings (apple2-sound). No initramfs.

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_LOCALVERSION="-apple2pc"
CONFIG_DEFAULT_HOSTNAME="apple2"

# CPU: runs on anything from a Pentium Pro up.
CONFIG_M686=y
CONFIG_HIGHMEM4G=y
CONFIG_SMP=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT_VOLUNTARY=y

# Faster, quieter boot.
CONFIG_PRINTK_TIME=n
CONFIG_BOOT_PRINTK_DELAY=n
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=1
CONFIG_CONSOLE_LOGLEVEL_QUIET=1
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=1
CONFIG_KERNEL_LZ4=y
CONFIG_BLK_DEV_INITRD=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n

# Not needed on this machine.
CONFIG_DRM=n
CONFIG_AGP=n
CONFIG_SOUND_OSS_CORE=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_PROFILING=n
CONFIG_KVM_GUEST=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_SECURITY=n
CONFIG_AUDIT=n

# Disks: IDE (PATA) and SATA, through libata so all show up as /dev/sdX.
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_SIL=y
CONFIG_SATA_SIL24=y
CONFIG_SATA_VIA=y
CONFIG_SATA_NV=y
CONFIG_SATA_SIS=y
CONFIG_SATA_PROMISE=y
CONFIG_PATA_AMD=y
CONFIG_PATA_VIA=y
CONFIG_PATA_SIS=y
CONFIG_PATA_ATIIXP=y
CONFIG_PATA_JMICRON=y
CONFIG_PATA_MARVELL=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_SCH=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_LEGACY=n
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

# USB keyboards, and booting from a USB stick or CF reader.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# PS/2 keyboard and joysticks on USB.
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_EVDEV=y

# Picture: the VESA BIOS framebuffer that GRUB sets up. Works on any
# graphics card of the era without a specific driver.
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_VGA16=n
CONFIG_FB_EFI=n
CONFIG_SYSFB_SIMPLEFB=n
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=n
CONFIG_VGA_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Sound: ALSA. The common onboard chips are built in; the other PCI cards
# of the time and every ISA card are modules, loaded by apple2-sound.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCI=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_VIA82XX=y
CONFIG_SND_ATIIXP=y
CONFIG_SND_EMU10K1=y
CONFIG_SND_ENS1370=y
CONFIG_SND_ENS1371=y
CONFIG_SND_CMIPCI=y
CONFIG_SND_FM801=y
CONFIG_SND_CS46XX=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_HDMI=n
# Other PCI cards (modules; some need firmware from /lib/firmware)
CONFIG_SND_ALI5451=m
CONFIG_SND_ALS300=m
CONFIG_SND_ALS4000=m
CONFIG_SND_ASIHPI=n
CONFIG_SND_AU8810=m
CONFIG_SND_AU8820=m
CONFIG_SND_AU8830=m
CONFIG_SND_AZT3328=m
CONFIG_SND_CA0106=m
CONFIG_SND_CS4281=m
CONFIG_SND_CTXFI=m
CONFIG_SND_EMU10K1X=m
CONFIG_SND_ES1938=m
CONFIG_SND_ES1968=m
CONFIG_SND_ES1968_INPUT=n
CONFIG_SND_ICE1712=m
CONFIG_SND_ICE1724=m
CONFIG_SND_KORG1212=m
CONFIG_SND_MAESTRO3=m
CONFIG_SND_MAESTRO3_INPUT=n
CONFIG_SND_NM256=m
CONFIG_SND_OXYGEN=m
CONFIG_SND_VIRTUOSO=m
CONFIG_SND_RIPTIDE=m
CONFIG_SND_SONICVIBES=m
CONFIG_SND_TRIDENT=m
CONFIG_SND_YMFPCI=m
CONFIG_SND_ECHO3G=m
CONFIG_SND_MIA=m
# ISA cards (modules). ISA PnP cards are found by themselves; the others
# are tried at the usual Sound Blaster settings or what APPLE2\sound.txt says.
CONFIG_ISA=y
CONFIG_ISAPNP=y
CONFIG_PNP=y
CONFIG_SND_ISA=y
CONFIG_SND_ADLIB=m
CONFIG_SND_AD1816A=m
CONFIG_SND_AD1848=m
CONFIG_SND_ALS100=m
CONFIG_SND_AZT1605=m
CONFIG_SND_AZT2316=m
CONFIG_SND_AZT2320=m
CONFIG_SND_CMI8328=m
CONFIG_SND_CMI8330=m
CONFIG_SND_CS4231=m
CONFIG_SND_CS4236=m
CONFIG_SND_ES1688=m
CONFIG_SND_ES18XX=m
CONFIG_SND_SC6000=m
CONFIG_SND_GUSCLASSIC=m
CONFIG_SND_GUSEXTREME=m
CONFIG_SND_GUSMAX=m
CONFIG_SND_INTERWAVE=m
CONFIG_SND_INTERWAVE_STB=m
CONFIG_SND_JAZZ16=m
CONFIG_SND_OPL3SA2=m
CONFIG_SND_OPTI92X_AD1848=m
CONFIG_SND_OPTI92X_CS4231=m
CONFIG_SND_OPTI93X=m
CONFIG_SND_MIRO=m
CONFIG_SND_SB8=m
CONFIG_SND_SB16=m
CONFIG_SND_SBAWE=m
CONFIG_SND_SB16_CSP=n
CONFIG_SND_SSCAPE=m
CONFIG_SND_GALAXY=m
CONFIG_SND_WAVEFRONT=n
CONFIG_SND_MSND_PINNACLE=n
CONFIG_SND_MSND_CLASSIC=n
CONFIG_SND_MPU401=m

# Filesystems: ext4 for the system, FAT32 for the disk-image/save partition
# (so Windows can read and write it).
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ISO9660_FS=n
CONFIG_AUTOFS_FS=n
CONFIG_QUOTA=n
CONFIG_NFS_FS=n

# Network, for FujiNet: TCP/IP, DHCP, wired cards of the era built in.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=n
CONFIG_NET_SCHED=n
CONFIG_BRIDGE=n
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_MII=y
CONFIG_PHYLIB=y
CONFIG_E100=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_VIA_RHINE=y
CONFIG_VIA_RHINE_MMIO=y
CONFIG_VIA_VELOCITY=y
CONFIG_SIS900=y
CONFIG_SIS190=y
CONFIG_FORCEDETH=y
CONFIG_TIGON3=y
CONFIG_B44=y
CONFIG_BNX2=y
CONFIG_SKGE=y
CONFIG_SKY2=y
CONFIG_ATL1=y
CONFIG_ATL1E=y
CONFIG_ATL1C=y
CONFIG_ATL2=y
CONFIG_ALX=y
CONFIG_PCNET32=y
CONFIG_NE2K_PCI=y
CONFIG_DL2K=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y

# Wi-Fi: PCI cards of the era and common USB sticks, as modules.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_RFKILL=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH5K=m
CONFIG_ATH5K_PCI=y
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_AR5523=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2400PCI=m
CONFIG_RT2500PCI=m
CONFIG_RT61PCI=m
CONFIG_RT2800PCI=m
CONFIG_RT2800PCI_RT33XX=y
CONFIG_RT2800PCI_RT35XX=y
CONFIG_RT2800PCI_RT53XX=y
CONFIG_RT2800PCI_RT3290=y
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8180=m
CONFIG_RTL8187=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_B43=m
CONFIG_B43_PCI_AUTOSELECT=y
CONFIG_B43_SSB=y
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_N=y
CONFIG_B43_PHY_LP=y
CONFIG_B43LEGACY=m
CONFIG_BRCMSMAC=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IPW2100=m
CONFIG_IPW2200=m
CONFIG_IWL4965=m
CONFIG_IWL3945=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_COMMON=m
CONFIG_P54_PCI=m
CONFIG_P54_USB=m
CONFIG_WLAN_VENDOR_ADMTEK=y
CONFIG_ADM8211=m
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_ZD1211RW=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m

# WPA/WPA2/WPA3 crypto in software for cards without it.
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_MICHAEL_MIC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# Run the CPU at full speed: the emulator needs it, and with the userspace
# governor (the i386 default) the CPU stays at whatever clock the BIOS left,
# often the lowest on laptops.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=n
# ThinkPad buttons (volume, mute) as key presses, and its EC volume. A
# module, loaded on ThinkPads only; it needs DRM, I2C and backlight cores,
# also modules so other PCs do not carry them.
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_I2C=m
CONFIG_DRM=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_THINKPAD_ACPI=m
CONFIG_THINKPAD_ACPI_ALSA_SUPPORT=y
CONFIG_THINKPAD_ACPI_HOTKEY_POLL=y
# USB Audio Class sound devices (USB sound cards, headsets, DACs).
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m

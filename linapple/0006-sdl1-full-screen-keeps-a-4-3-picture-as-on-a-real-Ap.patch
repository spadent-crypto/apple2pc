 }
 
+TEST_CASE("SDL1 Frontend started full screen keeps the picture's shape") {
+  SDL_putenv(const_cast<char*>("SDL_VIDEODRIVER=dummy"));
+  int init_result = SDL_Init(SDL_INIT_VIDEO);
+  REQUIRE(init_result == 0);
+  REQUIRE(asset_init());
+
+  // A 16:10 screen, started full screen (-f), "Full Screen Aspect" unset:
+  // a 4:3 picture in the middle, 1066x800 at x = (1280 - 1066) / 2 = 107.
+  system_state.screen_width = 1280;
+  system_state.screen_height = 800;
+  system_state.fullscreen = true;
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1066);
+  CHECK(new_rect.h == 800);
+  CHECK(new_rect.x == 107);
+  CHECK(new_rect.y == 0);
+  frame_destroy_window();
+
+  // "pixel": square pixels, 560:384 -> 1166x800 at x = 57.
+  config_set_string("Configuration", "Full Screen Aspect", "pixel");
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1166);
+  CHECK(new_rect.h == 800);
+  CHECK(new_rect.x == 57);
+  frame_destroy_window();
+
+  // "stretch": the whole screen.
+  config_set_string("Configuration", "Full Screen Aspect", "stretch");
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1280);
+  CHECK(new_rect.h == 800);
+  CHECK(new_rect.x == 0);
+  frame_destroy_window();
+
+  // A 1024x768 mode on a 16:10 monitor that stretches it over the panel:
+  // "Monitor Aspect = 16:10" narrows the picture so it still looks 4:3,
+  // ratio 4/3 * (1024/768) / (16/10) = 1.111 -> 853x768 at x = 85.
+  config_set_string("Configuration", "Full Screen Aspect", "4:3");
+  config_set_string("Configuration", "Monitor Aspect", "16:10");
+  system_state.screen_width = 1024;
+  system_state.screen_height = 768;
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 853);
+  CHECK(new_rect.h == 768);
+  CHECK(new_rect.x == 85);
+  frame_destroy_window();
+
+  // "auto": the mode's pixels taken as square -> 1024x768 fills a 4:3 mode.
+  config_set_string("Configuration", "Monitor Aspect", "auto");
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1024);
+  CHECK(new_rect.h == 768);
+  frame_destroy_window();
+
+  // "Scale Mode = sharp": the height a whole multiple of 384.
+  // 800x600 -> 1x: 512x384 at (144, 108); 1280x1024 -> 2x: 1024x768 at
+  // (128, 128); 1024x768 -> 2x: the whole screen, as with aspect.
+  config_set_string("Configuration", "Scale Mode", "sharp");
+  system_state.screen_width = 800;
+  system_state.screen_height = 600;
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 512);
+  CHECK(new_rect.h == 384);
+  CHECK(new_rect.x == 144);
+  CHECK(new_rect.y == 108);
+  frame_destroy_window();
+  system_state.screen_width = 1280;
+  system_state.screen_height = 1024;
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1024);
+  CHECK(new_rect.h == 768);
+  CHECK(new_rect.x == 128);
+  CHECK(new_rect.y == 128);
+  frame_destroy_window();
+  system_state.screen_width = 1024;
+  system_state.screen_height = 768;
+  REQUIRE(frame_create_window() == 0);
+  CHECK(new_rect.w == 1024);
+  CHECK(new_rect.h == 768);
+  frame_destroy_window();
+  config_set_string("Configuration", "Scale Mode", "aspect");
+
+  config_set_string("Configuration", "Full Screen Aspect", "4:3");
+  system_state.fullscreen = false;
+  asset_quit();
+  SDL_Quit();
+}

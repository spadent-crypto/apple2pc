+// The shape the Apple picture keeps in full screen, from "Full Screen Aspect"
+// in linapple.conf:
+//   4:3      (default) as on the monitor or TV a real Apple II was used with;
+//            the 560x384 picture is drawn with taller-than-wide pixels
+//   pixel    square pixels, 560:384 (a little wider than 4:3)
+//   stretch  fill the whole screen
+//   W:H      any other shape, e.g. 3:2
+// What is left of the screen stays black, with the picture in the middle.
+//
+// "Monitor Aspect" is the shape of the monitor's lit area. "auto" (default)
+// takes the screen mode's pixels as square. A wide monitor that stretches a
+// 4:3 mode such as 1024x768 over its whole panel makes them wide; naming its
+// shape (16:9, 16:10, ...) lets the picture still look 4:3. Alt+F6 cycles it.
+//
+// "Scale Mode": aspect (default) makes the picture as big as the screen
+// allows; sharp scales its height by a whole number, so every line of the
+// Apple picture is the same number of screen lines, and keeps the shape
+// (smaller picture, wider black border on some screens).
+struct FullScreenAspect {
+  int w = 4;
+  int h = 3;
+  bool stretch = false;
+  bool sharp = false;
+  int monitor_w = 0;  // 0: "auto"
+  int monitor_h = 0;
+};
+
+auto normalized_config(const char* key) -> std::string {
+  std::string value;
+  if (!config_load_string("Configuration", key, &value)) {
+    return {};
+  }
+  value.erase(std::remove_if(value.begin(), value.end(),
+                             [](unsigned char c) {
+                               return c == ' ' || c == '\t' || c == '\r';
+                             }),
+              value.end());
+  std::transform(value.begin(), value.end(), value.begin(),
+                 [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return value;
+}
+
+auto parse_ratio(const std::string& value, int* w, int* h) -> bool {
+  int a = 0;
+  int b = 0;
+  if (std::sscanf(value.c_str(), "%d:%d", &a, &b) == 2 && a > 0 && b > 0 &&
+      a <= 100 && b <= 100) {
+    *w = a;
+    *h = b;
+    return true;
+  }
+  return false;
+}
+
+auto full_screen_aspect() -> FullScreenAspect {
+  FullScreenAspect aspect;
+  const std::string value = normalized_config("Full Screen Aspect");
+  if (value == "stretch") {
+    aspect.stretch = true;
+  } else if (value == "pixel") {
+    aspect.w = SCREEN_WIDTH;
+    aspect.h = SCREEN_HEIGHT;
+  } else {
+    parse_ratio(value, &aspect.w, &aspect.h);
+  }
+  parse_ratio(normalized_config("Monitor Aspect"), &aspect.monitor_w,
+              &aspect.monitor_h);
+  aspect.sharp = normalized_config("Scale Mode") == "sharp";
+  return aspect;
+}
+
 auto compute_aspect_fit_rect(int width, int height) noexcept -> SDL_Rect {
+  FullScreenAspect aspect;
+  try {
+    aspect = full_screen_aspect();
+  } catch (...) {
+  }
+  if (aspect.stretch || width <= 0 || height <= 0) {
+    return SDL_Rect{0, 0, static_cast<uint16_t>(width),
+                    static_cast<uint16_t>(height)};
+  }
+  // Width over height the picture needs in screen pixels: its shape, times
+  // how much wider than tall a screen pixel shows on the monitor.
+  double ratio = static_cast<double>(aspect.w) / aspect.h;
+  if (aspect.monitor_w > 0) {
+    ratio *= (static_cast<double>(width) / height) /
+             (static_cast<double>(aspect.monitor_w) / aspect.monitor_h);
+  }
+  if (aspect.sharp) {
+    for (int k = height / SCREEN_HEIGHT; k >= 1; --k) {
+      const int h = k * SCREEN_HEIGHT;
+      const int w = static_cast<int>(h * ratio + 1e-6);
+      if (w <= width) {
+        return SDL_Rect{static_cast<int16_t>((width - w) / 2),
+                        static_cast<int16_t>((height - h) / 2),
+                        static_cast<uint16_t>(w), static_cast<uint16_t>(h)};
+      }
+    }
+  }
   int target_w = width;
-  int target_h = (target_w * SCREEN_HEIGHT) / SCREEN_WIDTH;
+  int target_h = static_cast<int>(width / ratio + 1e-6);
   if (target_h > height) {
     target_h = height;
-    target_w = (target_h * SCREEN_WIDTH) / SCREEN_HEIGHT;
+    target_w = static_cast<int>(height * ratio + 1e-6);
   }
+  target_w = std::min(target_w, width);
   const int offset_x = (width - target_w) / 2;
   const int offset_y = (height - target_h) / 2;
   return SDL_Rect{
@@ -234,6 +340,47 @@ auto compute_aspect_fit_rect(int width, int height) noexcept -> SDL_Rect {
       static_cast<uint16_t>(target_w), static_cast<uint16_t>(target_h)};
 }
 
+// Alt+F6: the next monitor shape; the picture is fitted again at once and
+// the choice is kept in linapple.conf.
+auto cycle_monitor_aspect() -> void {
+  static const std::array<const char*, 6> shapes{"auto", "16:9", "16:10",
+                                                  "5:4",  "3:2",  "4:3"};
+  const std::string current = normalized_config("Monitor Aspect");
+  size_t next = 1;
+  for (size_t i = 0; i < shapes.size(); ++i) {
+    if (current == shapes[i]) {
+      next = (i + 1) % shapes.size();
+      break;
+    }
+  }
+  if (current.empty()) {
+    next = 1;
+  }
+  config_save_string("Configuration", "Monitor Aspect", shapes[next]);
+  Configuration::instance().save();
+
+  {
+    const std::lock_guard<std::recursive_mutex> lock(video_draw_mutex);
+    if (is_fullscreen && window_resized) {
+      new_rect = compute_aspect_fit_rect(
+          static_cast<int>(system_state.screen_width),
+          static_cast<int>(system_state.screen_height));
+    }
+    if (texture != nullptr) {
+      SDL_FillRect(texture.get(), nullptr, 0);
+    }
+    if (screen != nullptr) {
+      SDL_FillRect(screen, nullptr, 0);
+    }
+  }
+  std::string msg = std::string("Monitor shape: ") + shapes[next];
+  if (next == 0) {
+    msg += " (screen pixels square)";
+  }
+  osd_toast(msg.c_str());
+  draw_apple_content();
+}
+
 // A load can take the mouse card away; a captured pointer would feed nothing.
 auto load_save_state() -> void {
   save_state_load();
@@ -925,9 +1072,15 @@ auto frame_create_window() -> int {
          system_state.screen_height);
   if (window_resized) {
     orig_rect = SDL_Rect{0, 0, SCREEN_WIDTH, SCREEN_HEIGHT};
+    // Started full screen: keep the picture's shape ("Full Screen Aspect"),
+    // as a later switch to full screen does.
     new_rect =
-        SDL_Rect{0, 0, static_cast<uint16_t>(system_state.screen_width),
-                 static_cast<uint16_t>(system_state.screen_height)};
+        is_fullscreen
+            ? compute_aspect_fit_rect(
+                  static_cast<int>(system_state.screen_width),
+                  static_cast<int>(system_state.screen_height))
+            : SDL_Rect{0, 0, static_cast<uint16_t>(system_state.screen_width),
+                       static_cast<uint16_t>(system_state.screen_height)};
   }
   return 0;
 }

+namespace {
+
+// Rows [first, last] of the output that differ from what was last drawn,
+// within the source rectangle; false when none does.
+auto changed_rows(const uint32_t* output, const VideoRect& src, int* first,
+                  int* last) -> bool {
+  *first = -1;
+  *last = -1;
+  const int x0 = std::max<int>(0, src.x);
+  const int x1 = std::min<int>(SCREEN_WIDTH, src.x + src.w);
+  const int y0 = std::max<int>(0, src.y);
+  const int y1 = std::min<int>(SCREEN_HEIGHT, src.y + src.h);
+  if (x1 <= x0) {
+    return false;
+  }
+  const size_t bytes = static_cast<size_t>(x1 - x0) * sizeof(uint32_t);
+  for (int y = y0; y < y1; ++y) {
+    const size_t at = (static_cast<size_t>(y) * SCREEN_WIDTH) + x0;
+    if (std::memcmp(output + at, drawn_output.data() + at, bytes) != 0) {
+      if (*first < 0) {
+        *first = y;
+      }
+      *last = y;
+    }
+  }
+  return *first >= 0;
+}
+
+auto remember_output(const uint32_t* output) -> void {
+  drawn_output.assign(output, output + (SCREEN_WIDTH * SCREEN_HEIGHT));
+  drawn_output_valid = true;
+}
+
+}  // namespace
+
+auto frame_force_full_redraw() -> void { drawn_output_valid = false; }
+

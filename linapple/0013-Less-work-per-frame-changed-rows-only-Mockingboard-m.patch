+TEST_CASE("Band stretch writes exactly the whole stretch's rows, no others") {
+  const int bpp = 4;
+  UniqueSurface src = make_surface(560, 384, bpp);
+  UniqueSurface full = make_surface(1024, 768, bpp);
+  UniqueSurface band = make_surface(1024, 768, bpp);
+  REQUIRE(src != nullptr);
+  for (int y = 0; y < 384; ++y) {
+    auto* row = reinterpret_cast<uint32_t*>(
+        src->pixels + (static_cast<std::ptrdiff_t>(y) * src->pitch));
+    for (int x = 0; x < 560; ++x) {
+      row[x] = static_cast<uint32_t>((y * 7919) ^ (x * 104729)) | 1U;
+    }
+  }
+  const VideoRect rect{0, 0, 1024, 768};
+  VideoRect r1 = rect;
+  REQUIRE(video_soft_stretch(src.get(), nullptr, full.get(), &r1) == 0);
+  VideoRect r2 = rect;
+  REQUIRE(video_soft_stretch_band(src.get(), nullptr, band.get(), &r2, 300,
+                                  420) == 0);
+  int wrong = 0;
+  for (int y = 0; y < 768; ++y) {
+    const auto* f = reinterpret_cast<const uint32_t*>(
+        full->pixels + (static_cast<std::ptrdiff_t>(y) * full->pitch));
+    const auto* b = reinterpret_cast<const uint32_t*>(
+        band->pixels + (static_cast<std::ptrdiff_t>(y) * band->pitch));
+    for (int x = 0; x < 1024; ++x) {
+      const uint32_t want = (y >= 300 && y < 420) ? f[x] : 0U;
+      if (b[x] != want) {
+        ++wrong;
+      }
+    }
+  }
+  CHECK(wrong == 0);
+}

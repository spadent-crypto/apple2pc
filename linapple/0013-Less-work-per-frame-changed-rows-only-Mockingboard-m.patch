@@ -439,6 +488,60 @@ auto draw_frame_window() -> void {
     return;
   }
 
+  // Most frames change a few rows of the Apple screen, or none. Without a
+  // message on screen, only the changed rows are stretched, straight into
+  // the screen surface, and only their band is sent to the display; a frame
+  // that changed nothing costs a compare.
+  if (system_state.mode != app_mode_debug && !osd_showing &&
+      drawn_output_valid) {
+    const uint32_t* output = video_get_output_buffer();
+    if (output == nullptr) {
+      return;
+    }
+    const SDL_Rect r{0, 0, SCREEN_WIDTH, SCREEN_HEIGHT};
+    VideoRect src_rect =
+        window_resized ? to_video_rect(orig_rect) : to_video_rect(r);
+    VideoRect dst_rect =
+        window_resized ? to_video_rect(new_rect) : to_video_rect(r);
+    int first = 0;
+    int last = 0;
+    if (!changed_rows(output, src_rect, &first, &last)) {
+      frame_poll_activity();
+      video_set_frame_ready(false);
+      return;
+    }
+    // Destination rows showing source rows first..last.
+    const auto ceil_div = [](int64_t a, int64_t b) -> int {
+      return static_cast<int>((a + b - 1) / b);
+    };
+    const int band_first =
+        ceil_div(static_cast<int64_t>(first - src_rect.y) * dst_rect.h,
+                 src_rect.h);
+    const int band_last =
+        ceil_div(static_cast<int64_t>(last + 1 - src_rect.y) * dst_rect.h,
+                 src_rect.h);
+    {
+      ScopedSurfaceLock lock_screen(screen);
+      const VideoSurfaceView vs_output(const_cast<uint32_t*>(output),
+                                       SCREEN_WIDTH, SCREEN_HEIGHT,
+                                       SCREEN_WIDTH * 4, 4);
+      video_soft_stretch_band(vs_output, &src_rect, lock_screen.view(),
+                              &dst_rect, band_first, band_last);
+    }
+    remember_output(output);
+    const int x0 = std::max<int>(0, dst_rect.x);
+    const int x1 = std::min<int>(screen->w, dst_rect.x + dst_rect.w);
+    const int y0 = std::max<int>(0, dst_rect.y + band_first);
+    const int y1 = std::min<int>(screen->h, dst_rect.y + band_last);
+    frame_poll_activity();
+    if (x1 > x0 && y1 > y0) {
+      SDL_UpdateRect(screen, x0, y0, static_cast<Uint32>(x1 - x0),
+                     static_cast<Uint32>(y1 - y0));
+    }
+    video_set_frame_ready(false);
+    return;
+  }

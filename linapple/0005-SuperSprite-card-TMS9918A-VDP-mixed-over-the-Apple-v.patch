diff --git a/src/apple2/chips/TMS9918A.cpp b/src/apple2/chips/TMS9918A.cpp
new file mode 100644
index 00000000..59da8f4c
--- /dev/null
+++ b/src/apple2/chips/TMS9918A.cpp
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "apple2/chips/TMS9918A.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+constexpr uint16_t address_mask = tms9918a_vram_size - 1;
+
+// Register bits.
+constexpr uint8_t r0_m3 = 0x02;
+constexpr uint8_t r1_blank = 0x40;  // 1 = display enabled
+constexpr uint8_t r1_ie = 0x20;
+constexpr uint8_t r1_m1 = 0x10;
+constexpr uint8_t r1_m2 = 0x08;
+constexpr uint8_t r1_size = 0x02;
+constexpr uint8_t r1_mag = 0x01;
+
+constexpr uint8_t sprite_terminator = 0xD0;
+constexpr int sprites_per_line = 4;
+constexpr int num_sprites = 32;
+constexpr uint8_t early_clock = 0x80;
+
+constexpr int text_columns = 40;
+constexpr int text_left_border = 8;
+
+// The rendering MAME, openMSX and most emulators settled on, measured from a
+// TMS9928A's YPbPr output. Index 0 is transparent and never drawn.
+constexpr std::array<uint32_t, 16> palette = {
+    0x000000, 0x000000, 0x21C842, 0x5EDC78, 0x5455ED, 0x7D76FC,
+    0xD4524D, 0x42EBF5, 0xFC5554, 0xFF7978, 0xD4C154, 0xE6CE80,
+    0x21B03B, 0xC95BBA, 0xCCCCCC, 0xFFFFFF,
+};
+
+auto vram_at(const Tms9918a* vdp, uint32_t addr) -> uint8_t {
+  return vdp->vram[addr & address_mask];
+}
+
+// One scan line of the pattern plane, colour 0 where the plane is
+// transparent.
+auto draw_background(const Tms9918a* vdp, int y, uint8_t* line) -> void {
+  const auto& r = vdp->regs;
+  const uint32_t name_base = static_cast<uint32_t>(r[2] & 0x0F) << 10;
+  const int row = y >> 3;
+  const int sub = y & 7;
+
+  if ((r[1] & r1_m1) != 0) {
+    // Text: 40 columns of 6-pixel characters, two colours from R7, an
+    // 8-pixel border of backdrop on either side.
+    const uint32_t pattern_base = static_cast<uint32_t>(r[4] & 0x07) << 11;
+    const uint8_t fg = r[7] >> 4;
+    const uint8_t bg = r[7] & 0x0F;
+    std::memset(line, 0, tms9918a_width);
+    for (int col = 0; col < text_columns; ++col) {
+      const uint8_t name = vram_at(
+          vdp, name_base + static_cast<uint32_t>((row * text_columns) + col));
+      const uint8_t bits =
+          vram_at(vdp, pattern_base + (static_cast<uint32_t>(name) << 3) +
+                           static_cast<uint32_t>(sub));
+      for (int px = 0; px < 6; ++px) {
+        const bool on = (bits & (0x80 >> px)) != 0;
+        line[text_left_border + (col * 6) + px] = on ? fg : bg;
+      }
+    }
+    return;
+  }
+
+  if ((r[1] & r1_m2) != 0) {
+    // Multicolor: each name selects two 4x4 blocks per byte, and the byte
+    // within the pattern is picked by the character row.
+    const uint32_t pattern_base = static_cast<uint32_t>(r[4] & 0x07) << 11;
+    for (int col = 0; col < 32; ++col) {
+      const uint8_t name =
+          vram_at(vdp, name_base + static_cast<uint32_t>((row * 32) + col));
+      const uint32_t addr = pattern_base + (static_cast<uint32_t>(name) << 3) +
+                            static_cast<uint32_t>(((row & 3) * 2) + ((y >> 2) & 1));
+      const uint8_t colors = vram_at(vdp, addr);
+      const uint8_t left = colors >> 4;
+      const uint8_t right = colors & 0x0F;
+      for (int px = 0; px < 8; ++px) {
+        line[(col * 8) + px] = (px < 4) ? left : right;
+      }
+    }
+    return;
+  }
+
+  const bool graphics2 = (r[0] & r0_m3) != 0;
+  uint32_t pattern_base = 0;
+  uint32_t color_base = 0;
+  uint32_t pattern_mask = 0;
+  uint32_t color_mask = 0;
+  if (graphics2) {
+    pattern_base = static_cast<uint32_t>(r[4] & 0x04) << 11;
+    pattern_mask = (static_cast<uint32_t>(r[4] & 0x03) << 8) | 0xFF;
+    color_base = static_cast<uint32_t>(r[3] & 0x80) << 6;
+    color_mask = (static_cast<uint32_t>(r[3] & 0x7F) << 3) | 0x07;
+  } else {
+    pattern_base = static_cast<uint32_t>(r[4] & 0x07) << 11;
+    color_base = static_cast<uint32_t>(r[3]) << 6;
+  }
+
+  for (int col = 0; col < 32; ++col) {
+    const uint8_t name =
+        vram_at(vdp, name_base + static_cast<uint32_t>((row * 32) + col));
+    uint8_t bits = 0;
+    uint8_t colors = 0;
+    if (graphics2) {
+      // The screen's three thirds each address their own 256 patterns,
+      // narrowed by the masks in R3 and R4.
+      const uint32_t tile = (static_cast<uint32_t>(row >> 3) << 8) | name;
+      bits = vram_at(vdp, pattern_base + ((tile & pattern_mask) << 3) +
+                              static_cast<uint32_t>(sub));
+      colors = vram_at(vdp, color_base + ((tile & color_mask) << 3) +
+                                static_cast<uint32_t>(sub));
+    } else {
+      bits = vram_at(vdp, pattern_base + (static_cast<uint32_t>(name) << 3) +
+                              static_cast<uint32_t>(sub));
+      colors = vram_at(vdp, color_base + (name >> 3));
+    }
+    const uint8_t fg = colors >> 4;
+    const uint8_t bg = colors & 0x0F;
+    for (int px = 0; px < 8; ++px) {
+      line[(col * 8) + px] = ((bits & (0x80 >> px)) != 0) ? fg : bg;
+    }
+  }
+}
+
+auto sprite_top(uint8_t y) -> int {
+  // The line after the one in the attribute; values past the terminator
+  // count as negative so a sprite can slide in from the top.
+  const int signed_y = (y > sprite_terminator) ? static_cast<int>(y) - 256
+                                               : static_cast<int>(y);
+  return signed_y + 1;
+}
+
+auto draw_sprites(Tms9918a* vdp, int y, uint8_t* line) -> void {
+  const auto& r = vdp->regs;
+  const uint32_t attr_base = static_cast<uint32_t>(r[5] & 0x7F) << 7;
+  const uint32_t pattern_base = static_cast<uint32_t>(r[6] & 0x07) << 11;
+  const bool big = (r[1] & r1_size) != 0;
+  const int mag = ((r[1] & r1_mag) != 0) ? 1 : 0;
+  const int size = big ? 16 : 8;
+  const int height = size << mag;
+
+  std::array<int, sprites_per_line> visible = {};
+  int count = 0;
+  int last = 0;
+  for (int s = 0; s < num_sprites; ++s) {
+    last = s;
+    const uint32_t a = attr_base + static_cast<uint32_t>(s * 4);
+    const uint8_t sy = vram_at(vdp, a);
+    if (sy == sprite_terminator) {
+      break;
+    }
+    const int top = sprite_top(sy);
+    if (y < top || y >= top + height) {
+      continue;
+    }
+    if (count == sprites_per_line) {
+      if ((vdp->status & tms9918a_status::fifth) == 0) {
+        vdp->status = static_cast<uint8_t>(
+            (vdp->status & ~tms9918a_status::number_mask) |
+            tms9918a_status::fifth | static_cast<uint8_t>(s));
+      }
+      last = -1;
+      break;
+    }
+    visible[static_cast<size_t>(count++)] = s;
+  }
+  if (last >= 0 && (vdp->status & tms9918a_status::fifth) == 0) {
+    vdp->status = static_cast<uint8_t>(
+        (vdp->status & ~tms9918a_status::number_mask) |
+        static_cast<uint8_t>(last));
+  }
+
+  std::array<bool, tms9918a_width> occupied = {};
+  // Sprite 0 has the highest priority, so the list is walked in order and a
+  // pixel already drawn by a lower-numbered sprite is kept.
+  std::array<bool, tms9918a_width> drawn = {};
+  for (int i = 0; i < count; ++i) {
+    const int s = visible[static_cast<size_t>(i)];
+    const uint32_t a = attr_base + static_cast<uint32_t>(s * 4);
+    const int top = sprite_top(vram_at(vdp, a));
+    int x = vram_at(vdp, a + 1);
+    uint8_t name = vram_at(vdp, a + 2);
+    const uint8_t attr = vram_at(vdp, a + 3);
+    const uint8_t color = attr & 0x0F;
+    if ((attr & early_clock) != 0) {
+      x -= 32;
+    }
+    if (big) {
+      name &= 0xFC;
+    }
+    const int row = (y - top) >> mag;
+    const uint32_t base = pattern_base + (static_cast<uint32_t>(name) << 3) +
+                          static_cast<uint32_t>(row);
+    const uint8_t left = vram_at(vdp, base);
+    const uint8_t right = big ? vram_at(vdp, base + 16) : 0;
+    for (int px = 0; px < size; ++px) {
+      const uint8_t bits = (px < 8) ? left : right;
+      if ((bits & (0x80 >> (px & 7))) == 0) {
+        continue;
+      }
+      for (int m = 0; m <= mag; ++m) {
+        const int sx = x + (px << mag) + m;
+        if (sx < 0 || sx >= tms9918a_width) {
+          continue;
+        }
+        const auto idx = static_cast<size_t>(sx);
+        if (occupied[idx]) {
+          vdp->status |= tms9918a_status::collision;
+        }
+        occupied[idx] = true;
+        if (color != 0 && !drawn[idx]) {
+          line[idx] = color;
+          drawn[idx] = true;
+        }
+      }
+    }
+  }
+}
+
+}  // namespace
+
+auto tms9918a_reset(Tms9918a* vdp) noexcept -> void {
+  vdp->regs.fill(0);
+  vdp->address = 0;
+  vdp->read_ahead = 0;
+  vdp->latch = 0;
+  vdp->status = 0;
+  vdp->second_byte = false;
+}
+
+auto tms9918a_data_read(Tms9918a* vdp) noexcept -> uint8_t {
+  const uint8_t value = vdp->read_ahead;
+  vdp->read_ahead = vdp->vram[vdp->address];
+  vdp->address = (vdp->address + 1) & address_mask;
+  vdp->second_byte = false;
+  return value;
+}
+
+auto tms9918a_data_write(Tms9918a* vdp, uint8_t value) noexcept -> void {
+  vdp->vram[vdp->address] = value;
+  vdp->read_ahead = value;
+  vdp->address = (vdp->address + 1) & address_mask;
+  vdp->second_byte = false;
+}
+
+auto tms9918a_status_read(Tms9918a* vdp) noexcept -> uint8_t {
+  const uint8_t value = vdp->status;
+  vdp->status &= static_cast<uint8_t>(
+      ~(tms9918a_status::frame | tms9918a_status::fifth |
+        tms9918a_status::collision));
+  vdp->second_byte = false;
+  return value;
+}
+
+auto tms9918a_control_write(Tms9918a* vdp, uint8_t value) noexcept -> void {
+  if (!vdp->second_byte) {
+    vdp->latch = value;
+    // The low address byte takes effect at once, as on the chip.
+    vdp->address = static_cast<uint16_t>((vdp->address & 0x3F00) | value);
+    vdp->second_byte = true;
+    return;
+  }
+  vdp->second_byte = false;
+  if ((value & 0x80) != 0) {
+    vdp->regs[value & 0x07] = vdp->latch;
+    vdp->address =
+        static_cast<uint16_t>(((value & 0x3F) << 8) | vdp->latch) & address_mask;
+    return;
+  }
+  vdp->address =
+      static_cast<uint16_t>(((value & 0x3F) << 8) | vdp->latch) & address_mask;
+  if ((value & 0x40) == 0) {
+    // Read setup: the chip prefetches the first byte.
+    vdp->read_ahead = vdp->vram[vdp->address];
+    vdp->address = (vdp->address + 1) & address_mask;
+  }
+}
+
+auto tms9918a_irq(const Tms9918a* vdp) noexcept -> bool {
+  return (vdp->regs[1] & r1_ie) != 0 &&
+         (vdp->status & tms9918a_status::frame) != 0;
+}
+
+auto tms9918a_render_frame(Tms9918a* vdp, uint8_t* out) noexcept -> void {
+  const auto& r = vdp->regs;
+  const uint8_t backdrop = r[7] & 0x0F;
+  const bool enabled = (r[1] & r1_blank) != 0;
+  const bool text = (r[1] & r1_m1) != 0;
+
+  for (int y = 0; y < tms9918a_height; ++y) {
+    uint8_t* line = out + (static_cast<ptrdiff_t>(y) * tms9918a_width);
+    if (!enabled) {
+      std::memset(line, backdrop, tms9918a_width);
+      continue;
+    }
+    draw_background(vdp, y, line);
+    if (!text) {
+      draw_sprites(vdp, y, line);
+    }
+    for (int x = 0; x < tms9918a_width; ++x) {
+      if (line[x] == 0) {
+        line[x] = backdrop;
+      }
+    }
+  }
+  vdp->status |= tms9918a_status::frame;
+}
+
+auto tms9918a_palette_rgb(uint8_t color) noexcept -> uint32_t {
+  return palette[color & 0x0F];
+}
diff --git a/src/apple2/chips/TMS9918A.h b/src/apple2/chips/TMS9918A.h
new file mode 100644
index 00000000..949827ef
--- /dev/null
+++ b/src/apple2/chips/TMS9918A.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+
+// TMS9918A Video Display Processor, per the TI data manual (SPPU004) and
+// Sean Young's notes on its undocumented behaviour (tms9918a.txt).
+//
+// The chip is driven through two byte-wide ports selected by its MODE pin:
+// the data port reads and writes VRAM through an auto-incrementing 14-bit
+// address, and the control port sets that address, writes the eight write-only
+// registers and reads the status register. Everything here is host-neutral:
+// the caller decides when a frame ends and what to do with the picture.
+
+constexpr size_t tms9918a_vram_size = 0x4000;
+constexpr size_t tms9918a_num_registers = 8;
+constexpr int tms9918a_width = 256;
+constexpr int tms9918a_height = 192;
+
+namespace tms9918a_status {
+constexpr uint8_t frame = 0x80;      // F: set at the end of the active display
+constexpr uint8_t fifth = 0x40;      // 5S: a fifth sprite was on a line
+constexpr uint8_t collision = 0x20;  // C: two sprites overlap
+constexpr uint8_t number_mask = 0x1F;
+}  // namespace tms9918a_status
+
+struct Tms9918a {
+  std::array<uint8_t, tms9918a_vram_size> vram = {};
+  std::array<uint8_t, tms9918a_num_registers> regs = {};
+  uint16_t address = 0;
+  uint8_t read_ahead = 0;
+  uint8_t latch = 0;
+  uint8_t status = 0;
+  bool second_byte = false;
+};
+
+static_assert(std::is_standard_layout<Tms9918a>::value,
+              "Tms9918a must satisfy standard layout guarantees");
+
+auto tms9918a_reset(Tms9918a* vdp) noexcept -> void;
+
+// MODE = 0
+auto tms9918a_data_read(Tms9918a* vdp) noexcept -> uint8_t;
+auto tms9918a_data_write(Tms9918a* vdp, uint8_t value) noexcept -> void;
+// MODE = 1
+auto tms9918a_status_read(Tms9918a* vdp) noexcept -> uint8_t;
+auto tms9918a_control_write(Tms9918a* vdp, uint8_t value) noexcept -> void;
+
+// The /INT pin: the frame flag while R1's interrupt enable is set.
+auto tms9918a_irq(const Tms9918a* vdp) noexcept -> bool;
+
+// Draws one frame into out (256 x 192 colour numbers, 0 = transparent: the
+// pixel shows the external video) and sets the status register's sprite flags
+// and its frame flag as the chip does at the end of the active display.
+auto tms9918a_render_frame(Tms9918a* vdp, uint8_t* out) noexcept -> void;
+
+// The commonly used RGB rendering of the 15 opaque colours, 0x00RRGGBB.
+auto tms9918a_palette_rgb(uint8_t color) noexcept -> uint32_t;

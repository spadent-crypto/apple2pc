diff --git a/tests/test_supersprite.cpp b/tests/test_supersprite.cpp
new file mode 100644
index 00000000..ff33c2ac
--- /dev/null
+++ b/tests/test_supersprite.cpp
@@ -0,0 +1,493 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "apple2/Memory.h"
+#include "apple2/SnapshotTypes.h"
+#include "apple2/Video.h"
+#include "apple2/chips/TMS9918A.h"
+#include "apple2/peripherals/Peripheral.h"
+#include "core/LinAppleCore.h"
+#include "doctest.h"
+#include "test_fixtures_core.h"
+
+auto io_map_dispatch(uint16_t pc, uint16_t addr, uint8_t write, uint8_t val,
+                     uint32_t cycles) -> uint8_t;
+
+namespace {
+
+// --- The chip on its own ------------------------------------------------------
+
+auto set_register(Tms9918a* vdp, uint8_t reg, uint8_t value) -> void {
+  tms9918a_control_write(vdp, value);
+  tms9918a_control_write(vdp, static_cast<uint8_t>(0x80 | reg));
+}
+
+auto set_write_address(Tms9918a* vdp, uint16_t addr) -> void {
+  tms9918a_control_write(vdp, static_cast<uint8_t>(addr & 0xFF));
+  tms9918a_control_write(vdp, static_cast<uint8_t>(0x40 | (addr >> 8)));
+}
+
+auto set_read_address(Tms9918a* vdp, uint16_t addr) -> void {
+  tms9918a_control_write(vdp, static_cast<uint8_t>(addr & 0xFF));
+  tms9918a_control_write(vdp, static_cast<uint8_t>(addr >> 8));
+}
+
+auto fill(Tms9918a* vdp, uint16_t addr, uint8_t value, size_t count) -> void {
+  set_write_address(vdp, addr);
+  for (size_t i = 0; i < count; ++i) {
+    tms9918a_data_write(vdp, value);
+  }
+}
+
+// Graphics I with the conventional table layout and the display on.
+constexpr uint16_t name_table = 0x1800;
+constexpr uint16_t color_table = 0x2000;
+constexpr uint16_t pattern_table = 0x0000;
+constexpr uint16_t sprite_attr = 0x1B00;
+constexpr uint16_t sprite_patterns = 0x3800;
+
+auto graphics1(Tms9918a* vdp, uint8_t r1_extra = 0) -> void {
+  tms9918a_reset(vdp);
+  vdp->vram.fill(0);
+  set_register(vdp, 0, 0x00);
+  set_register(vdp, 1, static_cast<uint8_t>(0xC0 | r1_extra));
+  set_register(vdp, 2, name_table >> 10);
+  set_register(vdp, 3, color_table >> 6);
+  set_register(vdp, 4, pattern_table >> 11);
+  set_register(vdp, 5, sprite_attr >> 7);
+  set_register(vdp, 6, sprite_patterns >> 11);
+  set_register(vdp, 7, 0x00);
+  fill(vdp, sprite_attr, 0xD0, 1);
+}
+
+auto put_sprite(Tms9918a* vdp, int n, uint8_t y, uint8_t x, uint8_t name,
+                uint8_t color) -> void {
+  set_write_address(vdp, static_cast<uint16_t>(sprite_attr + (n * 4)));
+  tms9918a_data_write(vdp, y);
+  tms9918a_data_write(vdp, x);
+  tms9918a_data_write(vdp, name);
+  tms9918a_data_write(vdp, color);
+}
+
+auto pixel(const std::vector<uint8_t>& frame, int x, int y) -> uint8_t {
+  return frame[static_cast<size_t>((y * tms9918a_width) + x)];
+}
+
+}  // namespace
+
+TEST_CASE("TMS9918A: VRAM goes through the auto-incrementing address") {
+  Tms9918a vdp;
+  tms9918a_reset(&vdp);
+  set_write_address(&vdp, 0x1234);
+  tms9918a_data_write(&vdp, 0xAA);
+  tms9918a_data_write(&vdp, 0x55);
+  CHECK(vdp.vram[0x1234] == 0xAA);
+  CHECK(vdp.vram[0x1235] == 0x55);
+
+  // A read setup prefetches, so the first data read is the byte at the
+  // address just set.
+  set_read_address(&vdp, 0x1234);
+  CHECK(tms9918a_data_read(&vdp) == 0xAA);
+  CHECK(tms9918a_data_read(&vdp) == 0x55);
+
+  // The address wraps at 16 KiB.
+  set_write_address(&vdp, 0x3FFF);
+  tms9918a_data_write(&vdp, 0x11);
+  tms9918a_data_write(&vdp, 0x22);
+  CHECK(vdp.vram[0x3FFF] == 0x11);
+  CHECK(vdp.vram[0x0000] == 0x22);
+}
+
+TEST_CASE("TMS9918A: a register write is a value then 0x80 | register") {
+  Tms9918a vdp;
+  tms9918a_reset(&vdp);
+  set_register(&vdp, 7, 0xF4);
+  set_register(&vdp, 1, 0xE0);
+  CHECK(vdp.regs[7] == 0xF4);
+  CHECK(vdp.regs[1] == 0xE0);
+  // A status read resets the two-byte sequence.
+  tms9918a_control_write(&vdp, 0x12);
+  tms9918a_status_read(&vdp);
+  set_register(&vdp, 2, 0x06);
+  CHECK(vdp.regs[2] == 0x06);
+}
+
+TEST_CASE("TMS9918A: the frame flag interrupts only with R1's enable") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  graphics1(&vdp);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK((vdp.status & tms9918a_status::frame) != 0);
+  CHECK_FALSE(tms9918a_irq(&vdp));
+
+  set_register(&vdp, 1, 0xE0);
+  CHECK(tms9918a_irq(&vdp));
+  const uint8_t status = tms9918a_status_read(&vdp);
+  CHECK((status & tms9918a_status::frame) != 0);
+  CHECK_FALSE(tms9918a_irq(&vdp));
+  CHECK((vdp.status & tms9918a_status::frame) == 0);
+}
+
+TEST_CASE("TMS9918A: Graphics I draws patterns in the colour of their group") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  graphics1(&vdp);
+  // Pattern 9 is a left half bar; group 1 (patterns 8-15) is red on blue.
+  fill(&vdp, static_cast<uint16_t>(pattern_table + (9 * 8)), 0xF0, 8);
+  fill(&vdp, static_cast<uint16_t>(color_table + 1), 0x64, 1);
+  fill(&vdp, static_cast<uint16_t>(name_table + (2 * 32) + 3), 9, 1);
+  set_register(&vdp, 7, 0x01);  // backdrop black
+
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 24, 16) == 6);
+  CHECK(pixel(frame, 27, 23) == 6);
+  CHECK(pixel(frame, 28, 16) == 4);
+  // Pattern 0 is blank in group 0, whose colours are 0: the backdrop shows.
+  CHECK(pixel(frame, 0, 0) == 1);
+
+  // With the backdrop transparent too, the external video shows.
+  set_register(&vdp, 7, 0x00);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 0, 0) == 0);
+
+  // Blanked, the whole screen is backdrop.
+  set_register(&vdp, 7, 0x05);
+  set_register(&vdp, 1, 0x80);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 24, 16) == 5);
+}
+
+TEST_CASE("TMS9918A: text mode is 40 six-pixel columns between borders") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  graphics1(&vdp, 0x10);
+  set_register(&vdp, 2, 0x00);  // names at 0x0000
+  set_register(&vdp, 4, 0x01);  // patterns at 0x0800
+  set_register(&vdp, 7, 0xF4);  // white on dark blue
+  fill(&vdp, 0x0000, 0, 960);
+  fill(&vdp, 0x0800 + (1 * 8), 0xFC, 8);  // six pixels lit
+  fill(&vdp, 0x0001, 1, 1);               // column 1, row 0
+
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 0, 0) == 4);       // border
+  CHECK(pixel(frame, 8, 0) == 4);       // column 0, background
+  CHECK(pixel(frame, 14, 0) == 15);     // column 1 starts at x = 14
+  CHECK(pixel(frame, 19, 0) == 15);
+  CHECK(pixel(frame, 20, 0) == 4);      // column 2
+  CHECK(pixel(frame, 250, 100) == 4);   // right border
+}
+
+TEST_CASE("TMS9918A: sprites, magnification, priority and collision") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  graphics1(&vdp);
+  fill(&vdp, sprite_patterns, 0xFF, 8);  // pattern 0: a solid block
+
+  // Y is one line above the first drawn line.
+  put_sprite(&vdp, 0, 9, 20, 0, 0x0F);
+  put_sprite(&vdp, 1, 13, 24, 0, 0x06);
+  put_sprite(&vdp, 2, 0xD0, 0, 0, 0);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 20, 9) == 0);
+  CHECK(pixel(frame, 20, 10) == 15);
+  CHECK(pixel(frame, 27, 17) == 15);  // sprite 0 wins where they overlap
+  CHECK(pixel(frame, 30, 20) == 6);
+  CHECK(pixel(frame, 28, 18) == 6);
+  CHECK((vdp.status & tms9918a_status::collision) != 0);
+  tms9918a_status_read(&vdp);
+
+  // Magnified, sprite 0 covers 16 x 16.
+  put_sprite(&vdp, 1, 0xD0, 0, 0, 0);
+  set_register(&vdp, 1, 0xC1);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 35, 25) == 15);
+  CHECK(pixel(frame, 36, 25) == 0);
+  CHECK((vdp.status & tms9918a_status::collision) == 0);
+
+  // Early clock moves a sprite 32 pixels to the left.
+  set_register(&vdp, 1, 0xC0);
+  put_sprite(&vdp, 0, 9, 40, 0, 0x8F);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 8, 10) == 15);
+  CHECK(pixel(frame, 40, 10) == 0);
+
+  // A sprite whose Y is past the terminator starts above the screen.
+  put_sprite(&vdp, 0, 0xFC, 100, 0, 0x0F);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 100, 0) == 15);
+  CHECK(pixel(frame, 100, 4) == 15);  // lines -3 to 4
+  CHECK(pixel(frame, 100, 5) == 0);
+}
+
+TEST_CASE("TMS9918A: the fifth sprite on a line is dropped and reported") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  graphics1(&vdp);
+  fill(&vdp, sprite_patterns, 0xFF, 8);
+  for (int n = 0; n < 5; ++n) {
+    put_sprite(&vdp, n, 49, static_cast<uint8_t>(n * 20), 0, 0x0A);
+  }
+  put_sprite(&vdp, 5, 0xD0, 0, 0, 0);
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 60, 50) == 10);
+  CHECK(pixel(frame, 80, 50) == 0);
+  const uint8_t status = tms9918a_status_read(&vdp);
+  CHECK((status & tms9918a_status::fifth) != 0);
+  CHECK((status & tms9918a_status::number_mask) == 4);
+}
+
+TEST_CASE("TMS9918A: Graphics II gives every third its own patterns") {
+  Tms9918a vdp;
+  std::vector<uint8_t> frame(static_cast<size_t>(256) * 192);
+  tms9918a_reset(&vdp);
+  vdp.vram.fill(0);
+  set_register(&vdp, 0, 0x02);
+  set_register(&vdp, 1, 0xC0);
+  set_register(&vdp, 2, 0x0E);  // names 0x3800
+  set_register(&vdp, 3, 0xFF);  // colours 0x2000, full mask
+  set_register(&vdp, 4, 0x03);  // patterns 0x0000, full mask
+  set_register(&vdp, 5, 0x76);
+  set_register(&vdp, 7, 0x01);
+  fill(&vdp, 0x3B00, 0xD0, 1);
+  // Name 0 everywhere; the middle third's pattern 0 is solid, line by line
+  // coloured.
+  fill(&vdp, 0x0800, 0xFF, 8);
+  for (int line = 0; line < 8; ++line) {
+    fill(&vdp, static_cast<uint16_t>(0x2800 + line),
+         static_cast<uint8_t>((line + 2) << 4), 1);
+  }
+  tms9918a_render_frame(&vdp, frame.data());
+  CHECK(pixel(frame, 0, 0) == 1);    // top third: blank pattern, backdrop
+  CHECK(pixel(frame, 0, 64) == 2);   // middle third, line 0
+  CHECK(pixel(frame, 5, 67) == 5);   // line 3
+  CHECK(pixel(frame, 0, 128) == 1);  // bottom third
+}
+
+// --- The card in slot 7 ------------------------------------------------------
+
+namespace {
+
+using TestConfig = TestFixtures::ScopedTestConfig;
+using TestFixtures::ScopedCore;
+
+constexpr int card_slot = 7;
+constexpr uint16_t io_base = 0xC080 + (card_slot << 4);
+
+auto supersprite_in_slot_7() -> TestConfig::Description {
+  TestConfig::Description description;
+  description.slots[6] = "SuperSprite";
+  return description;
+}
+
+auto card_write(uint8_t reg, uint8_t value) -> void {
+  io_map_dispatch(0, static_cast<uint16_t>(io_base + reg), 1, value, 0);
+}
+
+auto card_read(uint8_t reg) -> uint8_t {
+  return io_map_dispatch(0, static_cast<uint16_t>(io_base + reg), 0, 0, 0);
+}
+
+auto vdp_register(uint8_t reg, uint8_t value) -> void {
+  card_write(1, value);
+  card_write(1, static_cast<uint8_t>(0x80 | reg));
+}
+
+auto vdp_fill(uint16_t addr, uint8_t value, size_t count) -> void {
+  card_write(1, static_cast<uint8_t>(addr & 0xFF));
+  card_write(1, static_cast<uint8_t>(0x40 | (addr >> 8)));
+  for (size_t i = 0; i < count; ++i) {
+    card_write(0, value);
+  }
+}
+
+auto frame_copy() -> std::vector<uint32_t> {
+  peripheral_manager_on_vblank(true);
+  video_redraw_screen();
+  const uint32_t* out = video_get_output_buffer();
+  return {out, out + (static_cast<size_t>(560) * 384)};
+}
+
+auto at(const std::vector<uint32_t>& f, int x, int y) -> uint32_t {
+  return f[static_cast<size_t>((y * 560) + x)];
+}
+
+// Where the output pixel (x, y) samples the VDP frame.
+auto vdp_x(int x) -> int { return (x * 256) / 560; }
+auto vdp_y(int y) -> int { return (y * 192) / 384; }
+
+auto dump_ppm(const std::vector<uint32_t>& f, const char* name) -> void {
+  const char* dir = std::getenv("SUPERSPRITE_DUMP_DIR");
+  if (dir == nullptr) {
+    return;
+  }
+  std::string path = std::string(dir) + "/" + name;
+  FILE* fp = std::fopen(path.c_str(), "wb");
+  if (fp == nullptr) {
+    return;
+  }
+  std::fprintf(fp, "P6\n560 384\n255\n");
+  for (uint32_t p : f) {
+    const std::array<uint8_t, 3> rgb = {static_cast<uint8_t>(p >> 16),
+                                        static_cast<uint8_t>(p >> 8),
+                                        static_cast<uint8_t>(p)};
+    std::fwrite(rgb.data(), 1, rgb.size(), fp);
+  }
+  std::fclose(fp);
+}
+
+}  // namespace
+
+TEST_CASE("SuperSprite: the VDP picture is mixed over the Apple's") {
+  TestConfig config(supersprite_in_slot_7());
+  ScopedCore core(config);
+
+  SS_PERIPHERAL_MANIFEST manifest;
+  peripheral_get_manifest(&manifest);
+  REQUIRE(std::strcmp(manifest.peripherals[card_slot].name, "SuperSprite") ==
+          0);
+
+  // Some Apple text to see through the VDP's transparent pixels.
+  {
+    uint8_t* text = mem_get_main_ptr(0x0400);
+    if (text != nullptr) {
+      for (int i = 0; i < 40; ++i) {
+        text[i] = static_cast<uint8_t>(0xC1 + (i % 26));  // A..Z, normal
+      }
+    }
+  }
+  const auto apple = frame_copy();
+  dump_ppm(apple, "apple_only.ppm");
+
+  // Graphics I: one solid red tile top left, a white sprite at (100, 48).
+  vdp_register(0, 0x00);
+  vdp_register(1, 0xC0);
+  vdp_register(2, 0x06);
+  vdp_register(3, 0x80);
+  vdp_register(4, 0x00);
+  vdp_register(5, 0x36);
+  vdp_register(6, 0x07);
+  vdp_register(7, 0x00);
+  vdp_fill(0x0000, 0x00, 0x4000);
+  vdp_fill(0x0008, 0xFF, 8);       // pattern 1
+  vdp_fill(0x2000, 0x60, 1);       // group 0: red on transparent
+  vdp_fill(0x1800, 0x01, 1);       // name (0, 0) = pattern 1
+  vdp_fill(0x3800, 0xFF, 8);       // sprite pattern 0
+  card_write(1, 0x00);
+  card_write(1, 0x40 | 0x1B);
+  card_write(0, 47);               // Y (drawn from line 48)
+  card_write(0, 100);              // X
+  card_write(0, 0);                // name
+  card_write(0, 0x0F);             // white
+  card_write(0, 0xD0);             // end of list
+
+  // Out of reset the card shows only the Apple.
+  CHECK(frame_copy() == apple);
+
+  card_read(6);  // mix the VDP in
+  card_read(4);  // with the Apple video under it
+  const auto mixed = frame_copy();
+  dump_ppm(mixed, "mixed.ppm");
+
+  int checked = 0;
+  for (int y = 0; y < 384; y += 3) {
+    for (int x = 0; x < 560; x += 3) {
+      const int vx = vdp_x(x);
+      const int vy = vdp_y(y);
+      const bool tile = vx < 8 && vy < 8;
+      const bool sprite = vx >= 100 && vx < 108 && vy >= 48 && vy < 56;
+      if (tile) {
+        CHECK(at(mixed, x, y) == tms9918a_palette_rgb(6));
+      } else if (sprite) {
+        CHECK(at(mixed, x, y) == tms9918a_palette_rgb(15));
+      } else if (at(mixed, x, y) != at(apple, x, y)) {
+        FAIL_CHECK("transparent pixel at " << x << "," << y
+                                           << " is not the Apple's");
+      }
+      ++checked;
+    }
+  }
+  CHECK(checked > 0);
+
+  // Apple video in off: the transparent pixels go black.
+  card_write(3, 0);
+  const auto vdp_only = frame_copy();
+  dump_ppm(vdp_only, "vdp_only.ppm");
+  CHECK(at(vdp_only, 300, 300) == 0);
+  CHECK(at(vdp_only, 4, 4) == tms9918a_palette_rgb(6));
+
+  // Apple only out.
+  card_write(5, 0);
+  CHECK(frame_copy() == apple);
+
+  // The VDP frame interrupt reaches the slot's IRQ line through R1.
+  vdp_register(1, 0xE0);
+  peripheral_manager_on_vblank(true);
+  const uint8_t status = card_read(1);
+  CHECK((status & 0x80) != 0);
+  CHECK((card_read(1) & 0x80) == 0);
+}
+
+TEST_CASE("SuperSprite: the AY registers and the speech port") {
+  TestConfig config(supersprite_in_slot_7());
+  ScopedCore core(config);
+
+  card_write(0xE, 0x07);
+  card_write(0xC, 0x3E);
+  card_write(0xF, 0x08);
+  card_write(0xD, 0x0F);
+  card_write(0xE, 0x07);
+  CHECK(card_read(0xE) == 0x3E);
+  card_write(0xE, 0x08);
+  CHECK(card_read(0xF) == 0x0F);
+
+  // A register number past 15 selects nothing.
+  card_write(0xE, 0x23);
+  CHECK(card_read(0xE) == 0x0F);
+
+  // The Echo II's TMS5220 is not emulated: idle, FIFO empty.
+  CHECK(card_read(2) == 0x7F);
+}
+
+TEST_CASE("SuperSprite: a save state carries VRAM, registers and switches") {
+  TestConfig config(supersprite_in_slot_7());
+  ScopedCore core(config);
+
+  vdp_register(7, 0x1E);
+  vdp_fill(0x1000, 0x5A, 4);
+  card_read(6);
+  card_write(0xE, 0x02);
+  card_write(0xC, 0x77);
+
+  size_t size = 0;
+  peripheral_save_state(card_slot, nullptr, &size);
+  REQUIRE(size > 0);
+  std::vector<uint8_t> blob(size);
+  peripheral_save_state(card_slot, blob.data(), &size);
+
+  vdp_fill(0x1000, 0x00, 4);
+  vdp_register(7, 0x00);
+  card_read(5);
+  card_write(0xE, 0x02);
+  card_write(0xC, 0x00);
+
+  REQUIRE(peripheral_load_state(card_slot, blob.data(), blob.size()) ==
+          peripheral_ok);
+  card_write(1, 0x00);
+  card_write(1, 0x10);  // read setup at 0x1000
+  CHECK(card_read(0) == 0x5A);
+  CHECK(card_read(0) == 0x5A);
+  card_write(0xE, 0x02);
+  CHECK(card_read(0xE) == 0x77);
+
+  // The backdrop register came back (the display is blanked, so the whole
+  // picture is backdrop), and the card mixes again.
+  const auto f = frame_copy();
+  CHECK(at(f, 300, 300) == tms9918a_palette_rgb(0x0E));
+}

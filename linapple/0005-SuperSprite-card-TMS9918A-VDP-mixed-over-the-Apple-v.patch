diff --git a/src/apple2/peripherals/supersprite/SuperSprite.cpp b/src/apple2/peripherals/supersprite/SuperSprite.cpp
new file mode 100644
index 00000000..23b1e5c6
--- /dev/null
+++ b/src/apple2/peripherals/supersprite/SuperSprite.cpp
@@ -0,0 +1,587 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Synetix SuperSprite (1983): a TMS9918A video display processor with 16 KiB
+// of VRAM whose picture is mixed with the Apple's own video, and an
+// AY-3-8912 sound generator. The Echo II speech synthesizer the card carries
+// (a TMS5220) is not emulated: its status port always reads idle.
+//
+// $C0n0-$C0nF, from the SuperSprite Owner's Manual (p. 33) as MAME's ssprite
+// device has it:
+//   0  VDP VRAM read/write            1  VDP status read / control write
+//   2  TMS5220 speech read/write
+//   3  video switch: Apple video in off (VDP transparent shows black)
+//   4  video switch: Apple video in on  (VDP transparent shows the Apple)
+//   5  video switch: Apple only out     (the VDP picture is not shown)
+//   6  video switch: VDP/external mix out
+//   7  VDP write only / frame reset (ignored)
+//   C, D  AY data write               E, F  AY register select; read: data
+//
+// The VDP's 256-pixel line is wider in time than the Apple's 280, so the two
+// pictures never lined up pixel for pixel on a monitor either. Here the VDP
+// frame is scaled to cover the Apple frame exactly.
+
+#include "apple2/peripherals/supersprite/SuperSprite.h"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <new>
+
+#include "apple2/chips/AY8910.h"
+#include "apple2/chips/TMS9918A.h"
+#include "apple2/peripherals/Peripheral.h"
+#include "apple2/peripherals/Peripheral_Audio.h"
+#include "apple2/peripherals/Peripheral_Types.h"
+
+namespace {
+
+constexpr int8_t ss_default_slot = 7;
+constexpr uint32_t cycles_per_ay_tick = 8;
+constexpr size_t scratch_ticks = 1024;
+constexpr double dc_blocker_coefficient = 1.0 - (1.0 / 1000.0);
+constexpr double dc_silence_epsilon = 1.0e-5;
+constexpr size_t frame_pixels =
+    static_cast<size_t>(tms9918a_width) * tms9918a_height;
+
+// TMS5220 status with the FIFO empty and nothing being spoken: BL and BE set,
+// TS clear, and the low bits the card leaves pulled up.
+constexpr uint8_t speech_idle_status = 0x7F;
+
+constexpr const char* channel_names[ay8910_num_voices] = {
+    "AY Voice A", "AY Voice B", "AY Voice C"};
+
+namespace port {
+constexpr uint8_t vram = 0x0;
+constexpr uint8_t control = 0x1;
+constexpr uint8_t speech = 0x2;
+constexpr uint8_t apple_in_off = 0x3;
+constexpr uint8_t apple_in_on = 0x4;
+constexpr uint8_t apple_only = 0x5;
+constexpr uint8_t mix = 0x6;
+constexpr uint8_t ay_data_lo = 0xC;
+constexpr uint8_t ay_data_hi = 0xD;
+constexpr uint8_t ay_select_lo = 0xE;
+constexpr uint8_t ay_select_hi = 0xF;
+}  // namespace port
+
+struct DcBlock {
+  double previous_input = 0.0;
+  double previous_output = 0.0;
+};
+
+struct SuperSprite {
+  Tms9918a vdp = {};
+  Ay8910 ay = {};
+  uint8_t ay_register = 0;
+  std::atomic<bool> apple_in{true};
+  std::atomic<bool> vdp_out{false};
+
+  std::mutex frame_mutex;
+  std::array<uint8_t, frame_pixels> frame = {};
+  std::array<uint8_t, frame_pixels> scratch_frame = {};
+
+  std::array<DcBlock, ay8910_num_voices> dc = {};
+  std::array<std::array<float, scratch_ticks>, ay8910_num_voices> scratch = {};
+  uint32_t synced = 0;
+  uint32_t psg_remainder = 0;
+
+  bool irq_line = false;
+  int slot = 0;
+  HostInterface* host = nullptr;
+};
+
+// --- Save state -------------------------------------------------------------
+
+constexpr uint32_t state_version = 1;
+
+struct SuperSpriteSaveState {
+  uint32_t version;
+  uint32_t struct_size;
+  uint8_t vram[tms9918a_vram_size];
+  uint8_t vdp_regs[tms9918a_num_registers];
+  uint16_t vdp_address;
+  uint8_t vdp_read_ahead;
+  uint8_t vdp_latch;
+  uint8_t vdp_status;
+  uint8_t vdp_second_byte;
+  uint8_t apple_in;
+  uint8_t vdp_out;
+  uint8_t ay_register;
+  uint8_t ay_regs[ay8910_num_registers];
+  uint8_t out_a;
+  uint8_t out_b;
+  uint8_t out_c;
+  uint8_t out_n;
+  uint8_t env_holding;
+  uint8_t env_attack;
+  uint8_t padding;
+  uint16_t count_a;
+  uint16_t count_b;
+  uint16_t count_c;
+  uint16_t padding2;
+  uint32_t count_n;
+  uint32_t rng;
+  uint32_t count_e;
+  uint32_t envelope_step;
+  uint32_t psg_remainder;
+};
+
+static_assert(sizeof(SuperSpriteSaveState) == 16460,
+              "SuperSpriteSaveState must keep its layout on every host");
+
+// --- Interrupts -------------------------------------------------------------
+
+auto update_irq(SuperSprite* ss) -> void {
+  const bool line = tms9918a_irq(&ss->vdp);
+  if (line == ss->irq_line) {
+    return;
+  }
+  ss->irq_line = line;
+  if (ss->host != nullptr && ss->host->AssertIrq != nullptr) {
+    ss->host->AssertIrq(ss->slot, line);
+  }
+}
+
+// --- Sound ------------------------------------------------------------------
+
+auto run_dc_block(DcBlock* f, float* buffer, size_t count) -> bool {
+  bool any_signal = false;
+  for (size_t i = 0; i < count; ++i) {
+    const double input = buffer[i];
+    double output = input - f->previous_input +
+                    (dc_blocker_coefficient * f->previous_output);
+    if (output > -dc_silence_epsilon && output < dc_silence_epsilon) {
+      output = 0.0;
+    }
+    f->previous_input = input;
+    f->previous_output = output;
+    buffer[i] = static_cast<float>(output);
+    any_signal = any_signal || output != 0.0;
+  }
+  return any_signal;
+}
+
+auto render_chunk(SuperSprite* ss, size_t ticks) -> void {
+  std::array<float*, ay8910_num_voices> voices = {
+      {ss->scratch[0].data(), ss->scratch[1].data(), ss->scratch[2].data()}};
+  ay8910_step(&ss->ay, ticks, voices.data(), scratch_ticks);
+
+  std::array<const float*, ay8910_num_voices> channels = {};
+  bool any_signal = false;
+  for (size_t v = 0; v < ay8910_num_voices; ++v) {
+    any_signal =
+        run_dc_block(&ss->dc[v], ss->scratch[v].data(), ticks) || any_signal;
+    channels[v] = ss->scratch[v].data();
+  }
+  if (any_signal && ss->host != nullptr &&
+      ss->host->AudioPushChannels != nullptr) {
+    ss->host->AudioPushChannels(ss, channels.data(), ay8910_num_voices, ticks);
+  }
+}
+
+auto advance(SuperSprite* ss, uint32_t cycles) -> void {
+  const uint64_t total = static_cast<uint64_t>(ss->psg_remainder) + cycles;
+  uint64_t ticks = total / cycles_per_ay_tick;
+  ss->psg_remainder = static_cast<uint32_t>(total % cycles_per_ay_tick);
+  while (ticks > 0) {
+    const size_t count =
+        (ticks < scratch_ticks) ? static_cast<size_t>(ticks) : scratch_ticks;
+    render_chunk(ss, count);
+    ticks -= count;
+  }
+}
+
+// A register write takes effect on the cycle it happens, so the sound is
+// brought up to it first.
+auto sync_to(SuperSprite* ss, uint32_t executed_cycles) -> void {
+  if (executed_cycles <= ss->synced) {
+    return;
+  }
+  advance(ss, executed_cycles - ss->synced);
+  ss->synced = executed_cycles;
+}
+
+// --- I/O --------------------------------------------------------------------
+
+auto floating(SuperSprite* ss, uint32_t executed_cycles) -> uint8_t {
+  if (ss->host != nullptr && ss->host->ReadFloatingBus != nullptr) {
+    return ss->host->ReadFloatingBus(executed_cycles);
+  }
+  return 0xFF;
+}
+
+// The video switches answer any access to their address, read or write.
+auto video_switch(SuperSprite* ss, uint8_t reg) -> bool {
+  switch (reg) {
+    case port::apple_in_off:
+      ss->apple_in = false;
+      return true;
+    case port::apple_in_on:
+      ss->apple_in = true;
+      return true;
+    case port::apple_only:
+      ss->vdp_out = false;
+      return true;
+    case port::mix:
+      ss->vdp_out = true;
+      return true;
+    default:
+      return false;
+  }
+}
+
+auto io_read(void* instance, uint16_t pc, uint16_t addr, uint8_t write,
+             uint8_t val, uint32_t executed_cycles) -> uint8_t {
+  (void)pc;
+  (void)write;
+  (void)val;
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr) {
+    return 0xFF;
+  }
+  const auto reg = static_cast<uint8_t>(addr & 0x0F);
+  switch (reg) {
+    case port::vram:
+      return tms9918a_data_read(&ss->vdp);
+    case port::control: {
+      const uint8_t status = tms9918a_status_read(&ss->vdp);
+      update_irq(ss);
+      return status;
+    }
+    case port::speech:
+      return speech_idle_status;
+    case port::ay_select_lo:
+    case port::ay_select_hi:
+      sync_to(ss, executed_cycles);
+      return ss->ay.regs[ss->ay_register];
+    default:
+      video_switch(ss, reg);
+      return floating(ss, executed_cycles);
+  }
+}
+
+auto io_write(void* instance, uint16_t pc, uint16_t addr, uint8_t write,
+              uint8_t val, uint32_t executed_cycles) -> uint8_t {
+  (void)pc;
+  (void)write;
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr) {
+    return 0;
+  }
+  const auto reg = static_cast<uint8_t>(addr & 0x0F);
+  switch (reg) {
+    case port::vram:
+      tms9918a_data_write(&ss->vdp, val);
+      break;
+    case port::control:
+      // R1 holds the interrupt enable, so a register write can raise or
+      // drop the line.
+      tms9918a_control_write(&ss->vdp, val);
+      update_irq(ss);
+      break;
+    case port::ay_data_lo:
+    case port::ay_data_hi:
+      sync_to(ss, executed_cycles);
+      ay8910_write(&ss->ay, ss->ay_register, val);
+      break;
+    case port::ay_select_lo:
+    case port::ay_select_hi:
+      // The AY-3-8912's upper address lines are tied to select it at 0-15;
+      // a higher value selects nothing and keeps the latched register.
+      if (val < ay8910_num_registers) {
+        ss->ay_register = val;
+      }
+      break;
+    default:
+      video_switch(ss, reg);
+      break;
+  }
+  return 0;
+}
+
+// --- Video ------------------------------------------------------------------
+
+auto overlay(void* instance, uint32_t* pixels, int width, int height,
+             int pitch) -> void {
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr || pixels == nullptr || width <= 0 || height <= 0 ||
+      !ss->vdp_out.load()) {
+    return;
+  }
+  const bool apple_in = ss->apple_in.load();
+  const std::lock_guard<std::mutex> lock(ss->frame_mutex);
+  for (int y = 0; y < height; ++y) {
+    const int sy = (y * tms9918a_height) / height;
+    const uint8_t* src =
+        ss->frame.data() + (static_cast<ptrdiff_t>(sy) * tms9918a_width);
+    uint32_t* dst = pixels + (static_cast<ptrdiff_t>(y) * pitch);
+    for (int x = 0; x < width; ++x) {
+      const uint8_t c = src[(x * tms9918a_width) / width];
+      if (c != 0) {
+        dst[x] = tms9918a_palette_rgb(c);
+      } else if (!apple_in) {
+        dst[x] = 0;
+      }
+    }
+  }
+}
+
+// --- Peripheral ABI ---------------------------------------------------------
+
+auto ss_init(int slot, HostInterface* host) -> void* {
+  if (host == nullptr || host->RegisterIO == nullptr) {
+    return nullptr;
+  }
+  auto card = std::unique_ptr<SuperSprite>(new (std::nothrow) SuperSprite{});
+  if (!card) {
+    return nullptr;
+  }
+  card->host = host;
+  card->slot = slot;
+  tms9918a_reset(&card->vdp);
+  ay8910_reset(&card->ay);
+  host->RegisterIO(slot, io_read, io_write, nullptr, nullptr);
+  if (host->SetVideoOverlay != nullptr) {
+    host->SetVideoOverlay(card.get(), overlay);
+  } else if (host->Log != nullptr) {
+    host->Log(card.get(), log_warn,
+              "SuperSprite: this host cannot mix the VDP picture in\n");
+  }
+  return card.release();
+}
+
+auto ss_reset(void* instance) -> void {
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr) {
+    return;
+  }
+  tms9918a_reset(&ss->vdp);
+  ay8910_reset(&ss->ay);
+  ss->ay_register = 0;
+  ss->apple_in = true;
+  ss->vdp_out = false;
+  for (auto& f : ss->dc) {
+    f = DcBlock{};
+  }
+  ss->synced = 0;
+  ss->psg_remainder = 0;
+  ss->irq_line = false;
+  if (ss->host != nullptr && ss->host->AssertIrq != nullptr) {
+    ss->host->AssertIrq(ss->slot, false);
+  }
+}
+
+auto ss_shutdown(void* instance) -> void {
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr) {
+    return;
+  }
+  if (ss->host != nullptr && ss->host->SetVideoOverlay != nullptr) {
+    ss->host->SetVideoOverlay(ss, nullptr);
+  }
+  delete ss;
+}
+
+auto ss_think(void* instance, uint32_t cycles) -> void {
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr) {
+    return;
+  }
+  if (cycles > ss->synced) {
+    advance(ss, cycles - ss->synced);
+  }
+  ss->synced = 0;
+}
+
+// The frame is drawn whole at the end of each Apple frame, which is also when
+// the VDP raises its frame interrupt. Changes in the middle of a frame show on
+// the next one.
+auto ss_on_vblank(void* instance, bool vblank) -> void {
+  auto* ss = static_cast<SuperSprite*>(instance);
+  if (ss == nullptr || !vblank) {
+    return;
+  }
+  tms9918a_render_frame(&ss->vdp, ss->scratch_frame.data());
+  {
+    const std::lock_guard<std::mutex> lock(ss->frame_mutex);
+    ss->frame = ss->scratch_frame;
+  }
+  update_irq(ss);
+}
+
+auto ss_save_state(void* instance, void* buffer, size_t* size)
+    -> PeripheralStatus {
+  if (size == nullptr) {
+    return peripheral_error;
+  }
+  const size_t required = sizeof(SuperSpriteSaveState);
+  if (buffer == nullptr) {
+    *size = required;
+    return peripheral_ok;
+  }
+  if (instance == nullptr || *size < required) {
+    *size = required;
+    return peripheral_error;
+  }
+  const auto* ss = static_cast<const SuperSprite*>(instance);
+  auto* st = static_cast<SuperSpriteSaveState*>(buffer);
+  std::memset(st, 0, required);
+  st->version = state_version;
+  st->struct_size = static_cast<uint32_t>(required);
+  std::memcpy(st->vram, ss->vdp.vram.data(), tms9918a_vram_size);
+  std::memcpy(st->vdp_regs, ss->vdp.regs.data(), tms9918a_num_registers);
+  st->vdp_address = ss->vdp.address;
+  st->vdp_read_ahead = ss->vdp.read_ahead;
+  st->vdp_latch = ss->vdp.latch;
+  st->vdp_status = ss->vdp.status;
+  st->vdp_second_byte = ss->vdp.second_byte ? 1U : 0U;
+  st->apple_in = ss->apple_in.load() ? 1U : 0U;
+  st->vdp_out = ss->vdp_out.load() ? 1U : 0U;
+  st->ay_register = ss->ay_register;
+  std::memcpy(st->ay_regs, ss->ay.regs.data(), ay8910_num_registers);
+  st->out_a = ss->ay.out_a;
+  st->out_b = ss->ay.out_b;
+  st->out_c = ss->ay.out_c;
+  st->out_n = ss->ay.out_n;
+  st->env_holding = ss->ay.env_holding ? 1U : 0U;
+  st->env_attack = ss->ay.env_attack ? 1U : 0U;
+  st->count_a = ss->ay.count_a;
+  st->count_b = ss->ay.count_b;
+  st->count_c = ss->ay.count_c;
+  st->count_n = ss->ay.count_n;
+  st->rng = ss->ay.rng;
+  st->count_e = ss->ay.count_e;
+  st->envelope_step = ss->ay.envelope_step;
+  st->psg_remainder = ss->psg_remainder;
+  *size = required;
+  return peripheral_ok;
+}
+
+auto ss_load_state(void* instance, const void* buffer, size_t size)
+    -> PeripheralStatus {
+  if (instance == nullptr || buffer == nullptr ||
+      size != sizeof(SuperSpriteSaveState)) {
+    return peripheral_error;
+  }
+  const auto* st = static_cast<const SuperSpriteSaveState*>(buffer);
+  if (st->version != state_version ||
+      st->struct_size != sizeof(SuperSpriteSaveState)) {
+    return peripheral_error;
+  }
+  auto* ss = static_cast<SuperSprite*>(instance);
+  std::memcpy(ss->vdp.vram.data(), st->vram, tms9918a_vram_size);
+  std::memcpy(ss->vdp.regs.data(), st->vdp_regs, tms9918a_num_registers);
+  ss->vdp.address = st->vdp_address & (tms9918a_vram_size - 1);
+  ss->vdp.read_ahead = st->vdp_read_ahead;
+  ss->vdp.latch = st->vdp_latch;
+  ss->vdp.status = st->vdp_status;
+  ss->vdp.second_byte = st->vdp_second_byte != 0;
+  ss->apple_in = st->apple_in != 0;
+  ss->vdp_out = st->vdp_out != 0;
+  ss->ay_register = st->ay_register & (ay8910_num_registers - 1);
+  for (size_t r = 0; r < ay8910_num_registers; ++r) {
+    ay8910_write(&ss->ay, static_cast<uint8_t>(r), st->ay_regs[r]);
+  }
+  ss->ay.out_a = st->out_a;
+  ss->ay.out_b = st->out_b;
+  ss->ay.out_c = st->out_c;
+  ss->ay.out_n = st->out_n;
+  ss->ay.env_holding = st->env_holding != 0;
+  ss->ay.env_attack = st->env_attack != 0;
+  ss->ay.count_a = st->count_a;
+  ss->ay.count_b = st->count_b;
+  ss->ay.count_c = st->count_c;
+  ss->ay.count_n = st->count_n;
+  ss->ay.rng = (st->rng != 0) ? st->rng : 1U;
+  ss->ay.count_e = st->count_e;
+  ss->ay.envelope_step = st->envelope_step & 0x0F;
+  ss->ay.envelope_vol = static_cast<uint8_t>(
+      ss->ay.env_attack ? ss->ay.envelope_step
+                        : (15U - ss->ay.envelope_step));
+  ss->psg_remainder = st->psg_remainder % cycles_per_ay_tick;
+  ss->synced = 0;
+  for (auto& f : ss->dc) {
+    f = DcBlock{};
+  }
+  // Show the restored VRAM at once rather than a frame later.
+  {
+    const uint8_t status = ss->vdp.status;
+    tms9918a_render_frame(&ss->vdp, ss->scratch_frame.data());
+    ss->vdp.status = status;
+    const std::lock_guard<std::mutex> lock(ss->frame_mutex);
+    ss->frame = ss->scratch_frame;
+  }
+  ss->irq_line = !tms9918a_irq(&ss->vdp);
+  update_irq(ss);
+  return peripheral_ok;
+}
+
+auto query_audio_info(void* out, size_t* out_size) -> PeripheralStatus {
+  const size_t required = sizeof(PeripheralAudioInfo);
+  if (out == nullptr) {
+    *out_size = required;
+    return peripheral_ok;
+  }
+  if (*out_size < required) {
+    *out_size = required;
+    return peripheral_error;
+  }
+  std::memset(out, 0, required);
+  auto& info = *static_cast<PeripheralAudioInfo*>(out);
+  info.time_base = peripheral_audio_cpu_clocked;
+  info.cycle_divisor = cycles_per_ay_tick;
+  info.num_channels = ay8910_num_voices;
+  info.peak_magnitude = 1.0F;
+  for (size_t i = 0; i < ay8910_num_voices; ++i) {
+    std::strncpy(info.channels[i].name, channel_names[i],
+                 sizeof(info.channels[i].name) - 1);
+    // One mono output jack.
+    info.channels[i].default_pan_left = 1.0F;
+    info.channels[i].default_pan_right = 1.0F;
+  }
+  *out_size = required;
+  return peripheral_ok;
+}
+
+auto ss_query(void* instance, uint32_t cmd_id, void* out, size_t* out_size)
+    -> PeripheralStatus {
+  if (instance == nullptr || out_size == nullptr) {
+    return peripheral_error;
+  }
+  if (cmd_id == PERIPHERAL_QUERY_AUDIO_INFO) {
+    return query_audio_info(out, out_size);
+  }
+  return peripheral_incompatible;
+}
+
+Peripheral supersprite_peripheral = {
+    .abi_version = LINAPPLE_ABI_VERSION,
+    .id = "linapple.supersprite",
+    .name = "SuperSprite",
+    .description = "Synetix SuperSprite (TMS9918A VDP, AY-3-8912)",
+    .author = "LinApple Contributors",
+    .version = VERSIONSTRING,
+    .compatible_slots = PERIPHERAL_MASK_EXPANSION,
+    .default_slot = ss_default_slot,
+    .init = ss_init,
+    .reset = ss_reset,
+    .shutdown = ss_shutdown,
+    .think = ss_think,
+    .on_vblank = ss_on_vblank,
+    .save_state = ss_save_state,
+    .load_state = ss_load_state,
+    .command = nullptr,
+    .query = ss_query,
+};
+
+}  // namespace
+
+extern "C" auto supersprite_get_descriptor() -> Peripheral* {
+  return &supersprite_peripheral;
+}
+
+PERIPHERAL_REGISTER(supersprite_peripheral)

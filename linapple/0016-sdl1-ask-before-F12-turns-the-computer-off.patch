From b4b61ed86e455ef5226af517b1a8c680d286a9e2 Mon Sep 17 00:00:00 2001
From: James <spadent@gmail.com>
Date: Sat, 7 Nov 2026 05:32:44 +0900
Subject: [PATCH 16/18] sdl1: ask before F12 turns the computer off

On the Apple II PC boot image F12 powers the PC off. F12 now shows 'Turn
the computer off?' over the screen (Enter/Y yes, Esc/N back to the game)
from the emulator, the help screen, the disk chooser and the display
menu. A quit request from the system is not asked about.
---
 src/frontends/sdl1/DiskChoose.cpp  |  5 +-
 src/frontends/sdl1/DisplayMenu.cpp |  6 ++-
 src/frontends/sdl1/Frame.cpp       | 87 +++++++++++++++++++++++++++++-
 src/frontends/sdl1/Frame.h         |  3 ++
 tests/test_frontend_sdl1.cpp       | 38 +++++++++++++
 5 files changed, 135 insertions(+), 4 deletions(-)

diff --git a/src/frontends/sdl1/DiskChoose.cpp b/src/frontends/sdl1/DiskChoose.cpp
index fe7e36e8..cadf89dd 100644
--- a/src/frontends/sdl1/DiskChoose.cpp
+++ b/src/frontends/sdl1/DiskChoose.cpp
@@ -62,7 +62,7 @@ auto wait_for_dismissal() -> void {
   while (true) {
     while (SDL_PollEvent(&event) != 0) {
       if (event.type == SDL_KEYDOWN) {
-        if (event.key.keysym.sym == SDLK_F12) {
+        if (event.key.keysym.sym == SDLK_F12 && frame_confirm_power_off()) {
           system_state.mode = app_mode_exit;
           SDL_Event qe{};
           qe.type = SDL_QUIT;
@@ -212,6 +212,9 @@ auto disk_choose_tick(SDL_Event* event) -> void {
       break;
 
     case SDLK_F12: {
+      if (!frame_confirm_power_off()) {
+        break;
+      }
       disk_choose_state.active = false;
       disk_choose_state.cancelled = true;
       system_state.mode = app_mode_exit;
diff --git a/src/frontends/sdl1/DisplayMenu.cpp b/src/frontends/sdl1/DisplayMenu.cpp
index ac660206..5c2e3312 100644
--- a/src/frontends/sdl1/DisplayMenu.cpp
+++ b/src/frontends/sdl1/DisplayMenu.cpp
@@ -430,8 +430,10 @@ auto display_menu_open() -> void {
         done = true;
         break;
       case SDLK_F12:
-        request_quit();
-        done = true;

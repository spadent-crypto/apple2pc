+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <string>
+
+// Display settings menu (Alt+F9) for the Apple II PC boot image.
+//
+// The screen resolution lives in a display.txt that the boot loader reads
+// (RESOLUTION=WxH or auto) and the scaling there too (PRIORITY=aspect or
+// sharp). The menu edits that file, whose path comes from the environment
+// variable APPLE2PC_DISPLAY_FILE, together with "Scale Mode" and "Monitor
+// Aspect" in linapple.conf. A new resolution needs a restart: answering
+// yes creates the file named by APPLE2PC_REBOOT_FLAG and quits, and the
+// session script restarts the machine.
+
+// Full-screen menu. Blocks until the user saves or cancels.
+auto display_menu_open() -> void;
+
+// The value of KEY=value in display.txt text (spaces and a CR at the end
+// dropped, lower case), or "" when it is not there.
+auto display_file_get(const std::string& text, const char* key) -> std::string;
+
+// The text with KEY=value set: the existing line is replaced (keeping a CR
+// at its end), or a line is added in the file's own line-end style.
+auto display_file_set(const std::string& text, const char* key,
+                      const std::string& value) -> std::string;

+TEST_CASE("Display menu edits display.txt and keeps its comments and line ends") {
+  const std::string crlf =
+      "# comment RESOLUTION=640x480\r\n"
+      "RESOLUTION=1024x768\r\n"
+      "#\r\n"
+      "PRIORITY = Aspect  # note\r\n";
+  CHECK(display_file_get(crlf, "RESOLUTION") == "1024x768");
+  CHECK(display_file_get(crlf, "PRIORITY") == "aspect");
+  CHECK(display_file_get(crlf, "MISSING").empty());
+
+  std::string t = display_file_set(crlf, "RESOLUTION", "800x600");
+  t = display_file_set(t, "PRIORITY", "sharp");
+  CHECK(t ==
+        "# comment RESOLUTION=640x480\r\n"
+        "RESOLUTION=800x600\r\n"
+        "#\r\n"
+        "PRIORITY =sharp\r\n");
+  CHECK(display_file_get(t, "RESOLUTION") == "800x600");
+
+  // A key the file lacks is added in its own line-end style.
+  CHECK(display_file_set("A=1\n", "PRIORITY", "sharp") == "A=1\nPRIORITY=sharp\n");
+  CHECK(display_file_set("A=1\r\n", "PRIORITY", "sharp") ==
+        "A=1\r\nPRIORITY=sharp\r\n");
+  CHECK(display_file_set("", "RESOLUTION", "auto") == "RESOLUTION=auto\n");

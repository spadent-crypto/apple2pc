+auto frame_refit_picture() -> void {
   {
     const std::lock_guard<std::recursive_mutex> lock(video_draw_mutex);
     if (is_fullscreen && window_resized) {
@@ -373,24 +398,9 @@ auto cycle_monitor_aspect() -> void {
       SDL_FillRect(screen, nullptr, 0);
     }
   }

+// Each game keeps its own ten slots, in a folder named after the disk it
+// booted from: hard drive 1 when one is in, else floppy drive 1. Taken at
+// start-up and at each reboot, so changing disks inside a game keeps it.
+std::string game_folder;
+
+auto boot_disk_path() -> std::string {
+  const int hd_slot = harddisk_frontend_slot();
+  if (hd_slot > 0) {
+    HarddiskStatus hd{};
+    size_t size = sizeof(hd);
+    if (peripheral_query(hd_slot, harddisk_query_status, &hd, &size) ==
+            peripheral_ok &&
+        hd.drive0_loaded != 0 && hd.drive0_full_path[0] != '\0') {
+      return hd.drive0_full_path;
+    }
+  }
+  DiskStatus fd{};
+  size_t size = sizeof(fd);
+  if (peripheral_query(disk_default_slot, disk_query_status, &fd, &size) ==
+          peripheral_ok &&
+      fd.drive0_loaded != 0 && fd.drive0_full_path[0] != '\0') {
+    return fd.drive0_full_path;
+  }
+  return "";
+}
+
+// The image's file name without its folder and extension, made safe for
+// a FAT folder name.
+auto folder_name_for(const std::string& path) -> std::string {
+  std::string name = path;
+  const size_t slash = name.find_last_of('/');
+  if (slash != std::string::npos) {
+    name = name.substr(slash + 1);
+  }
+  const size_t dot = name.find_last_of('.');
+  if (dot != std::string::npos && dot > 0) {
+    name = name.substr(0, dot);
+  }
+  std::string out;
+  for (const char c : name) {
+    const auto u = static_cast<unsigned char>(c);
+    if (u < 0x20 || std::strchr("\\/:*?\"<>|", c) != nullptr) {
+      out += '_';
+    } else {
+      out += c;
+    }
+  }
+  while (!out.empty() && (out.back() == ' ' || out.back() == '.')) {
+    out.pop_back();
+  }
+  while (!out.empty() && out.front() == ' ') {
+    out.erase(out.begin());
+  }
+  if (out.size() > 64) {
+    out.resize(64);
+  }
+  return out.empty() ? std::string("No disk") : out;
+}
+
+auto game_dir() -> std::string {
+  if (game_folder.empty()) {
+    gallery_note_boot_disk();
+  }
+  return save_dir() + "/" + game_folder;
+}

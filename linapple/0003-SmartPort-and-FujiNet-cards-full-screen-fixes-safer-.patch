+#!/bin/sh
+# Rebuild SmartPortRom.h from smartport.s for slots 1-7 (needs cc65).
+set -e
+cd "$(dirname "$0")"
+out=../SmartPortRom.h
+tmp=$(mktemp -d)
+{
+  echo "// SPDX-License-Identifier: GPL-2.0-only"
+  echo "// Generated by firmware/gen_rom.sh from firmware/smartport.s; do not edit."
+  echo "#pragma once"
+  echo
+  echo "#include <cstdint>"
+  echo
+  echo "// One 256-byte \$Cn00 page per slot, index 0 = slot 1."
+  echo "static const uint8_t smartport_rom[7][256] = {"
+  for s in 1 2 3 4 5 6 7; do
+    ca65 -D SLOT=$s -o "$tmp/f$s.o" smartport.s
+    ld65 -t none -o "$tmp/f$s.bin" "$tmp/f$s.o"
+    size=$(wc -c < "$tmp/f$s.bin")
+    [ "$size" -eq 256 ] || { echo "slot $s image is $size bytes" >&2; exit 1; }
+    echo "    {"
+    od -An -v -tx1 "$tmp/f$s.bin" | sed 's/  */ /g; s/^ //; s/ $//; s/\([0-9a-f][0-9a-f]\)/0x\1,/g; s/^/        /'
+    echo "    },"
+  done
+  echo "};"
+} > "$out"
+rm -rf "$tmp"
+echo "wrote $out"

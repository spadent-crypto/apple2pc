--- /dev/null
+++ b/src/apple2/peripherals/smartport/FujiNetLink.cpp
@@ -0,0 +1,420 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "apple2/peripherals/smartport/FujiNetLink.h"
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+
+namespace fujinet {
+
+namespace {
+
+constexpr uint8_t slip_end = 0xC0;
+constexpr uint8_t slip_esc = 0xDB;
+constexpr uint8_t slip_esc_end = 0xDC;
+constexpr uint8_t slip_esc_esc = 0xDD;
+
+constexpr size_t header_size = 11;
+constexpr size_t param_offset = 6;
+constexpr size_t max_params = header_size - param_offset;
+constexpr uint8_t max_units = 254;
+
+auto slip_encode(const std::vector<uint8_t>& data) -> std::vector<uint8_t> {
+  std::vector<uint8_t> out;
+  out.reserve(data.size() + 8);
+  out.push_back(slip_end);
+  for (uint8_t b : data) {
+    if (b == slip_end) {
+      out.push_back(slip_esc);
+      out.push_back(slip_esc_end);
+    } else if (b == slip_esc) {
+      out.push_back(slip_esc);
+      out.push_back(slip_esc_esc);
+    } else {
+      out.push_back(b);
+    }
+  }
+  out.push_back(slip_end);
+  return out;
+}
+
+}  // namespace
+
+// One TCP connection from a FujiNet-PC. A reader thread decodes the SLIP
+// stream and files each reply under its sequence number.
+class Connection {
+ public:
+  explicit Connection(int socket) : socket_(socket) {}
+  ~Connection() {
+    close();
+    if (reader_.joinable()) {
+      reader_.join();
+    }
+  }
+  Connection(const Connection&) = delete;
+  auto operator=(const Connection&) -> Connection& = delete;
+
+  template <typename OnClose>
+  auto start(OnClose on_close) -> void {
+    reader_ = std::thread([this, on_close]() {
+      read_loop();
+      on_close(this);
+    });
+  }
+
+  auto alive() const -> bool { return alive_.load(); }
+
+  auto close() -> void {
+    alive_ = false;
+    std::lock_guard<std::mutex> lock(send_mutex_);
+    if (socket_ >= 0) {
+      shutdown(socket_, SHUT_RDWR);
+    }
+  }
+
+  auto finished() const -> bool { return finished_.load(); }
+
+  auto join() -> void {
+    if (reader_.joinable()) {
+      reader_.join();
+    }
+    std::lock_guard<std::mutex> lock(send_mutex_);
+    if (socket_ >= 0) {
+      ::close(socket_);
+      socket_ = -1;
+    }
+  }
+
+  auto send(const std::vector<uint8_t>& packet) -> bool {
+    const std::vector<uint8_t> frame = slip_encode(packet);
+    std::lock_guard<std::mutex> lock(send_mutex_);
+    size_t sent = 0;
+    while (sent < frame.size()) {
+      const ssize_t n = ::send(socket_, frame.data() + sent,
+                               frame.size() - sent, MSG_NOSIGNAL);
+      if (n <= 0) {
+        if (n < 0 && errno == EINTR) {
+          continue;
+        }
+        alive_ = false;
+        return false;
+      }
+      sent += static_cast<size_t>(n);
+    }
+    return true;
+  }
+
+  // The reply with this sequence number, or nothing after `timeout`.
+  auto wait(uint8_t sequence, std::chrono::milliseconds timeout,
+            std::vector<uint8_t>* reply) -> bool {
+    std::unique_lock<std::mutex> lock(replies_mutex_);
+    const bool got = replies_cv_.wait_for(lock, timeout, [&]() {
+      return replies_.count(sequence) != 0 || !alive_.load();
+    });
+    auto it = replies_.find(sequence);
+    if (!got || it == replies_.end()) {
+      return false;
+    }
+    *reply = std::move(it->second);
+    replies_.erase(it);
+    return true;
+  }
+
+  auto forget(uint8_t sequence) -> void {
+    std::lock_guard<std::mutex> lock(replies_mutex_);
+    replies_.erase(sequence);
+  }
+
+ private:
+  auto read_loop() -> void {
+    std::vector<uint8_t> frame;
+    bool in_frame = false;
+    bool escaped = false;
+    uint8_t buffer[2048];
+    while (alive_.load()) {
+      const ssize_t n = recv(socket_, buffer, sizeof(buffer), 0);
+      if (n < 0 && errno == EINTR) {
+        continue;
+      }
+      if (n <= 0) {
+        break;
+      }
+      for (ssize_t i = 0; i < n; ++i) {
+        const uint8_t b = buffer[i];
+        if (b == slip_end) {
+          if (in_frame && !frame.empty()) {
+            deliver(frame);
+          }
+          frame.clear();
+          in_frame = true;
+          escaped = false;
+          continue;
+        }
+        if (!in_frame) {
+          continue;
+        }
+        if (escaped) {
+          escaped = false;
+          if (b == slip_esc_end) {
+            frame.push_back(slip_end);
+          } else if (b == slip_esc_esc) {
+            frame.push_back(slip_esc);
+          } else {
+            in_frame = false;  // bad escape: drop the frame
+            frame.clear();
+          }
+        } else if (b == slip_esc) {
+          escaped = true;
+        } else {
+          frame.push_back(b);
+        }
+      }
+    }
+    alive_ = false;
+    finished_ = true;
+    replies_cv_.notify_all();
+  }
+
+  auto deliver(const std::vector<uint8_t>& frame) -> void {
+    {
+      std::lock_guard<std::mutex> lock(replies_mutex_);
+      replies_[frame[0]] = frame;
+    }
+    replies_cv_.notify_all();
+  }
+
+  int socket_;
+  std::atomic<bool> alive_{true};
+  std::atomic<bool> finished_{false};
+  std::thread reader_;
+  std::mutex send_mutex_;
+  std::mutex replies_mutex_;
+  std::condition_variable replies_cv_;
+  std::map<uint8_t, std::vector<uint8_t>> replies_;
+};
+
+Link::~Link() { stop(); }
+
+auto Link::start(const std::string& address, uint16_t port,
+                 std::chrono::seconds timeout, std::string* error) -> bool {
+  stop();
+  timeout_ = timeout;
+
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0) {
+    *error = std::string("socket: ") + std::strerror(errno);
+    return false;
+  }
+  const int yes = 1;
+  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(port);
+  if (inet_pton(AF_INET, address.c_str(), &addr.sin_addr) != 1) {
+    *error = "not an IPv4 address: " + address;
+    ::close(fd);
+    return false;
+  }
+  if (bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0 ||
+      listen(fd, 4) != 0) {
+    *error = address + ":" + std::to_string(port) + ": " +
+             std::strerror(errno);
+    ::close(fd);
+    return false;
+  }
+
+  server_ = fd;
+  running_ = true;
+  listener_ = std::thread([this]() { listen_loop(); });
+  return true;
+}
+
+auto Link::stop() -> void {
+  if (!running_.exchange(false)) {
+    return;
+  }
+  if (listener_.joinable()) {
+    listener_.join();
+  }
+  if (server_ >= 0) {
+    ::close(server_);
+    server_ = -1;
+  }
+  std::vector<std::shared_ptr<Connection>> connections;
+  {
+    std::lock_guard<std::mutex> lock(units_mutex_);
+    connections.swap(connections_);
+    units_.clear();
+  }
+  for (auto& c : connections) {
+    c->close();
+  }
+  for (auto& c : connections) {
+    c->join();
+  }
+  ++generation_;
+  units_changed_.notify_all();
+}
+
+auto Link::listen_loop() -> void {
+  while (running_.load()) {
+    fd_set set;
+    FD_ZERO(&set);
+    FD_SET(server_, &set);
+    timeval tv{};
+    tv.tv_usec = 200000;
+    const int ready = select(server_ + 1, &set, nullptr, nullptr, &tv);
+    if (ready < 0 && errno != EINTR) {
+      break;
+    }
+    if (ready <= 0) {
+      continue;
+    }
+    const int client = accept(server_, nullptr, nullptr);
+    if (client >= 0) {
+      adopt(client);
+    }
+  }
+}
+
+// A FujiNet-PC connected: count its units with INIT 1, 2, ... until one
+// answers END OF CHAIN. The connection serves the Apple only once counted.
+auto Link::adopt(int socket) -> void {
+  const int yes = 1;
+  setsockopt(socket, IPPROTO_TCP, TCP_NODELAY, &yes, sizeof(yes));
+
+  auto connection = std::make_shared<Connection>(socket);
+  connection->start([this](const Connection* c) { drop(c); });
+
+  // Reap connections whose reader has ended.
+  {
+    std::vector<std::shared_ptr<Connection>> finished;
+    {
+      std::lock_guard<std::mutex> lock(units_mutex_);
+      auto it = std::stable_partition(
+          connections_.begin(), connections_.end(),
+          [](const std::shared_ptr<Connection>& c) { return !c->finished(); });
+      finished.assign(it, connections_.end());
+      connections_.erase(it, connections_.end());
+    }
+    for (auto& c : finished) {
+      c->join();
+    }
+  }
+
+  std::vector<uint8_t> device_ids;
+  for (uint8_t id = 1; id <= max_units && connection->alive(); ++id) {
+    const uint8_t seq = sequence_++;
+    std::vector<uint8_t> packet(header_size, 0);
+    packet[0] = seq;
+    packet[1] = smartport::cmd_init;
+    packet[2] = 1;
+    packet[3] = id;
+    if (!connection->send(packet)) {
+      break;
+    }
+    std::vector<uint8_t> reply;
+    if (!connection->wait(seq, std::chrono::seconds(10), &reply) ||
+        reply.size() < 2) {
+      connection->forget(seq);
+      break;
+    }
+    // As on a real SmartPort chain every unit answers INIT, and the last
+    // one answers with END OF CHAIN (non-zero) instead of no error.
+    device_ids.push_back(id);
+    if (reply[1] != 0) {
+      break;
+    }
+  }
+
+  std::lock_guard<std::mutex> lock(units_mutex_);
+  connections_.push_back(connection);
+  if (!connection->alive()) {
+    return;
+  }
+  for (uint8_t id : device_ids) {
+    if (units_.size() >= max_units) {
+      break;
+    }
+    Unit unit;
+    unit.connection = connection;
+    unit.device_id = id;
+    units_.push_back(unit);
+  }
+  ++generation_;
+  units_changed_.notify_all();
+}
+
+auto Link::drop(const Connection* connection) -> void {
+  std::lock_guard<std::mutex> lock(units_mutex_);
+  const auto before = units_.size();
+  units_.erase(std::remove_if(units_.begin(), units_.end(),
+                              [connection](const Unit& u) {
+                                return u.connection.get() == connection;
+                              }),
+               units_.end());
+  if (units_.size() != before) {
+    ++generation_;
+    units_changed_.notify_all();
+  }
+}
+
+auto Link::unit_count() -> uint8_t {
+  std::lock_guard<std::mutex> lock(units_mutex_);
+  return static_cast<uint8_t>(units_.size());
+}
+
+auto Link::wait_until_ready(std::chrono::milliseconds wait) -> void {
+  std::unique_lock<std::mutex> lock(units_mutex_);
+  units_changed_.wait_for(lock, wait, [this]() { return !units_.empty(); });
+}
+
+auto Link::request(uint8_t unit, uint8_t command, uint8_t param_count,
+                   const std::vector<uint8_t>& params,
+                   const std::vector<uint8_t>& payload) -> Reply {
+  Reply result;
+  std::shared_ptr<Connection> connection;
+  uint8_t device_id = 0;
+  {
+    std::lock_guard<std::mutex> lock(units_mutex_);
+    if (unit == 0 || unit > units_.size()) {
+      return result;
+    }
+    connection = units_[unit - 1].connection;
+    device_id = units_[unit - 1].device_id;
+  }
+
+  const uint8_t seq = sequence_++;
+  std::vector<uint8_t> packet(header_size, 0);
+  packet[0] = seq;
+  packet[1] = command;
+  packet[2] = param_count;
+  packet[3] = device_id;
+  for (size_t i = 0; i < params.size() && i < max_params; ++i) {
+    packet[param_offset + i] = params[i];
+  }
+  packet.insert(packet.end(), payload.begin(), payload.end());
+
+  if (!connection->send(packet)) {
+    return result;
+  }
+  std::vector<uint8_t> reply;
+  if (!connection->wait(seq, timeout_, &reply) || reply.size() < 2) {
+    connection->forget(seq);
+    return result;
+  }
+  result.ok = true;
+  result.status = reply[1];
+  result.data.assign(reply.begin() + 2, reply.end());
+  return result;
+}
+
+}  // namespace fujinet
diff --git a/src/apple2/peripherals/smartport/FujiNetLink.h b/src/apple2/peripherals/smartport/FujiNetLink.h
new file mode 100644
index 00000000..86c977f4
--- /dev/null
+++ b/src/apple2/peripherals/smartport/FujiNetLink.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// The link between the FujiNet card and FujiNet-PC (the FujiNet firmware's
+// PC build for the Apple II), speaking the SmartPort-over-SLIP protocol of
+// the FujiNet project's devrelay library:
+//
+//   * the card listens on TCP; FujiNet-PC connects to it ([BOIP] host/port
+//     in fnconfig.ini, port 1985 by default);
+//   * every frame is SLIP encoded (END $C0, ESC $DB);
+//   * a request is an 11-byte header, sequence, command, parameter count,
+//     device id, 2 zero bytes, 5 parameter bytes, then any payload;
+//   * a reply is sequence, status, then any data.
+//
+// On connect the card sends INIT to device 1, 2, ... until a unit answers
+// END OF CHAIN, which tells it how many SmartPort units the FujiNet offers.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "apple2/peripherals/smartport/SmartPortTypes.h"
+
+namespace fujinet {
+
+using smartport::Reply;
+
+class Connection;
+
+class Link : public smartport::Backend {
+ public:
+  Link() = default;
+  ~Link() override;
+
+  // Starts listening; false (with the reason in error) when the port cannot
+  // be opened.
+  auto start(const std::string& address, uint16_t port,
+             std::chrono::seconds timeout, std::string* error) -> bool;
+  auto stop() -> void;
+
+  // SmartPort units on offer, numbered 1..count for the Apple.
+  auto unit_count() -> uint8_t override;
+  // Waits up to `wait` for at least one unit.
+  auto wait_until_ready(std::chrono::milliseconds wait) -> void override;
+
+  // Sends a request to the Apple's unit (1-based) and waits for the reply.
+  // params holds up to 5 bytes, placed after the 6-byte header.
+  auto request(uint8_t unit, uint8_t command, uint8_t param_count,
+               const std::vector<uint8_t>& params,
+               const std::vector<uint8_t>& payload) -> Reply override;
+
+  // Bumped whenever the set of units changes, so callers can drop caches.
+  auto generation() const -> uint32_t override { return generation_.load(); }
+
+ private:
+  struct Unit {
+    std::shared_ptr<Connection> connection;
+    uint8_t device_id = 0;  // the id FujiNet-PC knows the unit by
+  };
+
+  auto listen_loop() -> void;
+  auto adopt(int socket) -> void;
+  auto drop(const Connection* connection) -> void;
+
+  std::atomic<bool> running_{false};
+  std::thread listener_;
+  int server_ = -1;
+  std::chrono::seconds timeout_{5};
+
+  std::mutex units_mutex_;
+  std::condition_variable units_changed_;
+  std::vector<Unit> units_;
+  std::vector<std::shared_ptr<Connection>> connections_;
+  std::atomic<uint32_t> generation_{0};
+  std::atomic<uint8_t> sequence_{0};
+};
+
+}  // namespace fujinet

@@ -0,0 +1,183 @@
+; SmartPort card firmware for LinApple: the SmartPort card (local hard disk
+; and 3.5" images) and the FujiNet card (FujiNet-PC over TCP) share it.
+;
+; Assembled once per slot:  ca65 -D SLOT=n smartport.s && ld65 -t none ...
+; (gen_rom.sh does this for slots 1-7 and writes SmartPortRom.h).
+;
+; The card answers SmartPort and ProDOS block calls itself, from disk images
+; or from a FujiNet-PC over TCP. The 6502 side only tells the card a call is
+; being made and then
+; moves the reply into memory itself, so every write goes through the 6502's
+; own bank switching (main/aux, language card) exactly like a real card's.
+;
+; Card registers, $C080 + SLOT*16 + n:
+;   +0 W  start a call: $65 SmartPort, $66 ProDOS
+;   +1 W  stack pointer at the SmartPort entry (the card reads the caller's
+;         return address, command byte and command list from it)
+;   +2 R  A to return (0 = no error)
+;   +3 R  X to return
+;   +4 R  Y to return
+;   +5 R  bytes to copy to memory, low
+;   +6 R  bytes to copy to memory, high (whole pages)
+;   +7 R  copy destination, low
+;   +8 R  copy destination, high
+;   +9 R  next byte to copy
+
+.ifndef SLOT
+SLOT = 7
+.endif
+
+IO      = $C080 + SLOT * 16
+CN      = $C0 + SLOT
+SLOT16  = SLOT * 16
+
+cmd     := $42                  ; ProDOS driver parameters
+unit    := $43
+bufl    := $44
+bufh    := $45
+blockl  := $46
+blockh  := $47
+
+loc0    := $00
+loc1    := $01
+mslot   := $07F8
+
+cout    := $FDED
+setkbd  := $FE89
+setscr  := $FE93
+sloop   := $FABA                ; continue the Monitor's slot scan
+settxt  := $FB39
+home    := $FC58
+basic   := $E000
+
+        .org    CN * 256
+
+; SmartPort / ProDOS block device signature: $Cn01=$20 $Cn03=$00 $Cn05=$03
+; $Cn07=$00.
+header:
+        cpx     #$20
+        ldx     #$00
+        cpx     #$03
+        cpx     #$00
+
+; Boot: read block 0 into $0800 and run it, as a ProDOS boot block expects.
+boot:
+        stx     blockl
+        stx     blockh
+        stx     bufl
+        inx                     ; 1 = READ
+        stx     cmd
+        lda     #$08
+        sta     bufh
+        lda     #SLOT16         ; drive 1 of this slot
+        sta     unit
+        jsr     driver
+        bcs     noboot
+        lda     $0800           ; a ProDOS boot block starts with 1
+        cmp     #$01
+        bne     noboot
+        lda     $0801
+        beq     noboot
+        ldx     #SLOT16
+        jmp     $0801
+
+; Nothing to boot. During the Monitor's autostart scan ($00/$01 hold $Cn00
+; and MSLOT is this slot) go on to the next slot, as an empty drive would.
+noboot:
+        lda     loc0
+        bne     message
+        lda     loc1
+        cmp     #CN
+        bne     message
+        cmp     mslot
+        bne     message
+        jmp     sloop
+
+message:
+        jsr     setscr
+        jsr     setkbd
+        jsr     settxt
+        jsr     home
+        ldx     #0
+@print: lda     text,x
+        beq     @done
+        jsr     cout
+        inx
+        bne     @print
+@done:  jmp     basic
+
+text:   .byte   $CE,$CF,$A0,$C4,$C5,$D6,$C9,$C3,$C5  ; "NO DEVICE"
+        .byte   $8D, 0
+
+; ProDOS entry. SmartPort is three bytes on, as the protocol requires.
+driver:
+        sec
+        bcs     prodos
+
+smartport:
+        tsx
+        stx     IO+1
+        lda     #$65
+        sta     IO+0
+        jsr     copy
+        pla                     ; step over the command byte and list
+        clc                     ; pointer that follow the caller's JSR
+        adc     #3
+        tax
+        pla
+        adc     #0
+        pha
+        txa
+        pha
+        jmp     finish
+
+prodos:
+        lda     #$66
+        sta     IO+0
+        jsr     copy
+
+finish:
+        ldx     IO+3
+        ldy     IO+4
+        lda     IO+2
+        cmp     #$01            ; carry set when A holds an error
+        rts
+
+; Move the card's reply into memory, through $44/$45, which are put back.
+copy:
+        lda     bufl
+        pha
+        lda     bufh
+        pha
+        lda     IO+7
+        sta     bufl
+        lda     IO+8
+        sta     bufh
+        ldy     #0
+        ldx     IO+6
+        beq     @part
+@page:  lda     IO+9
+        sta     (bufl),y
+        iny
+        bne     @page
+        inc     bufh
+        dex
+        bne     @page
+@part:  ldx     IO+5
+        beq     @done
+@byte:  lda     IO+9
+        sta     (bufl),y
+        iny
+        dex
+        bne     @byte
+@done:  pla
+        sta     bufh
+        pla
+        sta     bufl
+        rts
+
+        .res    $FC - <*, $00
+
+        .word   $0000           ; block count: ask with STATUS
+        .byte   $F7             ; ProDOS status bits
+        .byte   <driver         ; ProDOS entry point

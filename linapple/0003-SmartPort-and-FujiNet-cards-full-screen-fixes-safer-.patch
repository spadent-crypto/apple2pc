diff --git a/src/apple2/peripherals/smartport/SmartPortTypes.h b/src/apple2/peripherals/smartport/SmartPortTypes.h
new file mode 100644
index 00000000..1d90e915
--- /dev/null
+++ b/src/apple2/peripherals/smartport/SmartPortTypes.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// What the SmartPort card asks of whatever holds its units: disk images on
+// the host (LocalDisks) or a FujiNet-PC over TCP (FujiNetLink). Both answer
+// in SmartPort's own terms, a status byte and the reply's data bytes, so the
+// card's 6502-facing side is the same for either.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <vector>
+
+namespace smartport {
+
+enum Command : uint8_t {
+  cmd_status = 0,
+  cmd_read_block = 1,
+  cmd_write_block = 2,
+  cmd_format = 3,
+  cmd_control = 4,
+  cmd_init = 5,
+  cmd_open = 6,
+  cmd_close = 7,
+  cmd_read = 8,
+  cmd_write = 9,
+};
+
+// SmartPort error codes (Apple IIc Technical Reference, SmartPort chapter).
+enum Error : uint8_t {
+  err_none = 0x00,
+  err_bad_command = 0x01,
+  err_bad_param_count = 0x04,
+  err_bus = 0x06,
+  err_bad_unit = 0x11,
+  err_bad_status_code = 0x21,
+  err_bad_control_code = 0x21,
+  err_io = 0x27,
+  err_no_drive = 0x28,
+  err_write_protected = 0x2B,
+  err_bad_block = 0x2D,
+  err_offline = 0x2F,
+};
+
+struct Reply {
+  bool ok = false;     // the request was answered at all
+  uint8_t status = 0;  // SmartPort status, 0 = no error
+  std::vector<uint8_t> data;
+};
+
+class Backend {
+ public:
+  Backend() = default;
+  virtual ~Backend() = default;
+  Backend(const Backend&) = delete;
+  auto operator=(const Backend&) -> Backend& = delete;
+
+  // Units 1..unit_count() exist.
+  virtual auto unit_count() -> uint8_t = 0;
+  // Bumped whenever units come or go, or media changes.
+  virtual auto generation() const -> uint32_t = 0;
+  // Gives a backend that starts after the Apple a chance to come up.
+  virtual auto wait_until_ready(std::chrono::milliseconds wait) -> void {
+    (void)wait;
+  }
+  // One SmartPort call to a unit. params holds the call's parameter bytes
+  // after the buffer pointer (up to 5); payload the bytes it sends.
+  virtual auto request(uint8_t unit, uint8_t command, uint8_t param_count,
+                       const std::vector<uint8_t>& params,
+                       const std::vector<uint8_t>& payload) -> Reply = 0;
+};
+
+}  // namespace smartport

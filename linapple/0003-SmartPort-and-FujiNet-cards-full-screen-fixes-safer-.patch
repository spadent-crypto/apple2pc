+// A 400K or 800K ProDOS image is a 3.5" disk: with a SmartPort card
+// installed it goes into the card's UniDisk 3.5 drive of the same number
+// (units 3 and 4) instead of the Disk II.
+constexpr uint64_t bytes_400k = 409600;
+constexpr uint64_t bytes_800k = 819200;
+
+auto is_35_image(const std::string& path) -> bool {
+  struct stat st {};
+  if (stat(path.c_str(), &st) != 0) {
+    return false;
+  }
+  const auto size = static_cast<uint64_t>(st.st_size);
+  if (size == bytes_400k || size == bytes_800k) {
+    return true;
+  }
+  FILE* f = std::fopen(path.c_str(), "rb");
+  if (f == nullptr) {
+    return false;
+  }
+  uint8_t header[32] = {};
+  const size_t got = std::fread(header, 1, sizeof(header), f);
+  std::fclose(f);
+  if (got == sizeof(header) && std::memcmp(header, "2IMG", 4) == 0) {
+    const uint32_t length = static_cast<uint32_t>(header[28]) |
+                            (static_cast<uint32_t>(header[29]) << 8) |
+                            (static_cast<uint32_t>(header[30]) << 16) |
+                            (static_cast<uint32_t>(header[31]) << 24);
+    return length == bytes_400k || length == bytes_800k;
+  }
+  return false;
+}
+
+auto smartport_slot() -> int {
+  return peripheral_slot_of("linapple.smartport");
+}
+
+auto insert_35(int drive, const std::string& path) -> bool {
+  const int slot = smartport_slot();
+  if (slot < 0 || !is_35_image(path)) {
+    return false;
+  }
+  HarddiskInsertCmd cmd{};
+  cmd.drive = static_cast<uint8_t>(2 + drive);
+  util_safe_strcpy(cmd.path, path.c_str(), sizeof(cmd.path));
+  return peripheral_command(slot, harddisk_cmd_insert, &cmd, sizeof(cmd)) ==
+         peripheral_ok;
+}
+
+}  // namespace
+
+auto smartport_eject_35(int drive) -> void {
+  const int slot = smartport_slot();
+  if (slot < 0 || drive < 0 || drive > 1) {
+    return;
+  }
+  HarddiskEjectCmd cmd{};
+  cmd.drive = static_cast<uint8_t>(2 + drive);
+  peripheral_command(slot, harddisk_cmd_eject, &cmd, sizeof(cmd));
+}

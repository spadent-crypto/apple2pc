+// SPDX-License-Identifier: GPL-2.0-only
+#include "apple2/peripherals/smartport/LocalDisks.h"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+
+#include "apple2/media/image_container/ImageContainer.h"
+#include "apple2/peripherals/harddisk/HarddiskError.h"
+
+namespace smartport {
+
+namespace {
+
+constexpr size_t block_size = 512;
+constexpr uint32_t max_blocks = 65535;            // ProDOS: 32 MB
+constexpr size_t decompress_limit = 64U << 20;    // 64 MB uncompressed
+constexpr uint32_t blocks_400k = 800;
+constexpr uint32_t blocks_800k = 1600;
+constexpr size_t dib_name_len = 16;
+
+auto first_drive_index() -> int { return 2; }  // units 3 and 4: 3.5"
+
+auto is_35(int index) -> bool { return index >= first_drive_index(); }
+
+auto read_u16(const uint8_t* p) -> uint32_t { return p[0] | (p[1] << 8); }
+
+auto read_u32(const uint8_t* p) -> uint32_t {
+  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+         (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+
+auto base_name(const std::string& path) -> std::string {
+  const auto slash = path.find_last_of('/');
+  return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+auto lower(std::string s) -> std::string {
+  std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) {
+    return static_cast<char>(std::tolower(c));
+  });
+  return s;
+}
+
+}  // namespace
+
+LocalDisks::~LocalDisks() {
+  for (auto& unit : units_) {
+    close_unit(unit);
+  }
+}
+
+auto LocalDisks::close_unit(Unit& unit) -> void {
+  if (unit.fd >= 0) {
+    if (unit.dirty) {
+      fsync(unit.fd);
+    }
+    close(unit.fd);
+  }
+  if (unit.temporary && !unit.load_path.empty()) {
+    unlink(unit.load_path.c_str());
+  }
+  const int last_error = unit.last_error;
+  unit = Unit{};
+  unit.last_error = last_error;
+}
+
+auto LocalDisks::insert(int index, const std::string& path,
+                        bool write_protected) -> int {
+  if (index < 0 || index >= local_unit_count) {
+    return harddisk_err_io;
+  }
+  Unit& unit = units_[static_cast<size_t>(index)];
+  close_unit(unit);
+  ++generation_;
+
+  char load_path[1024] = {};
+  bool temporary = false;
+  if (image_container_prepare_compressed_path(path.c_str(), load_path,
+                                              sizeof(load_path),
+                                              decompress_limit,
+                                              &temporary) !=
+      image_container_ok) {
+    unit.last_error = harddisk_err_not_found;
+    return unit.last_error;
+  }
+
+  bool protect = write_protected || temporary;
+  int fd = protect ? -1 : open(load_path, O_RDWR);
+  if (fd < 0) {
+    fd = open(load_path, O_RDONLY);
+    protect = true;
+  }
+  if (fd < 0) {
+    if (temporary) {
+      unlink(load_path);
+    }
+    unit.last_error = harddisk_err_not_found;
+    return unit.last_error;
+  }
+
+  struct stat st {};
+  fstat(fd, &st);
+  uint64_t size = static_cast<uint64_t>(st.st_size);
+  uint64_t offset = 0;
+
+  uint8_t header[128] = {};
+  const ssize_t got = pread(fd, header, sizeof(header), 0);
+
+  int error = harddisk_err_none;
+  if (got >= 64 && std::memcmp(header, "2IMG", 4) == 0) {
+    const uint32_t format = read_u32(header + 12);
+    const uint32_t flags = read_u32(header + 16);
+    const uint32_t data_offset = read_u32(header + 24);
+    const uint32_t data_length = read_u32(header + 28);
+    if (format != 1 || data_offset < read_u16(header + 8) ||
+        static_cast<uint64_t>(data_offset) + data_length > size) {
+      error = format == 2 ? harddisk_err_not_block_image
+                          : harddisk_err_invalid_format;
+    } else {
+      offset = data_offset;
+      size = data_length;
+      if ((flags & 0x80000000U) != 0) {
+        protect = true;
+      }
+    }
+  } else if (got == static_cast<ssize_t>(sizeof(header))) {
+    const uint32_t wrapped = image_container_detect_macbinary(
+        header, sizeof(header),
+        static_cast<uint32_t>(std::min<uint64_t>(size, 0xFFFFFFFFULL)));
+    if (wrapped != 0) {
+      offset = image_container_macbinary_header_len;
+      size = wrapped;
+    }
+  }
+
+  const std::string ext = lower(path.substr(path.find_last_of('.') + 1));
+  if (error == harddisk_err_none &&
+      (ext == "nib" || ext == "woz" || ext == "nb2")) {
+    error = harddisk_err_not_block_image;
+  }
+  if (error == harddisk_err_none &&
+      (size == 0 || size % block_size != 0 ||
+       size / block_size > max_blocks)) {
+    error = harddisk_err_invalid_format;
+  }
+  if (error != harddisk_err_none) {
+    close(fd);
+    if (temporary) {
+      unlink(load_path);
+    }
+    unit.last_error = error;
+    return error;
+  }
+
+  unit.fd = fd;
+  unit.write_protected = protect;
+  unit.temporary = temporary;
+  unit.offset = offset;
+  unit.blocks = static_cast<uint32_t>(size / block_size);
+  unit.path = path;
+  unit.load_path = load_path;
+  unit.name = base_name(path);
+  unit.switched = true;
+  unit.last_error = harddisk_err_none;
+  return harddisk_err_none;
+}
+
+auto LocalDisks::eject(int index) -> void {
+  if (index < 0 || index >= local_unit_count) {
+    return;
+  }
+  close_unit(units_[static_cast<size_t>(index)]);
+  units_[static_cast<size_t>(index)].switched = true;
+  ++generation_;
+}
+
+auto LocalDisks::set_protect(int index, bool write_protected) -> void {
+  if (index < 0 || index >= local_unit_count) {
+    return;
+  }
+  Unit& unit = units_[static_cast<size_t>(index)];
+  if (unit.fd < 0) {
+    return;
+  }
+  if (!write_protected && !unit.temporary) {
+    const int fd = open(unit.load_path.c_str(), O_RDWR);
+    if (fd < 0) {
+      return;  // stays protected: the file is read-only
+    }
+    close(unit.fd);
+    unit.fd = fd;
+  }
+  unit.write_protected = write_protected || unit.temporary;
+}
+
+auto LocalDisks::info(int index) const -> LocalUnitInfo {
+  LocalUnitInfo out;
+  if (index < 0 || index >= local_unit_count) {
+    return out;
+  }
+  const Unit& unit = units_[static_cast<size_t>(index)];
+  out.loaded = unit.fd >= 0;
+  out.write_protected = unit.write_protected;
+  out.path = unit.path;
+  out.name = unit.name;
+  out.last_error = unit.last_error;
+  return out;
+}
+
+auto LocalDisks::flush() -> void {
+  for (auto& unit : units_) {
+    if (unit.fd >= 0 && unit.dirty) {
+      fdatasync(unit.fd);
+      unit.dirty = false;
+    }
+  }
+  last_sync_ = std::chrono::steady_clock::now();
+}
+
+// Bit 7 block device, 6 write allowed, 5 read allowed, 4 online,
+// 3 format allowed, 2 write protected, 0 disk switched.
+auto LocalDisks::status_byte(int index) const -> uint8_t {
+  const Unit& unit = units_[static_cast<size_t>(index)];
+  uint8_t s = 0x80 | 0x20 | 0x08;
+  if (unit.fd >= 0) {
+    s |= 0x10;
+    s |= unit.write_protected ? 0x04 : 0x40;
+  } else if (!is_35(index)) {
+    s |= 0x40;
+  }
+  if (unit.switched && is_35(index)) {
+    s |= 0x01;
+  }
+  return s;
+}
+
+auto LocalDisks::dib(int index) const -> std::vector<uint8_t> {
+  const Unit& unit = units_[static_cast<size_t>(index)];
+  std::vector<uint8_t> d;
+  d.push_back(status_byte(index));
+  d.push_back(static_cast<uint8_t>(unit.blocks & 0xFF));
+  d.push_back(static_cast<uint8_t>((unit.blocks >> 8) & 0xFF));
+  d.push_back(static_cast<uint8_t>((unit.blocks >> 16) & 0xFF));
+  const char* name = is_35(index) ? "UNIDISK 3.5" : "SMARTPORT HD";
+  const size_t len = std::strlen(name);
+  d.push_back(static_cast<uint8_t>(len));
+  for (size_t i = 0; i < dib_name_len; ++i) {
+    d.push_back(static_cast<uint8_t>(i < len ? name[i] : ' '));
+  }
+  d.push_back(is_35(index) ? 0x01 : 0x02);  // type: 3.5" disk / hard disk
+  d.push_back(is_35(index) ? 0x00 : 0x20);  // subtype: removable / fixed
+  d.push_back(0x00);                        // firmware version $0100
+  d.push_back(0x01);
+  return d;
+}
+
+auto LocalDisks::request(uint8_t unit_number, uint8_t command,
+                         uint8_t param_count,
+                         const std::vector<uint8_t>& params,
+                         const std::vector<uint8_t>& payload) -> Reply {
+  (void)param_count;
+  Reply reply;
+  reply.ok = true;
+  if (unit_number == 0 || unit_number > local_unit_count) {
+    reply.status = err_bad_unit;
+    return reply;
+  }
+  const int index = unit_number - 1;
+  Unit& unit = units_[static_cast<size_t>(index)];
+  auto param = [&](size_t i) -> uint32_t {
+    return i < params.size() ? params[i] : 0;
+  };
+  const uint32_t block = param(0) | (param(1) << 8) | (param(2) << 16);
+
+  switch (command) {
+    case cmd_status:
+      switch (param(0)) {
+        case 0:
+          reply.data = dib(index);
+          reply.data.resize(4);
+          unit.switched = false;
+          return reply;
+        case 3:
+          reply.data = dib(index);
+          unit.switched = false;
+          return reply;
+        default:
+          reply.status = err_bad_status_code;
+          return reply;
+      }
+    case cmd_read_block: {
+      if (unit.fd < 0) {
+        reply.status = err_offline;
+        return reply;
+      }
+      if (block >= unit.blocks) {
+        reply.status = err_bad_block;
+        return reply;
+      }
+      reply.data.resize(block_size);
+      const ssize_t n =
+          pread(unit.fd, reply.data.data(), block_size,
+                static_cast<off_t>(unit.offset + uint64_t{block} * block_size));
+      if (n != static_cast<ssize_t>(block_size)) {
+        reply.data.clear();
+        reply.status = err_io;
+        return reply;
+      }
+      activity_ |= 0x01;
+      return reply;
+    }
+    case cmd_write_block: {
+      if (unit.fd < 0) {
+        reply.status = err_offline;
+        return reply;
+      }
+      if (unit.write_protected) {
+        reply.status = err_write_protected;
+        return reply;
+      }
+      if (block >= unit.blocks || payload.size() < block_size) {
+        reply.status = err_bad_block;
+        return reply;
+      }
+      const ssize_t n =
+          pwrite(unit.fd, payload.data(), block_size,
+                 static_cast<off_t>(unit.offset + uint64_t{block} * block_size));
+      if (n != static_cast<ssize_t>(block_size)) {
+        reply.status = err_io;
+        return reply;
+      }
+      unit.dirty = true;
+      activity_ |= 0x02;
+      // A machine like this one is often just switched off: write through
+      // to the disk at most a second after the last write.
+      const auto now = std::chrono::steady_clock::now();
+      if (now - last_sync_ > std::chrono::seconds(1)) {
+        flush();
+      }
+      return reply;
+    }
+    case cmd_format:
+      if (unit.fd < 0) {
+        reply.status = err_offline;
+      } else if (unit.write_protected) {
+        reply.status = err_write_protected;
+      }
+      return reply;
+    case cmd_control:
+      reply.status = param(0) == 0 ? err_none : err_bad_control_code;
+      return reply;
+    case cmd_init:
+      return reply;
+    default:  // OPEN, CLOSE, READ, WRITE: character devices only
+      reply.status = err_bad_command;
+      return reply;
+  }
+}
+
+}  // namespace smartport
diff --git a/src/apple2/peripherals/smartport/LocalDisks.h b/src/apple2/peripherals/smartport/LocalDisks.h
new file mode 100644
index 00000000..00b3865b
--- /dev/null
+++ b/src/apple2/peripherals/smartport/LocalDisks.h
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Disk images on the host as SmartPort units: two hard disks and two 3.5"
+// drives, the way a SmartPort controller with a hard disk and a UniDisk 3.5
+// chained to it presents them.
+//
+//   unit 1, 2  hard disk  (DIB type $02, non-removable), any size to 32 MB
+//   unit 3, 4  3.5" drive (DIB type $01, removable, "UNIDISK 3.5"),
+//              400K or 800K ProDOS-order images
+//
+// Images: ProDOS-order block images (.po .hdv .img .raw and the like), 2MG
+// with ProDOS order, MacBinary-wrapped images, and any of these inside
+// .zip or .gz (which mount read-only).
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+#include "apple2/peripherals/smartport/SmartPortTypes.h"
+
+namespace smartport {
+
+constexpr int local_unit_count = 4;
+
+struct LocalUnitInfo {
+  bool loaded = false;
+  bool write_protected = false;
+  std::string path;  // as given, for the configuration
+  std::string name;  // file name shown to the user
+  int last_error = 0;
+};
+
+class LocalDisks : public Backend {
+ public:
+  LocalDisks() = default;
+  ~LocalDisks() override;
+
+  auto unit_count() -> uint8_t override { return local_unit_count; }
+  auto generation() const -> uint32_t override { return generation_; }
+  auto request(uint8_t unit, uint8_t command, uint8_t param_count,
+               const std::vector<uint8_t>& params,
+               const std::vector<uint8_t>& payload) -> Reply override;
+
+  // index 0..3 = unit 1..4. Returns a harddisk_err_* code (0 = mounted).
+  auto insert(int index, const std::string& path, bool write_protected)
+      -> int;
+  auto eject(int index) -> void;
+  auto set_protect(int index, bool write_protected) -> void;
+  auto info(int index) const -> LocalUnitInfo;
+  // Set while a unit is read or written, for the drive lamps.
+  auto activity() const -> uint8_t { return activity_; }
+  auto clear_activity() -> void { activity_ = 0; }
+  auto flush() -> void;
+
+ private:
+  struct Unit {
+    int fd = -1;
+    bool write_protected = false;
+    bool switched = false;
+    bool temporary = false;
+    uint64_t offset = 0;   // where block 0 starts in the file
+    uint32_t blocks = 0;
+    std::string path;
+    std::string load_path;
+    std::string name;
+    int last_error = 0;
+    bool dirty = false;
+  };
+
+  auto close_unit(Unit& unit) -> void;
+  auto dib(int index) const -> std::vector<uint8_t>;
+  auto status_byte(int index) const -> uint8_t;
+
+  std::array<Unit, local_unit_count> units_{};
+  uint32_t generation_ = 0;
+  uint8_t activity_ = 0;
+  std::chrono::steady_clock::time_point last_sync_{};
+};
+
+}  // namespace smartport
diff --git a/src/apple2/peripherals/smartport/SmartPortCard.cpp b/src/apple2/peripherals/smartport/SmartPortCard.cpp
new file mode 100644
index 00000000..bb5f3256
--- /dev/null
+++ b/src/apple2/peripherals/smartport/SmartPortCard.cpp
@@ -0,0 +1,764 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// SmartPort cards: a SmartPort and ProDOS block-device interface whose units
+// are either disk images on the host or the units of a FujiNet.
+//
+//   "SmartPort"  two hard disks and two UniDisk 3.5 drives from images
+//                (LocalDisks); drives 1-2 take the hard disk commands, so
+//                the frontend's hard disk keys and configuration serve it.
+//   "FujiNet"    the units of a FujiNet-PC (the FujiNet firmware built for
+//                the PC, Apple II target) over TCP with SmartPort-over-SLIP
+//                (FujiNetLink): FujiNet CONFIG, its disk slots, the network
+//                (N:) device and printer, as behind a real FujiNet.
+//
+// The FujiNet side follows the SmartPortOverSlip card of the FujiNet project's AppleWin
+// fork (Copyright (C) 2022 Andrea Odetti and the FujiNet contributors,
+// GPL-2.0-or-later). The firmware is new: it moves every reply into memory
+// with 6502 stores, so the card never writes the Apple's memory behind the
+// back of its bank switching, and the card needs no access to the CPU's
+// registers.
+#include "apple2/peripherals/smartport/SmartPortCard.h"
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <new>
+#include <string>
+#include <vector>
+
+#include "apple2/peripherals/Peripheral.h"
+#include "apple2/peripherals/Peripheral_Types.h"
+#include "apple2/peripherals/harddisk/HarddiskCommands.h"
+#include "apple2/peripherals/harddisk/HarddiskError.h"
+#include "apple2/peripherals/smartport/FujiNetLink.h"
+#include "apple2/peripherals/smartport/LocalDisks.h"
+#include "apple2/peripherals/smartport/SmartPortRom.h"
+
+namespace {
+
+constexpr const char* config_section = "FujiNet";
+constexpr const char* default_address = "127.0.0.1";
+constexpr uint16_t default_port = 1985;
+constexpr int default_timeout_s = 5;
+constexpr int default_boot_wait_s = 15;
+
+constexpr uint8_t trigger_smartport = 0x65;
+constexpr uint8_t trigger_prodos = 0x66;
+
+// Registers, offset from $C080 + slot * 16.
+constexpr uint8_t reg_start = 0;
+constexpr uint8_t reg_stack = 1;
+constexpr uint8_t reg_a = 2;
+constexpr uint8_t reg_x = 3;
+constexpr uint8_t reg_y = 4;
+constexpr uint8_t reg_count_lo = 5;
+constexpr uint8_t reg_count_hi = 6;
+constexpr uint8_t reg_dest_lo = 7;
+constexpr uint8_t reg_dest_hi = 8;
+constexpr uint8_t reg_data = 9;
+
+using smartport::err_bad_command;
+using smartport::err_io;
+using smartport::err_none;
+constexpr uint8_t err_no_device = smartport::err_no_drive;
+
+constexpr size_t block_size = 512;
+constexpr size_t dib_type = 21;
+
+struct Card {
+  HostInterface* host = nullptr;
+  int slot = 0;
+  std::unique_ptr<smartport::Backend> backend;
+  smartport::LocalDisks* disks = nullptr;  // the SmartPort card's
+  fujinet::Link* link = nullptr;           // the FujiNet card's
+  std::chrono::milliseconds boot_wait{0};
+  bool waited = false;
+
+  // Results of the last call, read back by the firmware.
+  uint8_t stack = 0;
+  uint8_t a = 0;
+  uint8_t x = 0;
+  uint8_t y = 0;
+  uint16_t dest = 0;
+  std::vector<uint8_t> copy;
+  size_t copied = 0;
+
+  // ProDOS drives 1 and 2: SmartPort units that are disks, 0 = none.
+  std::array<uint8_t, 2> drives{};
+  uint32_t drives_generation = 0;
+  bool drives_known = false;
+};
+
+auto peek(const Card* card, uint16_t addr) -> uint8_t {
+  return *card->host->get_mem_ptr(addr);
+}
+
+auto peek16(const Card* card, uint16_t addr) -> uint16_t {
+  return static_cast<uint16_t>(peek(card, addr) |
+                               (peek(card, static_cast<uint16_t>(addr + 1))
+                                << 8));
+}
+
+auto read_block_of_memory(const Card* card, uint16_t addr, size_t n)
+    -> std::vector<uint8_t> {
+  std::vector<uint8_t> out(n);
+  for (size_t i = 0; i < n; ++i) {
+    out[i] = peek(card, static_cast<uint16_t>(addr + i));
+  }
+  return out;
+}
+
+auto result(Card* card, uint8_t a, uint8_t x = 0, uint8_t y = 0)
+    -> void {
+  card->a = a;
+  card->x = x;
+  card->y = y;
+}
+
+auto deliver(Card* card, uint16_t dest, std::vector<uint8_t> data)
+    -> void {
+  card->dest = dest;
+  card->copy = std::move(data);
+}
+
+// The first call waits for FujiNet-PC, which starts with the machine and
+// may connect a moment after the Apple begins its boot scan.
+auto ensure_connected(Card* card) -> void {
+  if (card->waited) {
+    return;
+  }
+  card->waited = true;
+  if (card->backend->unit_count() == 0 && card->boot_wait.count() > 0) {
+    card->backend->wait_until_ready(card->boot_wait);
+  }
+}
+
+auto reply_error(const smartport::Reply& reply) -> uint8_t {
+  return reply.ok ? reply.status : static_cast<uint8_t>(err_io);
+}
+
+// --- SmartPort --------------------------------------------------------------
+
+auto smartport_call(Card* card) -> void {
+  const uint16_t ret =
+      static_cast<uint16_t>(peek(card, 0x100 | ((card->stack + 1) & 0xFF)) |
+                            (peek(card, 0x100 | ((card->stack + 2) & 0xFF))
+                             << 8));
+  const uint8_t command = peek(card, static_cast<uint16_t>(ret + 1));
+  const uint16_t list = peek16(card, static_cast<uint16_t>(ret + 2));
+
+  if (command >= 0x40) {  // extended (4-byte address) calls
+    result(card, err_bad_command);
+    return;
+  }
+
+  const uint8_t param_count = peek(card, list);
+  const uint8_t unit = peek(card, static_cast<uint16_t>(list + 1));
+  const uint16_t buffer = peek16(card, static_cast<uint16_t>(list + 2));
+  const uint16_t params = static_cast<uint16_t>(list + 4);
+  auto param = [&](int i) {
+    return peek(card, static_cast<uint16_t>(params + i));
+  };
+
+  ensure_connected(card);
+
+  // STATUS of unit 0, code 0: the card itself.
+  if (command == smartport::cmd_status && unit == 0) {
+    if (param(0) != 0) {
+      result(card, 0x21);  // bad status code
+      return;
+    }
+    std::vector<uint8_t> info = {
+        card->backend->unit_count(),
+        0x40,        // no interrupt
+        0x4D, 0x46,  // vendor "MF", as FujiNet's own cards report
+        0x0A, 0x10,  // interface version 1.00 alpha
+        0x00, 0x00,
+    };
+    deliver(card, buffer, info);
+    result(card, err_none, static_cast<uint8_t>(info.size()), 0);
+    return;
+  }
+
+  if (unit == 0 || unit > card->backend->unit_count()) {
+    result(card, err_no_device);
+    return;
+  }
+
+  smartport::Reply reply;
+  switch (command) {
+    case smartport::cmd_status: {
+      const uint8_t code = param(0);
+      const uint8_t net_unit = param_count > 3 ? param(1) : 0;
+      reply = card->backend->request(unit, command, param_count, {code, net_unit},
+                                 {});
+      if (reply.ok && reply.status == 0) {
+        const size_t n = reply.data.size();
+        deliver(card, buffer, reply.data);
+        result(card, err_none, static_cast<uint8_t>(n & 0xFF),
+               static_cast<uint8_t>(n >> 8));
+        return;
+      }
+      break;
+    }
+    case smartport::cmd_read_block: {
+      reply = card->backend->request(unit, command, param_count,
+                                 {param(0), param(1), param(2)}, {});
+      if (reply.ok && reply.status == 0 &&
+          reply.data.size() >= block_size) {
+        reply.data.resize(block_size);
+        deliver(card, buffer, reply.data);
+        result(card, err_none, 0, 2);
+        return;
+      }
+      if (reply.ok && reply.status == 0) {
+        reply.ok = false;  // short block: report an I/O error
+      }
+      break;
+    }
+    case smartport::cmd_write_block:
+      reply = card->backend->request(unit, command, param_count,
+                                 {param(0), param(1), param(2)},
+                                 read_block_of_memory(card, buffer,
+                                                      block_size));
+      break;
+    case smartport::cmd_control: {
+      const uint8_t code = param(0);
+      const uint8_t net_unit = param_count > 3 ? param(1) : 0;
+      // The control list: a 2-byte length, then that many bytes.
+      const size_t length = peek16(card, buffer) + 2U;
+      reply = card->backend->request(unit, command, param_count, {code, net_unit},
+                                 read_block_of_memory(card, buffer, length));
+      break;
+    }
+    case smartport::cmd_read: {
+      const std::vector<uint8_t> count_and_address = {
+          param(0), param(1), param(2), param(3), param(4)};
+      reply = card->backend->request(unit, command, param_count,
+                                 count_and_address, {});
+      if (reply.ok && reply.status == 0) {
+        const size_t n = reply.data.size();
+        deliver(card, buffer, reply.data);
+        result(card, err_none, static_cast<uint8_t>(n & 0xFF),
+               static_cast<uint8_t>(n >> 8));
+        return;
+      }
+      break;
+    }
+    case smartport::cmd_write: {
+      const size_t count = static_cast<size_t>(param(0) | (param(1) << 8));
+      reply = card->backend->request(
+          unit, command, param_count,
+          {param(0), param(1), param(2), param(3), param(4)},
+          read_block_of_memory(card, buffer, count));
+      break;
+    }
+    case smartport::cmd_format:
+    case smartport::cmd_init:
+    case smartport::cmd_open:
+    case smartport::cmd_close:
+      reply = card->backend->request(unit, command, param_count, {}, {});
+      break;
+    default:
+      result(card, err_bad_command);
+      return;
+  }
+  result(card, reply_error(reply));
+}
+
+// --- ProDOS -----------------------------------------------------------------
+
+// Drives 1 and 2 are the first two SmartPort units that are disks, online,
+// as the AppleWin card picks them.
+auto find_drives(Card* card) -> void {
+  card->drives = {0, 0};
+  size_t found = 0;
+  const uint8_t count = card->backend->unit_count();
+  for (uint8_t unit = 1; unit <= count && found < 2; ++unit) {
+    const smartport::Reply dib =
+        card->backend->request(unit, smartport::cmd_status, 3, {3, 0}, {});
+    if (!dib.ok || dib.status != 0 || dib.data.size() <= dib_type) {
+      continue;
+    }
+    const uint8_t type = dib.data[dib_type];
+    const bool disk = type == 0x01 || type == 0x02 || type == 0x0A;
+    const bool online = (dib.data[0] & 0x10) != 0;
+    if (disk && online) {
+      card->drives[found++] = unit;
+    }
+  }
+  card->drives_generation = card->backend->generation();
+  card->drives_known = true;
+}
+
+auto prodos_call(Card* card) -> void {
+  const uint8_t command = peek(card, 0x42);
+  const uint8_t unit_byte = peek(card, 0x43);
+  const uint16_t buffer = peek16(card, 0x44);
+  const uint8_t block_lo = peek(card, 0x46);
+  const uint8_t block_hi = peek(card, 0x47);
+
+  if (((unit_byte >> 4) & 0x07) != card->slot) {
+    result(card, err_no_device);
+    return;
+  }
+  ensure_connected(card);
+
+  if (command == 0 || !card->drives_known ||
+      card->drives_generation != card->backend->generation()) {
+    find_drives(card);
+  }
+  const uint8_t unit = card->drives[(unit_byte & 0x80) != 0 ? 1 : 0];
+  if (unit == 0) {
+    result(card, err_io);  // no disk yet; ProDOS asks again later
+    return;
+  }
+
+  switch (command) {
+    case 0: {  // STATUS: blocks on the device in X/Y
+      const smartport::Reply reply =
+          card->backend->request(unit, smartport::cmd_status, 3, {0, 0}, {});
+      if (reply.ok && reply.status == 0 && reply.data.size() >= 3 &&
+          (reply.data[0] & 0x70) == 0x70) {
+        result(card, err_none, reply.data[1], reply.data[2]);
+      } else {
+        result(card, err_io);
+      }
+      return;
+    }
+    case 1: {  // READ
+      smartport::Reply reply = card->backend->request(
+          unit, smartport::cmd_read_block, 3, {block_lo, block_hi, 0}, {});
+      if (reply.ok && reply.status == 0 &&
+          reply.data.size() >= block_size) {
+        reply.data.resize(block_size);
+        deliver(card, buffer, reply.data);
+        result(card, err_none, 0, 2);
+      } else {
+        result(card, err_io);
+      }
+      return;
+    }
+    case 2: {  // WRITE
+      const smartport::Reply reply = card->backend->request(
+          unit, smartport::cmd_write_block, 3, {block_lo, block_hi, 0},
+          read_block_of_memory(card, buffer, block_size));
+      if (reply.ok && reply.status != 0) {
+        result(card, reply.status);
+      } else {
+        result(card, reply.ok ? err_none : err_io);
+      }
+      return;
+    }
+    case 3: {  // FORMAT
+      const smartport::Reply reply =
+          card->backend->request(unit, smartport::cmd_format, 1, {}, {});
+      result(card, reply.ok && reply.status == 0 ? err_none : err_io);
+      return;
+    }
+    default:
+      result(card, err_no_device);
+      return;
+  }
+}
+
+// --- I/O --------------------------------------------------------------------
+
+auto smartport_io_write(void* instance, uint16_t pc, uint16_t addr,
+                      uint8_t is_write, uint8_t value, uint32_t cycles)
+    -> uint8_t {
+  (void)pc;
+  (void)is_write;
+  (void)cycles;
+  auto* card = static_cast<Card*>(instance);
+  if (card == nullptr) {
+    return 0;
+  }
+  switch (addr & 0x0F) {
+    case reg_stack:
+      card->stack = value;
+      break;
+    case reg_start:
+      card->copy.clear();
+      card->copied = 0;
+      card->dest = 0;
+      result(card, err_io);
+      if (value == trigger_smartport) {
+        smartport_call(card);
+      } else if (value == trigger_prodos) {
+        prodos_call(card);
+      }
+      break;
+    default:
+      break;
+  }
+  return 0;
+}
+
+auto smartport_io_read(void* instance, uint16_t pc, uint16_t addr,
+                     uint8_t is_write, uint8_t value, uint32_t cycles)
+    -> uint8_t {
+  (void)pc;
+  (void)is_write;
+  (void)value;
+  auto* card = static_cast<Card*>(instance);
+  if (card == nullptr) {
+    return 0;
+  }
+  switch (addr & 0x0F) {
+    case reg_a:
+      return card->a;
+    case reg_x:
+      return card->x;
+    case reg_y:
+      return card->y;
+    case reg_count_lo:
+      return static_cast<uint8_t>(card->copy.size() & 0xFF);
+    case reg_count_hi:
+      return static_cast<uint8_t>((card->copy.size() >> 8) & 0xFF);
+    case reg_dest_lo:
+      return static_cast<uint8_t>(card->dest & 0xFF);
+    case reg_dest_hi:
+      return static_cast<uint8_t>(card->dest >> 8);
+    case reg_data:
+      return card->copied < card->copy.size() ? card->copy[card->copied++]
+                                              : 0;
+    default:
+      return card->host->ReadFloatingBus != nullptr
+                 ? card->host->ReadFloatingBus(cycles)
+                 : 0;
+  }
+}
+
+auto config_string(HostInterface* host, const char* section, const char* key,
+                   const char* fallback) -> std::string {
+  char buffer[128] = {};
+  if (host->GetConfig != nullptr &&
+      host->GetConfig(section, key, buffer, sizeof(buffer)) &&
+      buffer[0] != '\0') {
+    return buffer;
+  }
+  return fallback;
+}
+
+auto config_int(HostInterface* host, const char* key, int fallback) -> int {
+  const std::string value = config_string(host, config_section, key, "");
+  if (value.empty()) {
+    return fallback;
+  }
+  char* end = nullptr;
+  const long n = std::strtol(value.c_str(), &end, 10);
+  return (end != value.c_str()) ? static_cast<int>(n) : fallback;
+}
+
+
+auto new_card(int slot, HostInterface* host) -> std::unique_ptr<Card> {
+  if (host == nullptr || host->RegisterIO == nullptr ||
+      host->RegisterCxROM == nullptr || host->get_mem_ptr == nullptr ||
+      slot < 1 || slot > 7) {
+    return nullptr;
+  }
+  std::unique_ptr<Card> card(new (std::nothrow) Card());
+  if (card) {
+    card->host = host;
+    card->slot = slot;
+  }
+  return card;
+}
+
+auto install(Card* card) -> void {
+  card->host->RegisterCxROM(card->slot, smartport_rom[card->slot - 1]);
+  card->host->RegisterIO(card->slot, smartport_io_read, smartport_io_write,
+                         nullptr, nullptr);
+}
+
+// --- FujiNet card -------------------------------------------------------------
+
+auto fujinet_init(int slot, HostInterface* host) -> void* {
+  std::unique_ptr<Card> card = new_card(slot, host);
+  if (!card) {
+    return nullptr;
+  }
+  std::unique_ptr<fujinet::Link> link(new (std::nothrow) fujinet::Link());
+  if (!link) {
+    return nullptr;
+  }
+
+  const std::string address =
+      config_string(host, config_section, "Listen Address", default_address);
+  int port = config_int(host, "Port", default_port);
+  if (port <= 0 || port > 65535) {
+    port = default_port;
+  }
+  int timeout = config_int(host, "Response Timeout", default_timeout_s);
+  if (timeout <= 0) {
+    timeout = default_timeout_s;
+  }
+  int boot_wait = config_int(host, "Boot Wait", default_boot_wait_s);
+  if (boot_wait < 0) {
+    boot_wait = 0;
+  }
+  card->boot_wait = std::chrono::seconds(boot_wait);
+
+  std::string error;
+  if (!link->start(address, static_cast<uint16_t>(port),
+                   std::chrono::seconds(timeout), &error)) {
+    if (host->Log != nullptr) {
+      host->Log(nullptr, log_error,
+                "FujiNet card in slot %d: cannot listen on %s (%s)\n", slot,
+                address.c_str(), error.c_str());
+    }
+  } else if (host->Log != nullptr) {
+    host->Log(nullptr, log_info,
+              "FujiNet card in slot %d: waiting for FujiNet-PC on %s:%d\n",
+              slot, address.c_str(), port);
+  }
+
+  card->link = link.get();
+  card->backend = std::move(link);
+  install(card.get());
+  return card.release();
+}
+
+// --- SmartPort card -----------------------------------------------------------
+
+// Drives 3 and 4, the UniDisk 3.5 drives, keep their images under these
+// keys; drives 1 and 2 are the hard disk keys the frontend keeps.
+constexpr const char* drive_35_keys[2] = {"SmartPort 3.5 Image 1",
+                                          "SmartPort 3.5 Image 2"};
+constexpr const char* config_main_section = "Configuration";
+
+auto remember_35(Card* card, int index) -> void {
+  if (index < 2 || card->host->SetConfig == nullptr) {
+    return;
+  }
+  const smartport::LocalUnitInfo info = card->disks->info(index);
+  card->host->SetConfig(config_main_section, drive_35_keys[index - 2],
+                        info.loaded ? info.path.c_str() : "");
+}
+
+auto smartport_init(int slot, HostInterface* host) -> void* {
+  std::unique_ptr<Card> card = new_card(slot, host);
+  if (!card) {
+    return nullptr;
+  }
+  std::unique_ptr<smartport::LocalDisks> disks(new (std::nothrow)
+                                                   smartport::LocalDisks());
+  if (!disks) {
+    return nullptr;
+  }
+  for (int i = 0; i < 2; ++i) {
+    const std::string path =
+        config_string(host, config_main_section, drive_35_keys[i], "");
+    if (!path.empty() && disks->insert(2 + i, path, false) != 0 &&
+        host->Log != nullptr) {
+      host->Log(nullptr, log_warn, "SmartPort 3.5 drive %d: cannot mount %s\n",
+                i + 1, path.c_str());
+    }
+  }
+  card->disks = disks.get();
+  card->backend = std::move(disks);
+  install(card.get());
+  return card.release();
+}
+
+auto smartport_card_command(void* instance, uint32_t cmd_id, const void* data,
+                            size_t size) -> PeripheralStatus {
+  auto* card = static_cast<Card*>(instance);
+  if (card == nullptr || card->disks == nullptr || data == nullptr) {
+    return peripheral_error;
+  }
+  switch (cmd_id) {
+    case harddisk_cmd_insert: {
+      if (size < sizeof(HarddiskInsertCmd)) {
+        return peripheral_error;
+      }
+      HarddiskInsertCmd cmd{};
+      std::memcpy(&cmd, data, sizeof(cmd));
+      cmd.path[sizeof(cmd.path) - 1] = '\0';
+      if (cmd.drive >= smartport::local_unit_count) {
+        return peripheral_error;
+      }
+      card->disks->insert(cmd.drive, cmd.path, cmd.write_protected != 0);
+      remember_35(card, cmd.drive);
+      return peripheral_ok;
+    }
+    case harddisk_cmd_eject: {
+      if (size < sizeof(HarddiskEjectCmd)) {
+        return peripheral_error;
+      }
+      const auto* cmd = static_cast<const HarddiskEjectCmd*>(data);
+      if (cmd->drive >= smartport::local_unit_count) {
+        return peripheral_error;
+      }
+      card->disks->eject(cmd->drive);
+      remember_35(card, cmd->drive);
+      return peripheral_ok;
+    }
+    case harddisk_cmd_set_protect: {
+      if (size < sizeof(HarddiskSetProtectCmd)) {
+        return peripheral_error;
+      }
+      const auto* cmd = static_cast<const HarddiskSetProtectCmd*>(data);
+      if (cmd->drive >= smartport::local_unit_count) {
+        return peripheral_error;
+      }
+      card->disks->set_protect(cmd->drive, cmd->write_protected != 0);
+      return peripheral_ok;
+    }
+    default:
+      return peripheral_incompatible;
+  }
+}
+
+constexpr const char* local_extensions =
+    "po;hdv;2mg;2img;img;raw;zip;gz";
+
+auto smartport_card_query(void* instance, uint32_t query_id, void* out,
+                          size_t* size) -> PeripheralStatus {
+  if (size == nullptr) {
+    return peripheral_error;
+  }
+  if (query_id == harddisk_query_supported_extensions) {
+    const size_t needed = std::strlen(local_extensions) + 1;
+    if (out == nullptr || *size < needed) {
+      *size = needed;
+      return out == nullptr ? peripheral_ok : peripheral_error;
+    }
+    std::memcpy(out, local_extensions, needed);
+    *size = needed;
+    return peripheral_ok;
+  }
+  if (query_id != harddisk_query_status) {
+    return peripheral_incompatible;
+  }
+  if (out == nullptr) {
+    *size = sizeof(HarddiskStatus);
+    return peripheral_ok;
+  }
+  auto* card = static_cast<Card*>(instance);
+  if (card == nullptr || card->disks == nullptr ||
+      *size < sizeof(HarddiskStatus)) {
+    *size = sizeof(HarddiskStatus);
+    return peripheral_error;
+  }
+  HarddiskStatus status{};
+  const smartport::LocalUnitInfo d0 = card->disks->info(0);
+  const smartport::LocalUnitInfo d1 = card->disks->info(1);
+  status.drive0_last_error = d0.last_error;
+  status.drive1_last_error = d1.last_error;
+  status.drive0_loaded = d0.loaded ? 1 : 0;
+  status.drive1_loaded = d1.loaded ? 1 : 0;
+  status.drive0_write_protected = d0.write_protected ? 1 : 0;
+  status.drive1_write_protected = d1.write_protected ? 1 : 0;
+  const uint8_t activity = card->disks->activity();
+  status.activity_status =
+      static_cast<uint8_t>(((activity & 0x01) != 0 ? harddisk_status_read : 0) |
+                           ((activity & 0x02) != 0 ? harddisk_status_write : 0));
+  card->disks->clear_activity();
+  std::strncpy(status.drive0_name, d0.name.c_str(),
+               sizeof(status.drive0_name) - 1);
+  std::strncpy(status.drive1_name, d1.name.c_str(),
+               sizeof(status.drive1_name) - 1);
+  std::strncpy(status.drive0_full_path, d0.path.c_str(),
+               sizeof(status.drive0_full_path) - 1);
+  std::strncpy(status.drive1_full_path, d1.path.c_str(),
+               sizeof(status.drive1_full_path) - 1);
+  *size = sizeof(status);
+  return peripheral_ok;
+}
+
+// --- shared -------------------------------------------------------------------
+
+// A reset or power cycle leaves the units as they are (FujiNet-PC stays
+// connected, as a real FujiNet stays up across the Apple's reset). ProDOS
+// drives are looked up again.
+auto smartport_reset(void* instance) -> void {
+  auto* card = static_cast<Card*>(instance);
+  if (card != nullptr) {
+    card->drives_known = false;
+    card->copy.clear();
+    card->copied = 0;
+  }
+}
+
+auto smartport_shutdown(void* instance) -> void {
+  std::unique_ptr<Card> card(static_cast<Card*>(instance));
+  if (card && card->link != nullptr) {
+    card->link->stop();
+  }
+  if (card && card->disks != nullptr) {
+    card->disks->flush();
+  }
+}
+
+auto fujinet_command(void* instance, uint32_t cmd_id, const void* data,
+                     size_t size) -> PeripheralStatus {
+  (void)cmd_id;
+  (void)data;
+  (void)size;
+  return instance == nullptr ? peripheral_error : peripheral_incompatible;
+}
+
+auto fujinet_query(void* instance, uint32_t query_id, void* out,
+                   size_t* size) -> PeripheralStatus {
+  (void)instance;
+  (void)query_id;
+  (void)out;
+  return size == nullptr ? peripheral_error : peripheral_incompatible;
+}
+
+}  // namespace
+
+// Neither card keeps state of its own in a save state: what they serve lives
+// in the images and in FujiNet-PC, which carry on regardless.
+static Peripheral smartport_peripheral = {
+    .abi_version = LINAPPLE_ABI_VERSION,
+    .id = "linapple.smartport",
+    .name = "SmartPort",
+    .description =
+        "SmartPort controller: 2 hard disks and 2 UniDisk 3.5 drives",
+    .author = "LinApple Contributors",
+    .version = VERSIONSTRING,
+    .compatible_slots = PERIPHERAL_MASK_EXPANSION,
+    .default_slot = -1,
+    .init = smartport_init,
+    .reset = smartport_reset,
+    .shutdown = smartport_shutdown,
+    .think = nullptr,
+    .on_vblank = nullptr,
+    .save_state = nullptr,
+    .load_state = nullptr,
+    .command = smartport_card_command,
+    .query = smartport_card_query,
+};
+
+static Peripheral fujinet_peripheral = {
+    .abi_version = LINAPPLE_ABI_VERSION,
+    .id = "linapple.fujinet",
+    .name = "FujiNet",
+    .description = "FujiNet over SmartPort-over-SLIP (FujiNet-PC)",
+    .author = "LinApple Contributors",
+    .version = VERSIONSTRING,
+    .compatible_slots = PERIPHERAL_MASK_EXPANSION,
+    .default_slot = -1,
+    .init = fujinet_init,
+    .reset = smartport_reset,
+    .shutdown = smartport_shutdown,
+    .think = nullptr,
+    .on_vblank = nullptr,
+    .save_state = nullptr,
+    .load_state = nullptr,
+    .command = fujinet_command,
+    .query = fujinet_query,
+};
+
+auto smartport_get_descriptor() -> Peripheral* {
+  return &smartport_peripheral;
+}
+auto fujinet_get_descriptor() -> Peripheral* { return &fujinet_peripheral; }
+
+PERIPHERAL_REGISTER(smartport_peripheral)
+PERIPHERAL_REGISTER(fujinet_peripheral)

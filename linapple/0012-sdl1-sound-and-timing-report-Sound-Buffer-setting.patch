diff --git a/src/frontends/sdl1/Main.cpp b/src/frontends/sdl1/Main.cpp
index 512e8189..119a054d 100644
--- a/src/frontends/sdl1/Main.cpp
+++ b/src/frontends/sdl1/Main.cpp
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
+#include <array>
 #include <cstddef>
 #include <cstdint>
 #include <cstdio>
@@ -67,6 +68,22 @@ auto ds_init() -> bool {
   desired.format = AUDIO_S16SYS;
   desired.samples =
       static_cast<Uint16>(audio_device_buffer_samples(fallback_rate_hz));
+  // "Sound Buffer" (ms) in linapple.conf asks for a larger device buffer
+  // (the nearest power of two in samples), for a sound card or CPU that
+  // cannot keep the default one fed without gaps.
+  uint32_t buffer_ms = 0;
+  if (config_load_int("Configuration", "Sound Buffer", &buffer_ms) &&
+      buffer_ms >= 10 && buffer_ms <= 500) {
+    const uint32_t wanted = fallback_rate_hz * buffer_ms / 1000;
+    uint32_t samples = 256;
+    while (samples * 2 <= wanted && samples < 32768) {
+      samples *= 2;
+    }
+    if (samples < 32768 && (wanted - samples) > ((samples * 2) - wanted)) {
+      samples *= 2;
+    }
+    desired.samples = static_cast<Uint16>(samples);
+  }
   desired.callback = sdl1_audio_callback;
   desired.userdata = nullptr;
 
@@ -76,6 +93,15 @@ auto ds_init() -> bool {
   }
 
   const auto device_rate_hz = static_cast<uint32_t>(obtained.freq);
+  {
+    std::array<char, 32> driver{};
+    SDL_AudioDriverName(driver.data(), static_cast<int>(driver.size()));
+    std::fprintf(stderr,
+                 "audio: %s, %d Hz, %d channels, %d-sample buffer "
+                 "(asked %d Hz, %d samples)\n",
+                 driver.data(), obtained.freq, obtained.channels,
+                 obtained.samples, desired.freq, desired.samples);
+  }
 
   if (!audio_dump_file.empty()) {
     audio_dumper_initialize(&audio_dumper, audio_dump_file.c_str(),
@@ -131,8 +157,43 @@ auto sys_input() -> void {
   }
 }
 
+// Every 10 s on stderr (the boot image keeps it in /run/linapple.log, and
+// system-info.txt takes its tail): whether the loop kept up with the
+// machine, and whether the sound card got its samples in time.
+auto report_timing(FramePacer& pacer, uint32_t& last_ms, uint32_t& frames)
+    -> void {
+  ++frames;
+  const uint32_t now = SDL_GetTicks();
+  if (last_ms == 0) {
+    last_ms = now;
+    return;
+  }
+  if (now - last_ms < 10000) {
+    return;
+  }
+  uint32_t behind = 0;
+  uint32_t dropped = 0;
+  pacer.take_late_counts(&behind, &dropped);
+  const AudioMixerStats a = audio_mixer_take_stats();
+  std::fprintf(stderr,
+               "timing: %u frames in %u ms, %u late, %u dropped; audio: %llu "
+               "calls, %llu short (%llu samples), %llu skipped, longest "
+               "wait %u ms\n",
+               frames, now - last_ms, behind, dropped,
+               static_cast<unsigned long long>(a.calls),
+               static_cast<unsigned long long>(a.short_calls),
+               static_cast<unsigned long long>(a.short_samples),
+               static_cast<unsigned long long>(a.skipped_samples),
+               a.max_gap_ms);
+  std::fflush(stderr);
+  frames = 0;
+  last_ms = now;
+}
+
 auto enter_message_loop() -> void {
   FramePacer pacer;
+  uint32_t report_ms = 0;
+  uint32_t report_frames = 0;
   while (system_state.mode != app_mode_exit) {
     sys_input();
     if (system_state.mode == app_mode_exit) {
@@ -155,6 +216,7 @@ auto enter_message_loop() -> void {
       pacer.resync();
       SDL_Delay(0);
     }
+    report_timing(pacer, report_ms, report_frames);
   }
 }
 
diff --git a/tests/test_frame_pacer.cpp b/tests/test_frame_pacer.cpp
index c19142bc..3e272297 100644
--- a/tests/test_frame_pacer.cpp
+++ b/tests/test_frame_pacer.cpp
@@ -212,3 +212,24 @@ TEST_CASE("Frame Pacer: A Machine Type Change Takes Effect Next Frame") {
   pacer.wait_for_next_frame();
   CHECK(now_ns - after_ntsc == PAL_PERIOD_NS);
 }
+
+TEST_CASE("Frame pacer: counts frames that ran late and deadlines dropped") {
+  ScopedPacerWorld world(NTSC_FRAME_CYCLES, clock_6502_ntsc);
+  FramePacer pacer(fake_now, fake_sleep_until);
+
+  pacer.wait_for_next_frame();  // on time: sleeps
+  now_ns += NTSC_PERIOD_NS * 2;  // a slow frame: its deadline is gone
+  pacer.wait_for_next_frame();
+  now_ns += NTSC_PERIOD_NS * 20;  // far behind: the deadline is dropped
+  pacer.wait_for_next_frame();
+
+  uint32_t behind = 99;
+  uint32_t dropped = 99;
+  pacer.take_late_counts(&behind, &dropped);
+  CHECK(behind == 1);
+  CHECK(dropped == 1);
+
+  pacer.take_late_counts(&behind, &dropped);
+  CHECK(behind == 0);
+  CHECK(dropped == 0);
+}

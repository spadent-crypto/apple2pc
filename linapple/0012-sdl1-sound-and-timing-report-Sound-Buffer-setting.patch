 src/frontends/common/AudioMixer.h   | 14 +++++++
 src/frontends/common/FramePacer.cpp | 17 +++++++-
 src/frontends/common/FramePacer.h   |  7 ++++
 src/frontends/sdl1/Main.cpp         | 62 +++++++++++++++++++++++++++++
 tests/test_frame_pacer.cpp          | 21 ++++++++++
 6 files changed, 163 insertions(+), 1 deletion(-)

diff --git a/src/frontends/common/AudioMixer.cpp b/src/frontends/common/AudioMixer.cpp
index f6125f5d..9a31158c 100644
--- a/src/frontends/common/AudioMixer.cpp
+++ b/src/frontends/common/AudioMixer.cpp
@@ -4,6 +4,7 @@
 #include <algorithm>
 #include <array>
 #include <atomic>
+#include <chrono>
 #include <cmath>
 #include <cstdint>
 #include <cstring>
@@ -35,6 +36,19 @@ uint32_t output_rate_hz = 0;
 size_t capacity_samples = 0;
 size_t cushion_samples = 0;
 
+std::atomic<uint64_t> stat_calls{0};
+std::atomic<uint64_t> stat_short_calls{0};
+std::atomic<uint64_t> stat_short_samples{0};
+std::atomic<uint64_t> stat_skipped_samples{0};
+std::atomic<uint32_t> stat_max_gap_ms{0};
+int64_t stat_last_call_ms = 0;  // audio thread only
+
+auto steady_ms() -> int64_t {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
 // Symmetric rails: -1.0 and +1.0 map to -32767 and +32767, so a full-scale
 // signal stays symmetric instead of gaining a half-LSB bias from -32768.
 auto float_to_pcm16(float v) noexcept -> int16_t {
@@ -639,6 +653,18 @@ auto audio_mixer_get_samples(int16_t* out, size_t num_samples) -> void {
     return;
   }
 
+  {
+    const int64_t now = steady_ms();
+    if (stat_last_call_ms != 0) {
+      const auto gap = static_cast<uint32_t>(now - stat_last_call_ms);
+      if (gap > stat_max_gap_ms.load(std::memory_order_relaxed)) {
+        stat_max_gap_ms.store(gap, std::memory_order_relaxed);
+      }
+    }
+    stat_last_call_ms = now;
+    stat_calls.fetch_add(1, std::memory_order_relaxed);
+  }
+
   bool any_samples = false;
   for (size_t slot = 0; slot < max_audio_slots; ++slot) {
     if (mixer_slots[slot].active.load(std::memory_order_acquire) &&
@@ -679,6 +705,12 @@ auto audio_mixer_get_samples(int16_t* out, size_t num_samples) -> void {
     if (filled > target_backlog) {
       sample_buffer_skip(sb,
                          (filled - target_backlog) & ~static_cast<size_t>(1));
+      stat_skipped_samples.fetch_add(filled - target_backlog,
+                                     std::memory_order_relaxed);
+    } else if (filled > 0 && filled < num_samples) {
+      stat_short_calls.fetch_add(1, std::memory_order_relaxed);
+      stat_short_samples.fetch_add(num_samples - filled,
+                                   std::memory_order_relaxed);
     }
   }
 
@@ -710,3 +742,14 @@ auto audio_mixer_get_samples(int16_t* out, size_t num_samples) -> void {
     done += chunk;
   }
 }
+
+auto audio_mixer_take_stats() -> AudioMixerStats {
+  AudioMixerStats out;
+  out.calls = stat_calls.exchange(0, std::memory_order_relaxed);
+  out.short_calls = stat_short_calls.exchange(0, std::memory_order_relaxed);
+  out.short_samples = stat_short_samples.exchange(0, std::memory_order_relaxed);
+  out.skipped_samples =
+      stat_skipped_samples.exchange(0, std::memory_order_relaxed);
+  out.max_gap_ms = stat_max_gap_ms.exchange(0, std::memory_order_relaxed);
+  return out;
+}
diff --git a/src/frontends/common/AudioMixer.h b/src/frontends/common/AudioMixer.h
index 41ed98cb..405b0787 100644
--- a/src/frontends/common/AudioMixer.h
+++ b/src/frontends/common/AudioMixer.h
@@ -43,4 +43,18 @@ auto audio_mixer_set_channel_tap_callback(AudioChannelTapCallback cb) -> void;
 
 auto audio_mixer_get_samples(int16_t* out, size_t num_samples) -> void;
 
+// What the device callback met since the last call (counts reset): how
+// often a source with sound had less than the device asked for (it plays a
+// gap) and by how much, how much backlog was thrown away to keep the delay
+// down, and the longest wait between two callbacks. For finding out on a
+// real machine whether the emulation or the sound card falls behind.
+struct AudioMixerStats {
+  uint64_t calls = 0;
+  uint64_t short_calls = 0;
+  uint64_t short_samples = 0;
+  uint64_t skipped_samples = 0;
+  uint32_t max_gap_ms = 0;
+};
+auto audio_mixer_take_stats() -> AudioMixerStats;
+
 auto audio_mixer_set_fade(FadeType fade_type) -> void;
diff --git a/src/frontends/common/FramePacer.cpp b/src/frontends/common/FramePacer.cpp
index 58a07288..7f719035 100644
--- a/src/frontends/common/FramePacer.cpp
+++ b/src/frontends/common/FramePacer.cpp
@@ -62,14 +62,29 @@ auto FramePacer::wait_for_next_frame() -> void {
 
   if ((now - deadline_ns_) > (resync_after_frames * period)) {
     deadline_ns_ = now;
+    ++dropped_;
     return;
   }
 
-  if (deadline_ns_ > now && sleep_until_ != nullptr) {
+  if (deadline_ns_ <= now) {
+    ++behind_;
+  } else if (sleep_until_ != nullptr) {
     sleep_until_(deadline_ns_);
   }
 }
 
+auto FramePacer::take_late_counts(uint32_t* behind, uint32_t* dropped)
+    -> void {
+  if (behind != nullptr) {
+    *behind = behind_;
+  }
+  if (dropped != nullptr) {
+    *dropped = dropped_;
+  }
+  behind_ = 0;
+  dropped_ = 0;
+}
+
 auto frame_pacer_init(FramePacer* pacer, FrameClockNowFn now,
                       FrameClockSleepUntilFn sleep_until) -> void {
   if (pacer == nullptr) {

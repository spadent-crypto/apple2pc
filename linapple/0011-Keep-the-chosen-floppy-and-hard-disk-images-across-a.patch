From 8411dd88834abff7e35c8963594f0f692cdf9c13 Mon Sep 17 00:00:00 2001
From: James <spadent@gmail.com>
Date: Fri, 6 Nov 2026 09:42:51 +0900
Subject: [PATCH 11/13] Keep the chosen floppy and hard disk images across a
 power-off

The SmartPort card's status query filled in a local copy and never handed
it back, so the frontend saw its drives as empty and recorded the hard
disk image chosen with Shift+F3/F4 as nothing. The status now reaches the
caller. Choosing or ejecting a hard disk image, and ejecting a floppy,
now also write linapple.conf straight away, as choosing a floppy already
did; the start-up mount still leaves the file alone.
---
 .../peripherals/smartport/SmartPortCard.cpp   |  1 +
 src/frontends/common/FileBrowser.cpp          |  1 +
 src/frontends/common/sdl/Harddisk.cpp         |  3 +++
 src/frontends/sdl1/Frame.cpp                  |  2 ++
 tests/test_harddisk_config_runtime_insert.cpp | 19 +++++++++++++++++++
 5 files changed, 26 insertions(+)

diff --git a/src/apple2/peripherals/smartport/SmartPortCard.cpp b/src/apple2/peripherals/smartport/SmartPortCard.cpp
index bb5f3256..be3fbf65 100644
--- a/src/apple2/peripherals/smartport/SmartPortCard.cpp
+++ b/src/apple2/peripherals/smartport/SmartPortCard.cpp
@@ -666,6 +666,7 @@ auto smartport_card_query(void* instance, uint32_t query_id, void* out,
                sizeof(status.drive0_full_path) - 1);
   std::strncpy(status.drive1_full_path, d1.path.c_str(),
                sizeof(status.drive1_full_path) - 1);
+  std::memcpy(out, &status, sizeof(status));
   *size = sizeof(status);
   return peripheral_ok;
 }
diff --git a/src/frontends/common/FileBrowser.cpp b/src/frontends/common/FileBrowser.cpp
index b6d4b082..9b03c20e 100644
--- a/src/frontends/common/FileBrowser.cpp
+++ b/src/frontends/common/FileBrowser.cpp
@@ -596,6 +596,7 @@ auto disk_browser_confirm(DiskBrowser* b) -> bool {
     Configuration::instance().save();
 
     harddisk_frontend_insert(b->drive, full_path.c_str(), false);
+    Configuration::instance().save();
 
     disk_browser_close(b);
     return true;
diff --git a/src/frontends/common/sdl/Harddisk.cpp b/src/frontends/common/sdl/Harddisk.cpp
index 78efdd5a..66977dd3 100644
--- a/src/frontends/common/sdl/Harddisk.cpp
+++ b/src/frontends/common/sdl/Harddisk.cpp
@@ -123,6 +123,7 @@ auto harddisk_ui_ftp_select(int drive) -> void {
   const std::string local_path =
       std::string(system_state.ftp_local_dir.data()) + "/" + safe_filename;
   harddisk_frontend_insert(drive, local_path.c_str(), false);
+  Configuration::instance().save();
   back_idx = file_index;
   draw_frame_window();
 #else
@@ -190,6 +191,8 @@ auto harddisk_ui_select(int drive) -> void {
   if (harddisk_frontend_insert(drive, file_path.c_str(), false) == 0) {
     Logger::info("HDD disk image %s inserted\n", file_path.c_str());
   }
+  // Keep what the drive holds for the next start.
+  Configuration::instance().save();
   back_idx = file_index;
   draw_frame_window();
 }
diff --git a/src/frontends/sdl1/Frame.cpp b/src/frontends/sdl1/Frame.cpp
index d6322539..349614f4 100644
--- a/src/frontends/sdl1/Frame.cpp
+++ b/src/frontends/sdl1/Frame.cpp
@@ -133,6 +133,7 @@ auto handle_btn_drive(int drive_idx, int mod) -> void {
     if ((mod & KMOD_SHIFT) != 0) {
       printf("HDD  Eject Drive #%d\n", drive_idx + 1);
       harddisk_frontend_eject(drive_idx);
+      Configuration::instance().save();
     } else {
       printf("Disk Eject Drive #%d\n", drive_idx + 1);
       smartport_eject_35(drive_idx);
@@ -141,6 +142,7 @@ auto handle_btn_drive(int drive_idx, int mod) -> void {
       if (peripheral_command(disk_default_slot, disk_cmd_eject, &ecmd,
                              sizeof(ecmd)) == peripheral_ok) {
         app_controller_save_disk_config(drive_idx);
+        Configuration::instance().save();
       }
     }
     return;
diff --git a/tests/test_harddisk_config_runtime_insert.cpp b/tests/test_harddisk_config_runtime_insert.cpp
index 810172a8..898db4bc 100644
--- a/tests/test_harddisk_config_runtime_insert.cpp
+++ b/tests/test_harddisk_config_runtime_insert.cpp
@@ -137,3 +137,22 @@ TEST_CASE(
   CHECK(log.count_containing("no hard disk is installed") == 1);
   CHECK(saved_key().empty());
 }
+
+TEST_CASE(
+    "Harddisk configuration at a run-time insert: a SmartPort drive's image is "
+    "recorded") {
+  TestConfig::Description description;
+  description.slots[card_slot - 1] = "SmartPort";
+  TestConfig config(description);
+  TestFixtures::ScopedCore core(config);
+  REQUIRE(peripheral_present(card_slot, "linapple.smartport"));
+  harddisk_frontend_initialize();
+  REQUIRE(harddisk_frontend_slot() == card_slot);
+  ScopedReporter reporter;
+  const auto image = TestFixtures::create_ephemeral("minimal-block.hdv");
+
+  CHECK(harddisk_frontend_insert(0, image.c_str(), false) == 0);
+  CHECK(status().drive0_loaded == 1);
+  CHECK(saved_key() == image.path());
+  CHECK(reports.empty());
+}

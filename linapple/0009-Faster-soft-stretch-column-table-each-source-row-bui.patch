+// Like video_soft_stretch_impl, but a source row shown on several screen rows
+// (a picture scaled 2x or more in height) is stretched once into a row in
+// ordinary memory and copied from there, so the screen is only written,
+// never read back (reading video memory is very slow).
+template <typename RowOp>
+static auto video_soft_stretch_rows_once(VideoSurfaceView src,
+                                         const VideoRect* srcrect,
+                                         VideoSurfaceView dst,
+                                         const VideoRect* dstrect,
+                                         RowOp row_op) -> int {
+  if (!src.pixels || !dst.pixels) {
+    return -1;
+  }
+  VideoRect full_src = srcrect ? *srcrect : VideoRect{0, 0, src.w, src.h};
+  VideoRect full_dst = dstrect ? *dstrect : VideoRect{0, 0, dst.w, dst.h};
+  if (full_dst.h <= 0 || full_src.h <= 0 || full_dst.w <= 0 ||
+      full_src.w <= 0) {
+    return -1;
+  }
+  if (!clip_source_rect(src, &full_src)) {
+    return 0;
+  }
+
+  const int sbpp = src.bpp;
+  const int dbpp = dst.bpp;
+  const int span_first = std::max<int>(0, full_dst.x);
+  const int span_last = std::min<int>(dst.w, full_dst.x + full_dst.w);
+  if (span_last <= span_first) {
+    return 0;
+  }
+  const size_t span_offset = static_cast<size_t>(span_first) * dbpp;
+  const size_t span_bytes = static_cast<size_t>(span_last - span_first) * dbpp;
+
+  thread_local std::vector<uint8_t> row;
+  row.resize(static_cast<size_t>(dst.w) * dbpp);
+
+  int built_src_row = -1;
+  for (int row_idx = 0; row_idx < full_dst.h; ++row_idx) {
+    const int cur_dst_row = full_dst.y + row_idx;
+    if (cur_dst_row < 0 || cur_dst_row >= dst.h) {
+      continue;
+    }
+    const int cur_src_row =
+        full_src.y +
+        static_cast<int>((static_cast<int64_t>(row_idx) * full_src.h) /
+                         full_dst.h);
+    if (cur_src_row < 0 || cur_src_row >= src.h) {
+      continue;
+    }
+    if (cur_src_row != built_src_row) {
+      uint8_t* srcp = src.pixels +
+                      (static_cast<ptrdiff_t>(cur_src_row) * src.pitch) +
+                      (static_cast<ptrdiff_t>(full_src.x) * sbpp);
+      row_op(srcp, full_src.w, row.data(), full_dst.x, full_dst.w, dst.w);
+      built_src_row = cur_src_row;
+    }
+    std::memcpy(dst.pixels + (static_cast<ptrdiff_t>(cur_dst_row) * dst.pitch) +
+                    span_offset,
+                row.data() + span_offset, span_bytes);
+  }
+  return 0;
+}

+// The column table and the build-each-row-once path must give exactly what
+// the old per-pixel formula gave, clipped edges included.
+TEST_CASE("Soft stretch matches the per-pixel formula, 16 and 32 bit") {
+  struct Case {
+    int src_w, src_h, dst_w, dst_h;
+    VideoRect dst_rect;
+  };
+  const Case cases[] = {
+      {560, 384, 1024, 768, {0, 0, 1024, 768}},   // 4:3 aspect on 1024x768
+      {560, 384, 1024, 768, {0, 0, 1120, 768}},   // pixel aspect, wider
+      {560, 384, 800, 600, {0, 0, 800, 600}},     // aspect on 800x600
+      {560, 384, 800, 600, {144, 108, 512, 384}}, // sharp on 800x600
+      {560, 384, 1280, 800, {107, 0, 1066, 800}}, // pillarbox
+      {560, 384, 300, 200, {-20, -10, 340, 230}}, // clipped on every side
+  };
+  for (int bpp : {2, 4}) {
+    for (const Case& c : cases) {
+      UniqueSurface src = make_surface(c.src_w, c.src_h, bpp);
+      UniqueSurface dst = make_surface(c.dst_w, c.dst_h, bpp);
+      REQUIRE(src != nullptr);
+      REQUIRE(dst != nullptr);
+      for (int y = 0; y < c.src_h; ++y) {
+        uint8_t* row = src->pixels + (static_cast<std::ptrdiff_t>(y) * src->pitch);
+        for (int x = 0; x < c.src_w; ++x) {
+          const uint32_t v = static_cast<uint32_t>((y * 7919) ^ (x * 104729));
+          if (bpp == 2) {
+            reinterpret_cast<uint16_t*>(row)[x] = static_cast<uint16_t>(v);
+          } else {
+            reinterpret_cast<uint32_t*>(row)[x] = v;
+          }
+        }
+      }
+      VideoRect dr = c.dst_rect;
+      REQUIRE(video_soft_stretch(src.get(), nullptr, dst.get(), &dr) == 0);
+
+      int bad = 0;
+      for (int ry = 0; ry < c.dst_rect.h && bad < 5; ++ry) {
+        const int y = c.dst_rect.y + ry;
+        if (y < 0 || y >= c.dst_h) {
+          continue;
+        }
+        const int sy = static_cast<int>((static_cast<int64_t>(ry) * c.src_h) /
+                                        c.dst_rect.h);
+        for (int rx = 0; rx < c.dst_rect.w && bad < 5; ++rx) {
+          const int x = c.dst_rect.x + rx;
+          if (x < 0 || x >= c.dst_w) {
+            continue;
+          }
+          int sx = static_cast<int>((static_cast<int64_t>(rx) * c.src_w) /
+                                    c.dst_rect.w);
+          sx = std::min(sx, c.src_w - 1);
+          const uint8_t* srow =
+              src->pixels + (static_cast<std::ptrdiff_t>(sy) * src->pitch);
+          const uint8_t* drow =
+              dst->pixels + (static_cast<std::ptrdiff_t>(y) * dst->pitch);
+          const uint32_t want =
+              bpp == 2 ? reinterpret_cast<const uint16_t*>(srow)[sx]
+                       : reinterpret_cast<const uint32_t*>(srow)[sx];
+          const uint32_t got =
+              bpp == 2 ? reinterpret_cast<const uint16_t*>(drow)[x]
+                       : reinterpret_cast<const uint32_t*>(drow)[x];
+          if (want != got) {
+            ++bad;
+          }
+        }
+      }
+      CHECK(bad == 0);
+    }
+  }

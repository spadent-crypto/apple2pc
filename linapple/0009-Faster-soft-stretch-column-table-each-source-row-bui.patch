+// Which source column each destination column takes, for one width pair.
+// Worked out once with division and reused for every row and frame: on a
+// 32-bit x86 a 64-bit division is a slow library call, and doing one per
+// pixel used to cost most of the picture's drawing time.
+static auto column_map(int src_w, int dst_w) -> const int* {
+  thread_local std::vector<int> map;
+  thread_local int map_src_w = -1;
+  thread_local int map_dst_w = -1;
+  if (src_w != map_src_w || dst_w != map_dst_w) {
+    map.resize(static_cast<size_t>(dst_w));
+    for (int i = 0; i < dst_w; ++i) {
+      int src_x = static_cast<int>((static_cast<int64_t>(i) * src_w) / dst_w);
+      map[static_cast<size_t>(i)] = src_x >= src_w ? src_w - 1 : src_x;
+    }
+    map_src_w = src_w;
+    map_dst_w = dst_w;
+  }
+  return map.data();
+}

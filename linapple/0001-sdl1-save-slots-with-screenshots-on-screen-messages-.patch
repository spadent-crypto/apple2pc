+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <SDL/SDL_video.h>
+
+#include <string>
+
+// Ten numbered save slots (0-9). Each slot keeps the machine state
+// (SaveState<n>.aws, the same name the quick-save keys always used) and a
+// screenshot taken at the same moment (SaveState<n>.bmp) in the Save State
+// Directory.
+
+constexpr int gallery_slot_count = 10;
+
+auto gallery_slot_path(int slot, const char* ext) -> std::string;
+auto gallery_slot_used(int slot) -> bool;
+
+// Save the state and its screenshot to a slot; shows an on-screen message.
+auto gallery_quick_save(int slot) -> bool;
+// Load a slot; shows an on-screen message.
+auto gallery_quick_load(int slot) -> bool;
+
+// Full-screen picker with a thumbnail per slot. Blocks until the user
+// confirms or cancels.
+auto gallery_open(bool save_mode) -> void;
+
+// Short message drawn over the picture for a moment.
+auto osd_toast(const char* text) -> void;
+// Called after the picture is blitted, before the flip.
+auto osd_draw(SDL_Surface* target, const SDL_Rect& picture) -> void;
+// True while a message is showing, and once more after it ends so the
+// picture underneath is repainted.
+auto osd_wants_repaint() -> bool;

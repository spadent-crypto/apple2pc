+namespace {
+// Cycle of the last click / register write, and whether there was one.
+uint64_t last_speaker_cycle = 0;
+uint64_t last_mockingboard_cycle = 0;
+bool speaker_heard = false;
+bool mockingboard_heard = false;
+
+auto heard_within(bool heard, uint64_t last, double seconds) -> bool {
+  if (!heard) {
+    return false;
+  }
+  const uint64_t now = cpu_get_cumulative_cycles();
+  const double hz = (current_clk_6502 > 0.0) ? current_clk_6502 : 1020484.0;
+  return now >= last && static_cast<double>(now - last) < hz * seconds;
+}
+}  // namespace
+
+auto peripheral_note_speaker_activity() -> void {
+  last_speaker_cycle = cpu_get_cumulative_cycles();
+  speaker_heard = true;
+}
+
+auto peripheral_note_mockingboard_activity() -> void {
+  last_mockingboard_cycle = cpu_get_cumulative_cycles();
+  mockingboard_heard = true;
+}
+
+auto peripheral_sound_recently_active() -> bool {
+  return heard_within(speaker_heard, last_speaker_cycle, 0.2) ||
+         heard_within(mockingboard_heard, last_mockingboard_cycle, 0.1);
+}
+
+auto peripheral_reset_sound_activity() -> void {
+  speaker_heard = false;
+  mockingboard_heard = false;
+}
+
 auto peripheral_is_any_active() -> bool {
   for (size_t i = 0; i < num_slots; ++i) {
     if (peripheral_activity_state.at(i)) {

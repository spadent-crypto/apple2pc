index 00000000..749a9c47
--- /dev/null
+++ b/tests/test_disk_turbo_sound.cpp
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+// Fast disk access stays off while the program is making sound, so a game
+// that leaves the drive motor on while it plays runs at its own speed.
+
+#include "HeadlessHarness.h"
+#include "apple2/CPU.h"
+#include "apple2/Memory.h"
+#include "apple2/peripherals/Peripheral.h"
+#include "apple2/peripherals/Peripheral_Internal.h"
+#include "core/LinAppleCore.h"
+#include "doctest.h"
+#include "test_fixtures.h"
+
+namespace {
+
+using TestConfig = TestFixtures::ScopedTestConfig;
+
+constexpr uint16_t speaker_strobe = 0xC030;
+
+auto click() -> void { io_map_dispatch(0, speaker_strobe, 0, 0, 0); }
+
+}  // namespace
+
+// Runs until the empty drive's search goes to full speed; false if it never
+// does within two seconds.
+static auto run_until_full_speed(HeadlessHarness& harness) -> bool {
+  for (int i = 0; i < 120; ++i) {
+    harness.run_frames(1);
+    if (linapple_is_full_speed()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+TEST_CASE("Disk turbo: the boot beep holds it off, then the drive goes fast") {
+  TestConfig config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(config);
+  harness.boot();
+  // The beep at power-on: the drive spins, but the machine stays at 1x.
+  harness.run_frames(10);
+  CHECK(peripheral_is_any_active());
+  CHECK(peripheral_sound_recently_active());
+  CHECK_FALSE(linapple_is_full_speed());
+  // Once it has been quiet for 0.2 s, the spinning drive runs at full speed.
+  CHECK(run_until_full_speed(harness));
+}
+
+TEST_CASE("Disk turbo: speaker clicks hold a spinning drive at 1x") {
+  TestConfig config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(config);
+  harness.boot();
+  harness.run_frames(10);
+  REQUIRE(peripheral_is_any_active());
+
+  for (int i = 0; i < 60; ++i) {
+    click();
+    harness.run_frames(1);
+    CHECK_FALSE(linapple_is_full_speed());
+  }
+  CHECK(peripheral_is_any_active());
+
+  CHECK(run_until_full_speed(harness));
+}
+
+TEST_CASE("Disk turbo: the sound window is 0.2 s speaker, 0.1 s Mockingboard") {
+  TestConfig config(TestConfig::enhanced_2e_only());
+  HeadlessHarness harness(config);
+  harness.boot();
+  harness.run_frames(30);  // past the power-on beep
+
+  peripheral_reset_sound_activity();
+  CHECK_FALSE(peripheral_sound_recently_active());
+
+  peripheral_note_speaker_activity();
+  harness.run_frames(9);  // 0.15 s
+  CHECK(peripheral_sound_recently_active());
+  harness.run_frames(6);  // 0.25 s
+  CHECK_FALSE(peripheral_sound_recently_active());
+
+  peripheral_note_mockingboard_activity();
+  harness.run_frames(3);  // 0.05 s
+  CHECK(peripheral_sound_recently_active());
+  harness.run_frames(5);  // 0.13 s
+  CHECK_FALSE(peripheral_sound_recently_active());
+}

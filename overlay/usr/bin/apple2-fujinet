#!/bin/sh
# FujiNet-PC (Apple build): connects to the emulator's FujiNet card on
# 127.0.0.1:1985. Its settings and SD card live on the APPLE2 partition;
# its read-only data (CONFIG program, web pages) is copied to RAM.

DATA=/media/apple2/fujinet
RUN=/run/fujinet

mkdir -p "$DATA/SD" "$RUN"
[ -f "$DATA/fnconfig.ini" ] || cp /etc/fujinet/fnconfig.ini "$DATA/fnconfig.ini"
rm -rf "$RUN/data"
cp -r /opt/fujinet/data "$RUN/data"
cd "$RUN" || exit 1

while :; do
	/opt/fujinet/fujinet -c "$DATA/fnconfig.ini" -s "$DATA/SD" >/run/fujinet.log 2>&1
	rc=$?
	[ $rc -eq 0 ] && break
	sleep 1
done

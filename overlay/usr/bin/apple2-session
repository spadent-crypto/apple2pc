#!/bin/sh
# Mount the APPLE2 data partition, start the network (clock) in the
# background, fit the picture to the screen, run LinApple full screen, and
# power off when it ends (F12).

DATA=/media/apple2
CONF=$DATA/linapple.conf
LOG=/run/linapple.log

export TZ="${TZ:-KST-9}"        # time shown on save slots
hwclock -s -l 2>/dev/null       # the PC's clock keeps local time, as Windows does

find_data_dev() {
	# USB sticks and CF readers can show up a moment after boot.
	i=0
	while [ $i -lt 25 ]; do
		dev=$(blkid 2>/dev/null | sed -n 's/^\([^:]*\):.*LABEL="APPLE2".*/\1/p' | head -n 1)
		if [ -n "$dev" ]; then
			echo "$dev"
			return 0
		fi
		i=$((i + 1))
		sleep 0.2
	done
	return 1
}

# This PC is often just switched off or the USB pulled: whatever is
# written (game saves into disk images, save states, settings) goes out to
# the USB within about 2 s instead of the usual 30.
echo 100 >/proc/sys/vm/dirty_expire_centisecs 2>/dev/null
echo 100 >/proc/sys/vm/dirty_writeback_centisecs 2>/dev/null

mkdir -p "$DATA"
DEV=$(find_data_dev)
# Written to a bigger disk, the APPLE2 partition grows to fill it (once).
[ -n "$DEV" ] && /usr/bin/apple2-grow "$DEV"
if [ -z "$DEV" ] || ! mount -t vfat -o rw,noatime,flush,umask=000,shortname=mixed,time_offset=540 "$DEV" "$DATA"; then
	# No data partition: run anyway, but nothing is kept after power-off.
	mount -t tmpfs -o size=64m tmpfs "$DATA"
	NO_DATA=1
fi

mkdir -p "$DATA/disks" "$DATA/saves" "$DATA/.home"
[ -f "$CONF" ] || cp /etc/linapple/linapple.conf "$CONF"

# Screen settings, APPLE2/display.txt: RESOLUTION is read by GRUB at boot,
# PRIORITY (aspect or sharp) goes into linapple.conf here.
[ -f "$DATA/display.txt" ] || cp /etc/linapple/display.txt "$DATA/display.txt"
prio=$(tr -d '\r' <"$DATA/display.txt" 2>/dev/null |
	sed -n 's/^[[:space:]]*PRIORITY[[:space:]]*=[[:space:]]*\([A-Za-z]*\).*/\1/p' |
	head -n 1 | tr 'A-Z' 'a-z')
case $prio in
sharp) mode=sharp ;;
*) mode=aspect ;;
esac
# Sound settings added in v2.2, for a linapple.conf from before.
grep -q '^Sound Buffer' "$CONF" || sed -i '/^\[Configuration\]/a Sound Buffer = 23\r' "$CONF"
grep -q '^Sound Device' "$CONF" || sed -i '/^\[Configuration\]/a Sound Device = default\r' "$CONF"
grep -q '^Mockingboard Stereo' "$CONF" || sed -i '/^\[Configuration\]/a Mockingboard Stereo = 0\r' "$CONF"

# Floppy images chosen with F3 / F4 come back at the next start (a
# linapple.conf from v2.0 or before has this off).
sed -i 's/^Slot 6 Autoload[ \t]*=[ \t]*0/Slot 6 Autoload = 1/' "$CONF"

if grep -q '^Scale Mode' "$CONF"; then
	sed -i "s/^Scale Mode[ \t]*=.*/Scale Mode = $mode\r/" "$CONF"
else
	sed -i "/^Screen Height[ \t]*=/a Scale Mode = $mode\r" "$CONF"
fi

# The network is only for the clock, so it is off unless APPLE2\wifi.txt
# names a Wi-Fi network or says WIRED=on; it then waits until the Apple is
# up, so it does not compete for a slow USB stick at start-up.
net_on=""
if [ -f "$DATA/wifi.txt" ]; then
	tr -d '\r' <"$DATA/wifi.txt" | grep -qE '^SSID=.+|^WIRED=on' && net_on=1
fi
[ -f "$DATA/wpa_supplicant.conf" ] && net_on=1
[ -n "$net_on" ] && { sleep 20; /usr/bin/apple2-net; } &

# Fit the emulator to whatever mode GRUB gave the framebuffer.
if [ -r /sys/class/graphics/fb0/virtual_size ]; then
	size=$(cat /sys/class/graphics/fb0/virtual_size)
	W=${size%,*}
	H=${size#*,}
	sed -i -e "s/^Screen Width[ \t]*=.*/Screen Width = $W\r/" \
	       -e "s/^Screen Height[ \t]*=.*/Screen Height = $H\r/" "$CONF"
fi

# Full CPU speed for the emulator (the kernel's default governor is
# performance too; this covers a CPU whose driver starts otherwise).
for g in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
	[ -w "$g" ] && echo performance >"$g" 2>/dev/null
done

# Sound card: PCI drivers, then ISA cards (APPLE2/sound.txt). Before
# LinApple, which opens the sound device when it starts.
/usr/bin/apple2-sound
# A USB audio device found at start-up is the one ALSA uses.
if [ -s /run/alsa-card ]; then
	ALSA_CARD=$(cat /run/alsa-card)
	export ALSA_CARD
fi

# ThinkPad volume and mute buttons (after the sound card, so it stays
# the first card).
if grep -qiE "lenovo|ibm" /sys/class/dmi/id/sys_vendor 2>/dev/null; then
	modprobe -q thinkpad_acpi 2>/dev/null
fi

# AC'97 and HD Audio chips often start muted. The main volume is the one
# last set with the volume keys (Master Volume in linapple.conf, 0-100);
# the other controls go to full so that one alone sets the level.
vol=$(tr -d '\r' <"$CONF" | sed -n 's/^Master Volume[ \t]*=[ \t]*\([0-9]*\).*/\1/p' | head -n 1)
case $vol in
'' | *[!0-9]*) vol=85 ;;
esac
[ "$vol" -gt 100 ] && vol=100
main=""
for ctl in Master PCM Speaker Front Headphone; do
	amixer -q sget "$ctl" >/dev/null 2>&1 || continue
	if [ -z "$main" ]; then
		main=$ctl
		amixer -q -M sset "$ctl" "$vol%" unmute 2>/dev/null
	else
		amixer -q sset "$ctl" 100% unmute 2>/dev/null
	fi
done
# A USB sound device may name its volume otherwise: the first control.
if [ -z "$main" ]; then
	ctl=$(amixer scontrols 2>/dev/null | sed -n "s/^Simple mixer control '\([^']*\)'.*/\1/p" | head -n 1)
	[ -n "$ctl" ] && amixer -q -M sset "$ctl" "$vol%" unmute 2>/dev/null
fi

export HOME="$DATA/.home"
# The display settings menu (Alt+F9) edits this file and, when the
# resolution changed and the user wants it, leaves the flag and quits.
export APPLE2PC_DISPLAY_FILE="$DATA/display.txt"
export APPLE2PC_REBOOT_FLAG=/run/apple2-reboot
rm -f "$APPLE2PC_REBOOT_FLAG"
export SDL_VIDEODRIVER=fbcon
export SDL_FBDEV=/dev/fb0
export SDL_NOMOUSE=1
export SDL_AUDIODRIVER=alsa
# Sound Device in linapple.conf: an ALSA device other than "default".
dev=$(sed -n 's/^Sound Device[ \t]*=[ \t]*\([^ \t\r]*\).*/\1/p' "$CONF" | head -n 1)
if [ -n "$dev" ] && [ "$dev" != default ]; then
	export AUDIODEV="$dev"
fi

cd "$DATA" || cd /
# CPU clock, screen mode and sound device settings into
# APPLE2/system-info.txt, a few seconds after LinApple starts.
/usr/bin/apple2-sysinfo &
/usr/bin/linapple -c "$CONF" -f >"$LOG" 2>&1
rc=$?
# Again now that LinApple has quit, with its sound and timing counts.
/usr/bin/apple2-sysinfo now

sync
if [ $rc -ne 0 ] && [ ! -f "$APPLE2PC_REBOOT_FLAG" ]; then
	# Leave the reason on screen instead of powering off.
	cp "$LOG" "$DATA/linapple.log" 2>/dev/null
	printf '\033c'
	echo "LinApple stopped with error $rc."
	[ -n "$NO_DATA" ] && echo "(The APPLE2 data partition was not found.)"
	echo
	tail -n 15 "$LOG"
	echo
	echo "Enter: try again    p: power off    s: shell"
	read -r answer
	case "$answer" in
		p|P) poweroff ;;
		s|S) exec /bin/sh ;;
		*) umount "$DATA" 2>/dev/null; exec "$0" ;;
	esac
fi

sync
umount "$DATA" 2>/dev/null
if [ -f "$APPLE2PC_REBOOT_FLAG" ]; then
	reboot
else
	poweroff
fi

#!/bin/sh
# Find the sound card before LinApple starts.
#
# 1. The onboard chips (AC'97, HD Audio) and the common PCI cards are built
#    into the kernel. Drivers for the other PCI audio devices present are
#    loaded here.
#    A USB audio device (USB Audio Class: sound cards, headsets, DACs)
#    plugged in at start-up is loaded too and used instead of the onboard
#    sound (its card number goes to /run/alsa-card; the session passes it
#    to ALSA as ALSA_CARD).
# 2. With still no card, ISA cards are tried: first the lines of
#    APPLE2/sound.txt (module and port/IRQ/DMA settings, e.g.
#    "snd-sb16 port=0x220 irq=5 dma8=1 dma16=5"), then ISA PnP cards, then
#    the usual Sound Blaster settings (220h, IRQ 5/7, DMA 1/5, MPU 330h,
#    FM 388h). A line "none" in sound.txt skips the ISA search.
# What was found goes to APPLE2/sound-cards.txt.

DATA=/media/apple2
CONF=$DATA/sound.txt
LOG=/run/sound.log
exec 2>>"$LOG"

has_card() { grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; }

MODDIR=/lib/modules/$(uname -r)

# Does a module take a given parameter? (Looks in the .ko itself.)
has_param() {
	f=$(sed -n "s#^\([^:]*/$1\.ko\):.*#\1#p" "$MODDIR/modules.dep" | head -n 1)
	[ -n "$f" ] && grep -qa "parm=$2:" "$MODDIR/$f"
}

# Try one "module options..." line; leave the module loaded only if it
# brought a card. With a port given, the ISA PnP drivers need isapnp=0 to
# look at that port instead of only for PnP cards.
try() {
	mod=$(echo "$1" | tr _ -)
	shift
	case " $* " in
	*" port="*)
		case " $* " in
		*" isapnp="*) ;;
		*) has_param "$mod" isapnp && set -- "$@" isapnp=0 ;;
		esac ;;
	esac
	echo "try: $mod $*" >>"$LOG"
	if modprobe "$mod" "$@" 2>>"$LOG" && has_card; then
		found="$mod $*"
		return 0
	fi
	modprobe -r "$mod" 2>/dev/null
	return 1
}

found=""

# 1. PCI audio devices (class 04xx: multimedia audio, HD Audio).
for d in /sys/bus/pci/devices/*; do
	[ -r "$d/class" ] || continue
	case $(cat "$d/class") in
	0x04*) modprobe -q "$(cat "$d/modalias")" 2>/dev/null ;;
	esac
done

# A built-in HD Audio or AC'97 chip may still be starting (the kernel
# probes it in the background, a second or two on an old laptop): with a
# PCI audio device present, wait for its card before deciding there is
# none (at most 8 s), or the boot goes on silent and the ISA search runs.
pci_audio=""
for d in /sys/bus/pci/devices/*; do
	case $(cat "$d/class" 2>/dev/null) in 0x04*) pci_audio=1 ;; esac
done
if [ -n "$pci_audio" ]; then
	i=0
	while ! has_card && [ $i -lt 40 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	echo "PCI audio: waited $((i * 200)) ms for the card" >>"$LOG"
fi

# 1b. USB audio. USB devices may still be turning up: wait until the list
# stops changing (at most 3 s), then look for an audio interface (class 01).
n=-1
i=0
while [ $i -lt 6 ]; do
	m=$(ls /sys/bus/usb/devices 2>/dev/null | wc -l)
	[ "$m" = "$n" ] && break
	n=$m
	sleep 0.3
	i=$((i + 1))
done
# Only a USB card that can play sound is used: a webcam or a microphone is
# an audio device too, but has nothing to play on. "USB_AUDIO=off" in
# sound.txt leaves USB sound alone.
usb_audio_playback_card() {
	for c in $(sed -n 's/^ *\([0-9][0-9]*\) .*USB-Audio.*/\1/p' /proc/asound/cards); do
		ls -d /proc/asound/card"$c"/pcm*p >/dev/null 2>&1 && { echo "$c"; return 0; }
	done
	return 1
}
usb_found=""
usb_off=""
[ -f "$CONF" ] && tr -d '\r' <"$CONF" | grep -qiE '^[[:space:]]*USB_AUDIO[[:space:]]*=[[:space:]]*off' && usb_off=1
for f in /sys/bus/usb/devices/*/bInterfaceClass; do
	[ -z "$usb_off" ] || { echo "USB sound off (sound.txt)" >>"$LOG"; break; }
	[ "$(cat "$f" 2>/dev/null)" = 01 ] || continue
	echo "usb audio interface: ${f%/bInterfaceClass}" >>"$LOG"
	modprobe snd-usb-audio 2>>"$LOG"
	usb_card=""
	i=0
	while [ $i -lt 10 ]; do
		grep -q "USB-Audio" /proc/asound/cards && break
		sleep 0.3
		i=$((i + 1))
	done
	sleep 0.3
	usb_card=$(usb_audio_playback_card)
	if [ -n "$usb_card" ]; then
		echo "$usb_card" >/run/alsa-card
		usb_found="USB audio (card $usb_card, used for the sound)"
	else
		echo "USB audio device without playback (microphone/webcam): not used" >>"$LOG"
	fi
	break
done

skip_isa=""
if [ -n "$usb_found" ]; then
	found=$usb_found
elif has_card; then
	found="PCI / onboard"
else
	# 2a. The user's own settings.
	if [ -f "$CONF" ]; then
		tr -d '\r' <"$CONF" | sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
			grep -v '^$' | grep -viE '^USB_AUDIO' >/run/sound.lines
		while read -r line; do
			case $line in
			none | NONE) skip_isa=1; break ;;
			esac
			# shellcheck disable=SC2086
			try $line && break
		done </run/sound.lines
	fi

	# 2b. ISA PnP cards (drivers without options), then the usual Sound
	# Blaster settings: 220h, IRQ 5 or 7, DMA 1 and 5, MPU 330h, FM 388h.
	if [ -z "$found" ] && [ -z "$skip_isa" ]; then
		while read -r line; do
			# shellcheck disable=SC2086
			try $line && break
		done <<EOF
snd-sbawe
snd-sb16
snd-es18xx
snd-opl3sa2
snd-cs4236
snd-cmi8330
snd-als100
snd-azt2320
snd-ad1816a
snd-interwave
snd-sbawe port=0x220 irq=5 dma8=1 dma16=5 mpu_port=0x330 fm_port=0x388
snd-sb16 port=0x220 irq=5 dma8=1 dma16=5 mpu_port=0x330 fm_port=0x388
snd-sb16 port=0x220 irq=7 dma8=1 dma16=5 mpu_port=0x330 fm_port=0x388
snd-es1688 port=0x220 irq=5 dma8=1 mpu_port=0x330 fm_port=0x388
snd-es18xx port=0x220 irq=5 dma1=1 mpu_port=0x330 fm_port=0x388
snd-sb8 port=0x220 irq=5 dma8=1
snd-sb8 port=0x220 irq=7 dma8=1
EOF
	fi
fi

# Leave a note on the data partition (CRLF, so Notepad shows it right).
{
	echo "Apple II PC - sound card ($(date '+%Y-%m-%d %H:%M'))"
	echo
	if [ -n "$found" ]; then
		echo "Found with: $found"
	elif [ -n "$skip_isa" ]; then
		echo "No PCI sound card; ISA search skipped (sound.txt: none)."
	else
		echo "No sound card found. For an ISA card, see sound.txt."
	fi
	echo
	cat /proc/asound/cards 2>/dev/null
	echo
	echo "[What was tried]"
	cat "$LOG" 2>/dev/null
} | sed 's/$/\r/' >"$DATA/sound-cards.txt" 2>/dev/null

[ -n "$found" ]

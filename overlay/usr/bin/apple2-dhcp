#!/bin/sh
# udhcpc event script: sets the address, the default route and DNS.
RESOLV=/run/resolv.conf
case "$1" in
	deconfig)
		ip -4 addr flush dev "$interface" 2>/dev/null
		ip link set "$interface" up
		;;
	bound|renew)
		ip -4 addr flush dev "$interface"
		ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast $broadcast} dev "$interface"
		if [ -n "$router" ]; then
			while ip route del default dev "$interface" 2>/dev/null; do :; done
			for r in $router; do
				ip route add default via "$r" dev "$interface" && break
			done
		fi
		: > "$RESOLV.new"
		[ -n "$domain" ] && echo "search $domain" >> "$RESOLV.new"
		for d in $dns; do echo "nameserver $d" >> "$RESOLV.new"; done
		mv "$RESOLV.new" "$RESOLV"
		echo "$interface $ip" > /run/net-up
		# Where to find FujiNet's web page, for the user.
		if mountpoint -q /media/apple2; then
			printf 'interface=%s\r\nip=%s\r\nFujiNet web: http://%s:8000\r\n' \
				"$interface" "$ip" "$ip" > /media/apple2/network.txt
		fi
		;;
esac
exit 0
